{"js":"// CC0-1.0. First-person gun handling for any model with \"muzzle\" and \"sight\" nodes (see firearm-models):\n// hip/aim-down-sights blend, walk bob, recoil kick and recovery, auto / pump / bolt cycling with animation,\n// magazine or one-round-at-a-time reloads drawn from an injected ammo source, muzzle flash and scope zoom.\n// The game owns hits: every shot calls onShot with an origin and pellet directions.\nimport * as THREE from 'three';\n\nexport function attach(camera, {\n    model,\n    fire = { mode: 'auto', rpm: 600, mag: 30, reload: 2.4, spread: 0.03, ads: 0.004, recoil: 0.012, pellets: 1 },\n    magazine = { type: null, n: 0 },                 // loaded rounds (mutated in place, so it can live in a save)\n    takeAmmo = () => 0,                              // (type, n) -> rounds actually taken\n    returnAmmo = () => {},                           // (type, n) rounds unloaded when switching ammo type\n    available = () => ({}),                          // () -> { type: count } the reload may draw from\n    ammoType = null,                                 // preferred type for the next reload\n    hip = [0.17, -0.16, -0.36], adsDistance = 0.3, adsSpeed = 9,\n    hipFov = camera.fov,\n    zoom = model?.userData?.attachments?.includes('scope') ? 4 : model?.userData?.attachments?.includes('holo') ? 1.35 : 1.15,\n    scoped = model?.userData?.attachments?.includes('scope') ?? false,\n    suppressed = model?.userData?.attachments?.includes('silencer') ?? false,\n    rng = Math.random,\n    onShot = () => {}, onKick = () => {}, onDry = () => {}, onMechanics = () => {}, onScope = () => {}, onReload = () => {},\n} = {}) {\n    if (!model) throw new Error('model required');\n    const rig = new THREE.Group(); rig.name = 'viewmodel'; rig.add(model); camera.add(rig);\n    model.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n    const sight = model.getObjectByName('sight'), muzzle = model.getObjectByName('muzzle');\n    const pump = model.getObjectByName('pump'), bolt = model.getObjectByName('bolt');\n    const flash = new THREE.PointLight(0xffb060, 0, 7, 2); muzzle?.add(flash);\n    const flashSprite = new THREE.Mesh(new THREE.PlaneGeometry(0.16, 0.16), new THREE.MeshBasicMaterial({ color: 0xffc070, transparent: true, opacity: 0, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide }));\n    muzzle?.add(flashSprite);\n    const adsPos = new THREE.Vector3(0, 0, -adsDistance).sub(sight ? sight.position : new THREE.Vector3(0, 0.1, 0));\n    const hipPos = new THREE.Vector3(...hip);\n    let a = 0, cooldown = 0, cycling = 0, cycleTotal = 0, reload = null, prevFire = false, kick = 0, flashT = 0, t = 0, wasScoped = false, dead = false;\n    const interval = fire.mode === 'auto' ? 60 / (fire.rpm || 600) : 0.15;\n    const dir = new THREE.Vector3(), origin = new THREE.Vector3(), mWorld = new THREE.Vector3(), q = new THREE.Quaternion();\n\n    function pickType() {\n        const have = available();\n        if (ammoType && have[ammoType] > 0) return ammoType;\n        if (magazine.type && have[magazine.type] > 0) return magazine.type;\n        return Object.keys(have).find((k) => have[k] > 0) ?? null;\n    }\n    function startReload() {\n        if (reload || cycling > 0 || dead) return false;\n        const type = pickType();\n        if (!type || (magazine.n >= fire.mag && magazine.type === type)) return false;\n        const single = !!fire.reloadEach;\n        reload = { t: 0, type, single, total: single ? fire.reloadEach : fire.reload };\n        onReload('start', type); onMechanics(single ? 'shell' : 'mag-out');\n        return true;\n    }\n    function swapType(type) { if (magazine.n > 0 && magazine.type !== type) { returnAmmo(magazine.type, magazine.n); magazine.n = 0; } magazine.type = type; }\n    function shoot(moving, running) {\n        magazine.n--; cooldown = interval;\n        camera.getWorldPosition(origin); camera.getWorldQuaternion(q);\n        const spread = THREE.MathUtils.lerp(fire.spread, fire.ads, a) * (moving ? 1.6 : 1) * (running ? 2.5 : 1);\n        const directions = [];\n        for (let i = 0; i < (fire.pellets || 1); i++) {\n            const r = spread * Math.sqrt(rng()), th = rng() * Math.PI * 2;\n            dir.set(Math.cos(th) * r, Math.sin(th) * r, -1).normalize().applyQuaternion(q); directions.push(dir.clone());\n        }\n        muzzle?.getWorldPosition(mWorld);\n        onShot({ origin: origin.clone(), muzzle: mWorld.clone(), directions, ammo: magazine.type, suppressed, fire });\n        kick = 1; flashT = suppressed ? 0.02 : 0.05;\n        onKick(fire.recoil * (0.8 + rng() * 0.4) * (1 - a * 0.35), (rng() - 0.5) * fire.recoil * 0.6);\n        if (fire.mode !== 'auto') { cycling = cycleTotal = fire.cycle || 1; setTimeout(() => !dead && onMechanics(fire.mode), 120); }\n    }\n\n    return {\n        rig,\n        get magazine() { return magazine; },\n        get reloading() { return !!reload; },\n        get aim() { return a; },\n        get ammoType() { return ammoType; },\n        setAmmoType(type) { ammoType = type; },\n        reload: startReload,\n        update(dt, { fire: trigger = false, ads = false, moving = false, running = false } = {}) {\n            if (dead || !(dt > 0)) return;\n            dt = Math.min(dt, 0.05); t += dt;\n            cooldown = Math.max(0, cooldown - dt); kick = Math.max(0, kick - dt * 9); flashT = Math.max(0, flashT - dt);\n            const pressed = trigger && !prevFire; prevFire = trigger;\n            // reload progress; single-round loads can be interrupted by the trigger\n            if (reload) {\n                if (reload.single && pressed && magazine.n > 0) { reload = null; onReload('cancel'); }\n                else if ((reload.t += dt) >= reload.total) {\n                    swapType(reload.type);\n                    const got = takeAmmo(reload.type, reload.single ? 1 : fire.mag - magazine.n); magazine.n += got;\n                    if (reload.single && got && magazine.n < fire.mag && available()[reload.type] > 0) { reload.t = 0; onMechanics('shell'); }\n                    else { reload = null; onMechanics(fire.reloadEach ? (fire.mode === 'bolt' ? 'bolt' : 'pump') : 'mag-in'); onReload('done'); }\n                }\n            }\n            if (cycling > 0) cycling = Math.max(0, cycling - dt);\n            if (!reload && cycling === 0 && cooldown === 0 && trigger && (fire.mode === 'auto' || pressed)) {\n                if (magazine.n > 0) shoot(moving, running); else if (pressed) onDry();\n            }\n            // pose\n            const target = ads && !reload && !running ? 1 : 0;\n            a += (target - a) * Math.min(1, dt * adsSpeed);\n            rig.position.lerpVectors(hipPos, adsPos, a);\n            const bob = moving ? (running ? 1.8 : 1) * (1 - a * 0.85) : 0.15 * (1 - a);\n            rig.position.x += Math.sin(t * (running ? 13 : 9)) * 0.006 * bob;\n            rig.position.y += Math.abs(Math.cos(t * (running ? 13 : 9))) * 0.008 * bob + (running ? -0.04 : 0);\n            rig.position.z += kick * 0.05 * (fire.recoil * 40);\n            rig.rotation.set(kick * fire.recoil * 3 + (running ? -0.35 : 0), running ? 0.5 : 0, 0);\n            if (reload) { const p = Math.sin(Math.min(1, reload.t / reload.total) * Math.PI); rig.rotation.x -= p * (reload.single ? 0.15 : 0.5); rig.rotation.z += p * 0.4; rig.position.y -= p * 0.06; }\n            const cyc = cycleTotal ? Math.sin((1 - cycling / cycleTotal) * Math.PI) : 0;\n            if (pump) pump.position.z = cycling > 0 ? cyc * 0.09 : 0;\n            if (bolt) { bolt.rotation.z = cycling > 0 ? Math.min(1, cyc * 2) * 1.1 : 0; bolt.position.z = 0.07 + (cycling > 0 ? Math.max(0, cyc * 2 - 1) * 0.09 : 0); }\n            flash.intensity = flashT > 0 ? 8 : 0; flashSprite.material.opacity = flashT > 0 ? (suppressed ? 0.25 : 0.9) : 0; flashSprite.rotation.z = rng() * 6;\n            const fov = hipFov / THREE.MathUtils.lerp(1, zoom, a);\n            if (Math.abs(camera.fov - fov) > 0.01) { camera.fov = fov; camera.updateProjectionMatrix(); }\n            const isScoped = scoped && a > 0.92;\n            if (isScoped !== wasScoped) { wasScoped = isScoped; model.visible = !isScoped; onScope(isScoped); }\n        },\n        dispose() {\n            dead = true; rig.removeFromParent(); flashSprite.geometry.dispose(); flashSprite.material.dispose();\n            if (camera.fov !== hipFov) { camera.fov = hipFov; camera.updateProjectionMatrix(); }\n            if (wasScoped) onScope(false);\n        },\n    };\n}"}