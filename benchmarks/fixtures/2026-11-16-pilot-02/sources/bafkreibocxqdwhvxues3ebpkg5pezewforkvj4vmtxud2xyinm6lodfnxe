{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Moss garden</title>\n<meta name=\"description\" content=\"A walkable forest clearing: photo-scanned mossy rocks, barrels, lanterns and a council of marble busts under a cloudy sky. Find the twelve apples.\">\n<style>\n  html,body{margin:0;touch-action:none;-webkit-user-select:none;user-select:none;height:100%;overflow:hidden;background:#9cc3e6;font:14px system-ui,sans-serif}\n  #hud{position:fixed;top:10px;left:12px;color:#fff;text-shadow:0 1px 2px #000a;font-weight:600;pointer-events:none}\n  #msg{position:fixed;inset:0;display:grid;place-items:center;color:#fff;text-shadow:0 2px 4px #000a;font-size:22px;text-align:center;cursor:pointer;background:#0005}\n  #msg small{display:block;font-size:14px;opacity:.85;margin-top:8px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script>\n</head><body>\n<div id=\"hud\"></div><div id=\"msg\">loading…</div>\n<script type=\"module\">\nimport * as THREE from \"three\";\nimport { GLTFLoader } from \"three/addons/loaders/GLTFLoader.js\";\nimport * as SkeletonUtils from \"three/addons/utils/SkeletonUtils.js\";\n\nconst PARTS = {\"robot\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiezecuxadyslgydj7gwc3ihmujswsynwykrj4yjbofc4eggugam2y\",\"mossy-rocks\":\"https://ipfs-test.fangorn.network/ipfs/bafybeihpw3wzbwhzj7w4em5zpart4camqcvz6bxcnhu7s52f5sf73c42kq\",\"barrel\":\"https://ipfs-test.fangorn.network/ipfs/bafybeigpbqf3fnybpgtnuqjsyp2khyslehbngb6huq3gjpa4cklq7jc4ra\",\"lantern\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiebl5stslnp5wmc4ysvkbdzw2ucetszwy63m563mgx3vlsclwuhzu\",\"marble-bust\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiex2mosu3rf53rxbutbjdyq6pa4n7z4sblqvc6ygbiuuuzqxioacy\",\"apple\":\"https://ipfs-test.fangorn.network/ipfs/bafybeibhskuycs7yyxlmxwx5yfgnohrf4xrgzdgt5u32w545tvyy7a2nx4\",\"forest-ground-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafybeidjlqgtwmhoy4hjkskxgreaug2x2kg6f6vmwtt3powbhemzzw33ua\",\"day-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafybeid7dhs2ji7cfsd5mug7iagvtozqfp4yei7t4r3v6emzbxpqh7df7u\",\"coin-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6lmgvb7xur2rnodcgqbebxr4z4zypv7j2m5egibysabahllmxf4\",\"platformer-controller\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihbjdl3wwjfiiu7qne4a5qnskfj4lrieutjlv64yhqd25kbth7m74\",\"follow-camera\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiauise4tsy3llffneifcfwo25whtfrccjdjynf2bqj4jj5kypypha\",\"clip-animator\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiahogjc53z7qaa7x4j7nnus5rxahr6ojuaxb2m7oukkb3fxc3zj2y\",\"collect\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiant6lyf5xsnypb32bv6wz4e3bfkcww2ozbw4jbbjkmkjysdx2tui\",\"low-poly-trees\":\"https://ipfs-test.fangorn.network/ipfs/bafkreig5j3257727ytjzyvtfbd7rirnnpyeh7zwv4sci5w463uhjgft7ky\",\"hdri-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafkreif4o56shppr6t5ttbczmnyjhm5bgaklfsujajbd7y7mjznvtkv2ce\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\"};\nconst logic = async (id) => import(\"data:text/javascript;charset=utf-8,\" + encodeURIComponent((await (await fetch(PARTS[id])).json()).js));\nlogic(\"touch-controls\").then((t) => t.attach()); // a joystick and jump button on phones\nconst glb = (id) => new GLTFLoader().loadAsync(PARTS[id]);\n\nconst [controller, followCam, animator, collect, trees, sky, robotG, rocksG, barrelG, lanternG, bustG, appleG, groundTex] = await Promise.all([\n    logic(\"platformer-controller\"), logic(\"follow-camera\"), logic(\"clip-animator\"), logic(\"collect\"), logic(\"low-poly-trees\"), logic(\"hdri-sky\"),\n    glb(\"robot\"), glb(\"mossy-rocks\"), glb(\"barrel\"), glb(\"lantern\"), glb(\"marble-bust\"), glb(\"apple\"),\n    new THREE.TextureLoader().loadAsync(PARTS[\"forest-ground-texture\"]),\n]);\nconst audio = new AudioContext();\nconst coin = await audio.decodeAudioData(await (await fetch(PARTS[\"coin-sound\"])).arrayBuffer());\nconst play = () => { const s = audio.createBufferSource(); s.buffer = coin; s.connect(audio.destination); s.start(); };\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.shadowMap.enabled = true; renderer.toneMapping = THREE.ACESFilmicToneMapping;\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(55, 1, 0.1, 300);\nscene.fog = new THREE.Fog(0xb8d0e0, 25, 70);\nconst sun = new THREE.DirectionalLight(0xfff2dd, 2.2); sun.position.set(10, 18, 6); sun.castShadow = true;\nObject.assign(sun.shadow.camera, { left: -30, right: 30, top: 30, bottom: -30 }); sun.shadow.mapSize.set(2048, 2048);\nscene.add(sun);\nconst world = [sky.attach(scene, { url: PARTS[\"day-sky\"], intensity: 0.9 })];\n\n// The ground: one big slab of forest floor.\nconst R = 30, solids = [];\ngroundTex.wrapS = groundTex.wrapT = THREE.RepeatWrapping; groundTex.repeat.set(20, 20); groundTex.colorSpace = THREE.SRGBColorSpace;\nconst ground = new THREE.Mesh(new THREE.BoxGeometry(2 * R, 2, 2 * R), new THREE.MeshStandardMaterial({ map: groundTex, roughness: 1 }));\nground.position.y = -1; ground.receiveShadow = true; scene.add(ground); solids.push(ground);\n\nconst place = (src, [x, y, z], s = 1, ry = 0, solid = true) => {\n    const m = src.clone(); m.position.set(x, y, z); m.scale.setScalar(s); m.rotation.y = ry;\n    m.traverse((o) => { if (o.isMesh) o.castShadow = o.receiveShadow = true; }); scene.add(m); if (solid) solids.push(m); return m;\n};\n// Mossy boulders, one by one, ringing the clearing.\nrocksG.scene.children.forEach((rock, i) => {\n    const a = (i / 6) * Math.PI * 2 + 0.4, r = 13 + (i % 2) * 4;\n    const m = place(rock, [Math.cos(a) * r, 0, Math.sin(a) * r], 1.3, a);\n    m.position.y -= new THREE.Box3().setFromObject(m).min.y; // sit it on the ground\n});\n// A council of marble busts in a ring, all facing the middle.\nfor (let i = 0; i < 7; i++) {\n    const a = (i / 7) * Math.PI * 2;\n    place(bustG.scene, [Math.cos(a) * 6, 0, Math.sin(a) * 6], 2.4, -a - Math.PI / 2);\n}\n// Barrels, and lanterns glowing on top of some.\nfor (const [x, z, lit] of [[3, 9, 1], [4.2, 9.4, 0], [-9, 3, 1], [-9.5, 4.3, 0], [9, -4, 1], [-3, -10, 1]]) {\n    place(barrelG.scene, [x, 0, z], 1.4, x);\n    if (!lit) continue;\n    place(lanternG.scene, [x, 1.23, z], 2, 0, false);\n    const l = new THREE.PointLight(0xffaa55, 6, 6); l.position.set(x, 1.6, z); scene.add(l);\n}\nworld.push(trees.attach(scene, { count: 80, area: [2 * R - 4, 2 * R - 4], clear: 18, seed: 11 }));\n\n// Twelve apples hidden around the garden.\nconst apples = [[0, 0.6, 0], [4.2, 1.6, 9.4], [-9.5, 1.6, 4.3], [15, 0.6, 3], [-14, 0.6, -8], [5, 0.6, -15], [-4, 0.6, 16], [10.5, 0.6, -4],\n    [22, 0.6, 20], [-22, 0.6, 18], [20, 0.6, -21], [-20, 0.6, -22]].map((p) => place(appleG.scene, p, 5, 0, false));\n\nconst player = SkeletonUtils.clone(robotG.scene); player.scale.setScalar(0.35);\nplayer.traverse((o) => { if (o.isMesh) o.castShadow = true; }); scene.add(player);\n\nlet over = true, start = 0, got = 0;\nconst systems = [];\nfunction begin() {\n    for (const s of systems.splice(0)) s.dispose();\n    for (const a of apples) scene.add(a);\n    player.position.set(0, 0, 3); got = 0;\n    const ctl = controller.attach(player, { solids, camera });\n    systems.push(ctl, animator.attach(player, { animations: robotG.animations, state: () => ctl.state }), followCam.attach(camera, { target: player }),\n        collect.attach(player, { items: apples, radius: 1, onCollect: (a) => { a.removeFromParent(); got++; play(); }, onAll: () => {\n            over = true; $msg.innerHTML = `All twelve apples in ${((performance.now() - start) / 1000).toFixed(0)}s.<small>the busts approve · click to wander again</small>`; $msg.style.display = \"\";\n        } }));\n    over = false; start = performance.now(); $msg.style.display = \"none\";\n}\nconst $msg = document.getElementById(\"msg\"), $hud = document.getElementById(\"hud\");\n$msg.innerHTML = \"Moss garden<small>WASD / arrows · Shift to run · Space to jump<br>twelve apples are hidden around the garden<br><br>click to start</small>\";\n$msg.onclick = () => { audio.resume(); begin(); };\n\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\ncamera.position.set(0, 6, 14); camera.lookAt(0, 0, 0);\nconst clock = new THREE.Clock();\nrenderer.setAnimationLoop(() => {\n    const dt = clock.getDelta();\n    for (const w of world) w.update(dt);\n    if (!over) { for (const s of systems) s.update(dt); $hud.textContent = `apples ${got}/12`; }\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}