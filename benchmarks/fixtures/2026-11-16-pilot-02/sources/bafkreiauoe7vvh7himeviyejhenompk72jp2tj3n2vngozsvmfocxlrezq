{"js":"// SPDX-License-Identifier: CC0-1.0\n// Sample-free ambient bed, spatial generator and footsteps, started only by a gesture.\nexport function attach(object,{volume=.28,source={x:0,z:0},onStart=()=>{}}={}){\n let ctx,master,wind,osc,hum,panner,carrier,carrierGain,paused=true,time=0;const nodes=new Set();\n function start(){if(!ctx){ctx=new AudioContext();master=ctx.createGain();master.gain.value=volume;master.connect(ctx.destination);\n  const b=ctx.createBuffer(1,ctx.sampleRate*4,ctx.sampleRate),d=b.getChannelData(0);let last=0;for(let i=0;i<d.length;i++){last=(last+(Math.random()*2-1)*.025)/1.01;d[i]=last;}\n  wind=ctx.createBufferSource();wind.buffer=b;wind.loop=true;const filter=ctx.createBiquadFilter();filter.type='lowpass';filter.frequency.value=650;wind.connect(filter).connect(master);wind.start();\n  osc=ctx.createOscillator();osc.type='triangle';osc.frequency.value=55;hum=ctx.createGain();hum.gain.value=0;panner=ctx.createPanner();panner.panningModel='HRTF';panner.distanceModel='inverse';panner.refDistance=3;panner.maxDistance=65;panner.positionX.value=source.x;panner.positionZ.value=source.z;osc.connect(hum).connect(panner).connect(master);osc.start();carrier=ctx.createOscillator();carrier.type=\"sine\";carrier.frequency.value=440;carrierGain=ctx.createGain();carrierGain.gain.value=0;carrier.connect(carrierGain).connect(master);carrier.start();onStart();\n }paused=false;void ctx.resume();}\n function chirp(freq=1900,duration=.18,gain=.05){if(!ctx||paused)return;const o=ctx.createOscillator(),g=ctx.createGain();o.frequency.setValueAtTime(freq,ctx.currentTime);o.frequency.exponentialRampToValueAtTime(freq*.65,ctx.currentTime+duration);g.gain.setValueAtTime(gain,ctx.currentTime);g.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+duration);o.connect(g).connect(master);nodes.add(o);o.onended=()=>{o.disconnect();g.disconnect();nodes.delete(o);};o.start();o.stop(ctx.currentTime+duration);}\n return{start,pause(){paused=true;void ctx?.suspend();},setVolume(v){volume=Math.min(1,Math.max(0,v));if(master)master.gain.value=volume;},step(){chirp(100+Math.random()*60,.09,.13);},chime(){chirp(650,.5,.15);},bell(frequency=440){chirp(frequency,1.2,.35);},tune(frequency,signal){if(!ctx)return;carrier.frequency.setTargetAtTime(180+(frequency-88)*55,ctx.currentTime,.08);carrierGain.gain.setTargetAtTime(signal*.12,ctx.currentTime,.08);},update(dt,{x=0,y=1.7,z=0,yaw=0,powered=false}={}){if(!ctx||paused)return;time+=dt;if(time>5){time=0;chirp();}hum.gain.setTargetAtTime(powered?.22:0,ctx.currentTime,.3);const l=ctx.listener;l.positionX.value=x;l.positionY.value=y;l.positionZ.value=z;l.forwardX.value=-Math.sin(yaw);l.forwardY.value=0;l.forwardZ.value=-Math.cos(yaw);l.upX.value=0;l.upY.value=1;l.upZ.value=0;},dispose(){paused=true;nodes.forEach(n=>n.stop());wind?.stop();osc?.stop();carrier?.stop();void ctx?.close();}};\n}\n"}