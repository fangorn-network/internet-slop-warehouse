{"js":"// CC0-1.0. Extraction-shooter loadout rules: a stash, equipment slots, slot-limited chest rig and backpack,\n// reload only from the rig, lose everything carried on death, cash converts on extract, one trader.\n// Engine-independent and serialisable: the profile is plain JSON (feed it to `save-codec`).\n//\n// catalog[id] = { name, kind, size, price, stack?, capacity?, mods?: [modIds], buyUnit? }\n//   kind: gun | mod | armor | rig | backpack | map | ammo | cash | valuable\n// item = { uid, id, n?, mods?, mag?: { type, n }, durability?, items?: [], fir? }\n// profile = { money, stash: [items], equip: { primary, armor, rig, backpack, map } }\n\nexport const SLOTS = { gun: 'primary', armor: 'armor', rig: 'rig', backpack: 'backpack', map: 'map' };\nconst CONTAINERS = new Set(['rig', 'backpack']);\n\nexport function makeHelpers(catalog) {\n    const spec = (item) => { const s = catalog[item?.id]; if (!s) throw new Error('Unknown item ' + item?.id); return s; };\n    const units = (item) => (spec(item).stack ? item.n ?? 1 : 1);\n    const slotsFor = (item) => { const s = spec(item); return s.stack ? Math.ceil(units(item) / s.stack) * s.size : s.size; };\n    const used = (list) => list.reduce((sum, it) => sum + slotsFor(it), 0);\n    const count = (list, id) => list.reduce((sum, it) => sum + (it.id === id ? units(it) : 0), 0);\n    /** Add item to list within capacity. Stackables top up existing stacks first. Returns units NOT added. */\n    function add(list, capacity, item, newUid) {\n        const s = spec(item);\n        if (!s.stack) { if (used(list) + s.size > capacity) return 1; list.push(item); return 0; }\n        let left = units(item);\n        for (const it of list) {\n            if (it.id !== item.id || left <= 0) continue;\n            const room = s.stack - ((it.n ?? 1) % s.stack || s.stack); // fill the partial stack only\n            const put = Math.min(room, left); it.n = (it.n ?? 1) + put; left -= put;\n        }\n        while (left > 0 && used(list) + s.size <= capacity) {\n            const put = Math.min(s.stack, left);\n            list.push({ ...item, uid: list.some((x) => x.uid === item.uid) ? newUid() : item.uid, n: put });\n            left -= put;\n        }\n        return left;\n    }\n    /** Remove up to n units of stackable `id` from list (smallest stacks first). Returns units taken. */\n    function take(list, id, n) {\n        let got = 0;\n        for (const it of [...list].filter((x) => x.id === id).sort((a, b) => units(a) - units(b))) {\n            if (got >= n) break;\n            const t = Math.min(n - got, units(it)); it.n = units(it) - t; got += t;\n            if (!it.n) list.splice(list.indexOf(it), 1);\n        }\n        return got;\n    }\n    const value = (item) => {\n        const s = spec(item);\n        let v = s.kind === 'ammo' ? (s.price / (s.buyUnit || 1)) * units(item) : s.price * (s.stack ? units(item) : 1);\n        for (const m of item.mods ?? []) v += catalog[m]?.price ?? 0;\n        for (const inner of item.items ?? []) v += value(inner);\n        return Math.round(v);\n    };\n    return { spec, units, slotsFor, used, count, add, take, value };\n}\n\nexport function attach(profile, {\n    catalog,\n    stashSlots = 150,\n    sellRate = 0.5,\n    newUid = () => Math.random().toString(36).slice(2, 10),\n    onChange = () => {},\n    onReject = () => {},\n} = {}) {\n    if (!catalog) throw new Error('catalog required');\n    const h = makeHelpers(catalog);\n    let dead = false;\n    const changed = (what) => { onChange(what, profile); return true; };\n    const reject = (why) => { onReject(why); return false; };\n\n    // A container ref is 'stash' | 'rig' | 'backpack' | { items, capacity } (a crate or a body in the world).\n    function box(ref) {\n        if (ref === 'stash') return { items: profile.stash, capacity: stashSlots, kind: 'stash' };\n        if (CONTAINERS.has(ref)) {\n            const c = profile.equip[ref];\n            return c ? { items: (c.items ??= []), capacity: h.spec(c).capacity, kind: ref } : null;\n        }\n        return ref && Array.isArray(ref.items) ? { items: ref.items, capacity: ref.capacity ?? Infinity, kind: 'world' } : null;\n    }\n    // Rigs hold only one-slot things; no container may hold a non-empty container.\n    function allowed(item, b) {\n        const s = h.spec(item);\n        if (CONTAINERS.has(s.kind) && (item.items?.length ?? 0) > 0 && b.kind !== 'stash' && b.kind !== 'world') return 'Empty it first';\n        if (b.kind === 'rig' && s.size > 1) return 'Too big for a chest rig';\n        return null;\n    }\n\n    const api = {\n        helpers: h,\n        box,\n        /** Move an item (or n units of a stack) between containers. */\n        move(uid, from, to, n = Infinity) {\n            const a = box(from), b = box(to);\n            if (dead || !a || !b) return reject('No such container');\n            const item = a.items.find((x) => x.uid === uid);\n            if (!item) return reject('Item not found');\n            const why = allowed(item, b); if (why) return reject(why);\n            const isStack = !!h.spec(item).stack, want = isStack ? Math.min(n, h.units(item)) : 1;\n            const moving = isStack ? { ...item, uid: newUid(), n: want } : item;\n            if (!isStack) a.items.splice(a.items.indexOf(item), 1);\n            const left = h.add(b.items, b.capacity, moving, newUid);\n            if (!isStack) { if (left) { a.items.push(item); return reject('Not enough space'); } }\n            else { item.n = h.units(item) - (want - left); if (!item.n) a.items.splice(a.items.indexOf(item), 1); if (left === want) return reject('Not enough space'); }\n            return changed('move');\n        },\n        /** Equip an item from a container into its slot; the previous one goes back where this came from. */\n        equip(uid, from) {\n            const a = box(from); if (dead || !a) return reject('No such container');\n            const item = a.items.find((x) => x.uid === uid); if (!item) return reject('Item not found');\n            const slot = SLOTS[h.spec(item).kind]; if (!slot) return reject('Cannot equip that');\n            const prev = profile.equip[slot];\n            a.items.splice(a.items.indexOf(item), 1);\n            if (prev) {\n                const why = allowed(prev, a) || (h.add(a.items, a.capacity, prev, newUid) ? 'Not enough space' : null);\n                if (why) { a.items.push(item); return reject(why); }\n            }\n            profile.equip[slot] = item; return changed('equip');\n        },\n        unequip(slot, to) {\n            const item = profile.equip[slot], b = box(to);\n            if (dead || !item || !b) return reject('Nothing to unequip');\n            if (CONTAINERS.has(slot) && to === slot) return reject('Cannot put it inside itself');\n            const why = allowed(item, b) || (h.add(b.items, b.capacity, item, newUid) ? 'Not enough space' : null);\n            if (why) return reject(why);\n            profile.equip[slot] = null; return changed('unequip');\n        },\n        /** Fit a mod from a container onto the equipped or stashed gun `gunUid`. */\n        attachMod(gunUid, modUid, from) {\n            const gun = profile.equip.primary?.uid === gunUid ? profile.equip.primary : profile.stash.find((x) => x.uid === gunUid);\n            const a = box(from), mod = a?.items.find((x) => x.uid === modUid);\n            if (!gun || !mod) return reject('Not found');\n            if (!(h.spec(gun).mods ?? []).includes(mod.id)) return reject(`${h.spec(mod).name} doesn't fit the ${h.spec(gun).name}`);\n            if ((gun.mods ??= []).includes(mod.id)) return reject('Already fitted');\n            a.items.splice(a.items.indexOf(mod), 1); gun.mods.push(mod.id); return changed('mod');\n        },\n        detachMod(gunUid, modId, to) {\n            const gun = profile.equip.primary?.uid === gunUid ? profile.equip.primary : profile.stash.find((x) => x.uid === gunUid);\n            const b = box(to);\n            if (!gun?.mods?.includes(modId) || !b) return reject('Not fitted');\n            if (h.add(b.items, b.capacity, { uid: newUid(), id: modId }, newUid)) return reject('Not enough space');\n            gun.mods = gun.mods.filter((m) => m !== modId); return changed('mod');\n        },\n        /** Ammo counts by catalog id in the chest rig — the only place a reload may draw from. */\n        rigAmmo() {\n            const out = {}; for (const it of profile.equip.rig?.items ?? []) if (h.spec(it).kind === 'ammo') out[it.id] = (out[it.id] ?? 0) + h.units(it);\n            return out;\n        },\n        takeAmmo(id, n) { const rig = profile.equip.rig; if (dead || !rig) return 0; const got = h.take(rig.items ??= [], id, n); if (got) changed('ammo'); return got; },\n        /** Death: everything carried is gone. Returns what was lost. */\n        die() { const lost = Object.values(profile.equip).filter(Boolean); for (const k of Object.keys(profile.equip)) profile.equip[k] = null; changed('die'); return lost; },\n        /** Extraction: cash carried in rig/backpack is banked. Returns money banked. */\n        extract() {\n            let banked = 0;\n            for (const slot of CONTAINERS) {\n                const c = profile.equip[slot]; if (!c?.items) continue;\n                for (const it of [...c.items]) if (h.spec(it).kind === 'cash') { banked += h.units(it) * h.spec(it).price; c.items.splice(c.items.indexOf(it), 1); }\n            }\n            profile.money += banked; changed('extract'); return banked;\n        },\n        price(id) { return h.spec({ id }).price; },\n        sellPrice(item) { return h.spec(item).kind === 'cash' ? h.value(item) : Math.floor(h.value(item) * sellRate); },\n        buy(id, qty = 1) {\n            const s = h.spec({ id }), unit = s.buyUnit || 1, cost = s.price * qty;\n            if (profile.money < cost) return reject('Not enough money');\n            const item = { uid: newUid(), id, ...(s.stack ? { n: unit * qty } : {}), ...(s.kind === 'armor' ? { durability: s.durability } : {}), ...(CONTAINERS.has(s.kind) ? { items: [] } : {}), ...(s.kind === 'gun' ? { mods: [], mag: null } : {}) };\n            if (h.add(profile.stash, stashSlots, item, newUid)) return reject('Stash is full');\n            profile.money -= cost; return changed('buy');\n        },\n        sell(uid) {\n            const item = profile.stash.find((x) => x.uid === uid); if (!item) return reject('Item not found');\n            if ((item.items?.length ?? 0) > 0) return reject('Empty it first');\n            profile.money += api.sellPrice(item); profile.stash.splice(profile.stash.indexOf(item), 1); return changed('sell');\n        },\n        update() {},\n        dispose() { dead = true; },\n    };\n    return api;\n}"}