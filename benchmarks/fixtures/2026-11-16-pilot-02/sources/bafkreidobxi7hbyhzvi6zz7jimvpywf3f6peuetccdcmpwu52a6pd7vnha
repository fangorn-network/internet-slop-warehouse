{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Coin rush</title>\n<meta name=\"description\" content=\"A tiny third-person platformer built from slop warehouse parts.\">\n<style>\n  html,body{margin:0;touch-action:none;-webkit-user-select:none;user-select:none;height:100%;overflow:hidden;background:#8ec5ff;font:14px system-ui,sans-serif}\n  #hud{position:fixed;top:10px;left:12px;color:#fff;text-shadow:0 1px 2px #0008;font-weight:600;pointer-events:none}\n  #msg{position:fixed;inset:0;display:grid;place-items:center;color:#fff;text-shadow:0 2px 4px #0009;font-size:22px;text-align:center;cursor:pointer;background:#0004}\n  #msg small{display:block;font-size:14px;opacity:.85;margin-top:8px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script>\n</head><body>\n<div id=\"hud\"></div><div id=\"msg\">loading…</div>\n<script type=\"module\">\nimport * as THREE from \"three\";\nimport { GLTFLoader } from \"three/addons/loaders/GLTFLoader.js\";\nimport * as SkeletonUtils from \"three/addons/utils/SkeletonUtils.js\";\n\n// Every part this game builds on, by id → its file, pinned (filled in when it's published).\nconst PARTS = {\"robot\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiezecuxadyslgydj7gwc3ihmujswsynwykrj4yjbofc4eggugam2y\",\"grass-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafkreibpj4yzdql6ltoxdkfxkm7thc546n4dhr2zqshz4jqtj2ocvxf66e\",\"crate-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiajinmww4tgdrzi64wi4bfqvua3dlvsmnclvmzjk7zyo2hqbxqram\",\"coin-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6lmgvb7xur2rnodcgqbebxr4z4zypv7j2m5egibysabahllmxf4\",\"jump-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreickrhtm4jnxehlxtq2qlowctwixqt3xth7yi7vlwaxv63nvjlnf54\",\"hit-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreidqejf2negsnotb3xo7p3m7fv2xfst6oqlpqfnk5dn4vctwp56k74\",\"platformer-controller\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihbjdl3wwjfiiu7qne4a5qnskfj4lrieutjlv64yhqd25kbth7m74\",\"patrol\":\"https://ipfs-test.fangorn.network/ipfs/bafkreig4sntado3q4izlueu4spl2pydk6yiad4cdab6vimthb6mwabpw7m\",\"flee-on-see\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiaz5kuq7nhschwl7qxt65cmsq4ooh6hvhlx5o7apnlkcbgw6b5q2e\",\"collect\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiant6lyf5xsnypb32bv6wz4e3bfkcww2ozbw4jbbjkmkjysdx2tui\",\"follow-camera\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiauise4tsy3llffneifcfwo25whtfrccjdjynf2bqj4jj5kypypha\",\"clip-animator\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiahogjc53z7qaa7x4j7nnus5rxahr6ojuaxb2m7oukkb3fxc3zj2y\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\"};\n// Logic is stored as { js }: import it from its text. Its bare \"three\" resolves through the import map above.\nconst logic = async (id) => import(\"data:text/javascript;charset=utf-8,\" + encodeURIComponent((await (await fetch(PARTS[id])).json()).js));\nlogic(\"touch-controls\").then((t) => t.attach()); // a joystick and jump button on phones\n\nconst [controller, patrol, flee, collect, followCam, animator, gltf, grassTex, crateTex] = await Promise.all([\n    logic(\"platformer-controller\"), logic(\"patrol\"), logic(\"flee-on-see\"), logic(\"collect\"), logic(\"follow-camera\"), logic(\"clip-animator\"),\n    new GLTFLoader().loadAsync(PARTS[\"robot\"]),\n    new THREE.TextureLoader().loadAsync(PARTS[\"grass-texture\"]), new THREE.TextureLoader().loadAsync(PARTS[\"crate-texture\"]),\n]);\nconst audio = new AudioContext();\nconst sounds = Object.fromEntries(await Promise.all([\"coin-sound\", \"jump-sound\", \"hit-sound\"].map(async (id) =>\n    [id, await audio.decodeAudioData(await (await fetch(PARTS[id])).arrayBuffer())])));\nconst play = (id) => { const s = audio.createBufferSource(); s.buffer = sounds[id]; s.connect(audio.destination); s.start(); };\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.shadowMap.enabled = true;\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(55, 1, 0.1, 200);\nscene.background = new THREE.Color(0x8ec5ff); scene.fog = new THREE.Fog(0x8ec5ff, 30, 70);\nscene.add(new THREE.HemisphereLight(0xffffff, 0x446622, 1.2));\nconst sun = new THREE.DirectionalLight(0xffffff, 2); sun.position.set(8, 15, 6); sun.castShadow = true;\nObject.assign(sun.shadow.camera, { left: -25, right: 25, top: 25, bottom: -25 }); sun.shadow.mapSize.set(2048, 2048);\nscene.add(sun);\n\n// The level: grass platforms and crates (the solids), coins, a star, and two guards.\nfor (const t of [grassTex, crateTex]) { t.magFilter = THREE.NearestFilter; t.colorSpace = THREE.SRGBColorSpace; t.wrapS = t.wrapT = THREE.RepeatWrapping; }\nconst solids = [];\nfunction block(x, y, z, w, h, d, crate = false) {\n    const tex = (crate ? crateTex : grassTex).clone(); tex.repeat.set(crate ? 1 : w / 2, crate ? 1 : d / 2); tex.needsUpdate = true;\n    const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), new THREE.MeshLambertMaterial({ map: tex }));\n    m.position.set(x, y - h / 2, z); m.castShadow = m.receiveShadow = true; scene.add(m); solids.push(m); return m;\n}\nblock(0, 0, 0, 14, 2, 14);                     // the start\nblock(0, 0, -15, 10, 2, 10);                   // across the gap\nblock(10, 1.2, -10, 5, 2, 5);                  // up to the right\nblock(-9, 1.4, -22, 5, 2, 5);                  // high left\nblock(3, 1, 3, 1.2, 1, 1.2, true); block(-4, 1, -2, 1.2, 1, 1.2, true); block(-4, 2, -2.2, 1.2, 1, 1.2, true);\nblock(2, 1, -15, 1.2, 1, 1.2, true); block(-2, 1, -18, 1.2, 1, 1.2, true);\n\nconst coinGeo = new THREE.CylinderGeometry(0.35, 0.35, 0.08, 20).rotateX(Math.PI / 2);\nconst coinMat = new THREE.MeshStandardMaterial({ color: 0xffcc33, metalness: 0.8, roughness: 0.3, emissive: 0x442200 });\nconst coins = [[3, 1, 0], [-3, 1, 3], [-4, 3.6, -2.2], [0, 1, -12], [3, 1, -19], [-3, 1, -14], [10, 2.2, -10], [-9, 2.4, -22], [5.5, 1, -6]].map(([x, y, z]) => {\n    const c = new THREE.Mesh(coinGeo, coinMat); c.position.set(x, y, z); c.castShadow = true; scene.add(c); return c;\n});\nconst star = new THREE.Mesh(new THREE.OctahedronGeometry(0.45), new THREE.MeshStandardMaterial({ color: 0x66ffff, emissive: 0x2288aa }));\nstar.position.set(0, 1.2, -18); scene.add(star);\n\n// Characters: the robot (scaled to 1.6 units) for the player, red clones for the guards.\nconst robot = (tint) => {\n    const m = SkeletonUtils.clone(gltf.scene); m.scale.setScalar(0.35);\n    m.traverse((o) => { if (o.isMesh) { o.castShadow = true; if (tint) { o.material = o.material.clone(); o.material.color.multiply(new THREE.Color(tint)); } } });\n    scene.add(m); return m;\n};\nconst player = robot(); player.position.set(0, 0, 4);\nconst guards = [\n    { at: [-4, 0, -14], points: [[-4, 0, -14], [4, 0, -14], [4, 0, -19], [-4, 0, -19]] },\n    { at: [-5, 0, 4], points: [[-5, 0, 4], [-5, 0, -4], [5, 0, -4]] },\n].map(({ at, points }) => ({ model: robot(0xff5555), at, points: points.map((p) => new THREE.Vector3(...p)) }));\n\n// Wiring: every behaviour is attach(object, opts) → { update(dt), dispose() }.\nlet score = 0, start = 0, over = true, scaredUntil = 0;\nconst systems = [];\nfunction begin() {\n    for (const s of systems.splice(0)) s.dispose();\n    for (const c of coins) scene.add(c); scene.add(star);\n    player.position.set(0, 0, 4); score = 0; scaredUntil = 0;\n    const ctl = controller.attach(player, { solids, camera, onJump: () => play(\"jump-sound\"),\n        onFall: () => lose(\"You fell.\") });\n    systems.push(ctl, animator.attach(player, { animations: gltf.animations, state: () => ctl.state }), followCam.attach(camera, { target: player }));\n    systems.push(collect.attach(player, { items: coins, onCollect: (c) => { c.removeFromParent(); score++; play(\"coin-sound\"); }, onAll: win }));\n    systems.push(collect.attach(player, { items: [star], onCollect: (s) => { s.removeFromParent(); scaredUntil = performance.now() + 6000; play(\"coin-sound\"); } }));\n    for (const g of guards) {\n        scene.add(g.model); g.model.position.set(...g.at);\n        g.ai = patrol.attach(g.model, { points: g.points, target: player, sight: 7,\n            onTouch: (self) => {\n                if (performance.now() < scaredUntil) { self.removeFromParent(); play(\"hit-sound\"); } // bonked\n                else lose(\"A guard got you.\");\n            } });\n        systems.push(g.ai, animator.attach(g.model, { animations: gltf.animations, state: () => g.ai.alert ? \"run\" : \"walk\" }));\n    }\n    over = false; start = performance.now(); $msg.style.display = \"none\";\n}\nfunction end(text) { over = true; $msg.innerHTML = text + \"<small>click to play again</small>\"; $msg.style.display = \"\"; }\nconst lose = (why) => { play(\"hit-sound\"); end(why); };\nconst win = () => end(`All ${coins.length} coins in ${((performance.now() - start) / 1000).toFixed(1)}s!`);\n\nconst $msg = document.getElementById(\"msg\"), $hud = document.getElementById(\"hud\");\n$msg.innerHTML = \"Coin rush<small>WASD / arrows to move · Shift to run · Space to jump<br>grab every coin; the star scares the guards<br><br>click to start</small>\";\n$msg.onclick = () => { audio.resume(); begin(); };\n\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\ncamera.position.set(0, 5, 12); camera.lookAt(0, 0, 0);\nconst clock = new THREE.Clock();\nrenderer.setAnimationLoop(() => {\n    const dt = clock.getDelta();\n    if (!over) {\n        // The override, live: while the star lasts, the guards' onSee is flee-on-see instead of patrol's chase.\n        const scared = performance.now() < scaredUntil;\n        for (const g of guards) if (g.ai) g.ai.hooks.onSee = scared ? flee.onSee : patrol.chase;\n        for (const s of systems) s.update(dt);\n        $hud.textContent = `coins ${score}/${coins.length} · ${((performance.now() - start) / 1000).toFixed(1)}s${scared ? \" · ★ guards are scared\" : \"\"}`;\n    }\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}