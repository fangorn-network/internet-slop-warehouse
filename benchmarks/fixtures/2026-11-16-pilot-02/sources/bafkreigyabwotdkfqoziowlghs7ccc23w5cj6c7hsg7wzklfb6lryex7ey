{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<title>Orbit</title>\n<meta name=\"description\" content=\"A small blue planet circling a glowing sun, with a moon circling it in turn. Scroll to zoom.\">\n<meta name=\"keywords\" content=\"demo, planets, orbit, solar system, space\">\n<style>html,body{margin:0;height:100%;overflow:hidden;background:#02030a}</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\"}}</script>\n</head><body><script type=\"module\">\nimport * as THREE from \"three\";\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(50, 1, 0.1, 200);\nlet dist = 14;\nconst sun = new THREE.Mesh(new THREE.SphereGeometry(1.2, 32, 16), new THREE.MeshBasicMaterial({ color: 0xffcc55 }));\nscene.add(sun, new THREE.PointLight(0xffffff, 60), new THREE.AmbientLight(0x223344));\nconst planet = new THREE.Mesh(new THREE.SphereGeometry(0.45, 32, 16), new THREE.MeshStandardMaterial({ color: 0x3a7bd5 }));\nconst moon = new THREE.Mesh(new THREE.SphereGeometry(0.12, 16, 8), new THREE.MeshStandardMaterial({ color: 0xaaaaaa }));\nplanet.add(moon); moon.position.x = 0.9; scene.add(planet);\naddEventListener(\"wheel\", (e) => { dist = Math.min(40, Math.max(5, dist + e.deltaY * 0.01)); });\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\nrenderer.setAnimationLoop((t) => {\n    const a = t / 3000;\n    planet.position.set(Math.cos(a) * 5, 0, Math.sin(a) * 5);\n    planet.rotation.y = t / 4000;\n    camera.position.set(0, dist * 0.5, dist); camera.lookAt(0, 0, 0);\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}