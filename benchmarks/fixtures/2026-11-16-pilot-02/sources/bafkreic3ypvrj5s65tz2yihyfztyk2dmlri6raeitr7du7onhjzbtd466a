{"js":"// CC0. A reusable flooded grove, with open navigation channels and a shader-rippled water sheet.\nimport * as THREE from 'three';\nexport function attach(scene,{seed=13,radius=46,waterColor=0x1c5552,fogColor=0x86aca0,onReady=()=>{}}={}){\n    const root=new THREE.Group();scene.add(root);const old={background:scene.background,fog:scene.fog};\n    scene.background=new THREE.Color(fogColor);scene.fog=new THREE.FogExp2(fogColor,.012);\n    let s=seed>>>0;const rand=()=>((s=(Math.imul(s,1664525)+1013904223)>>>0)/4294967296);\n    const mesh=(geo,mat,x,y,z)=>{const m=new THREE.Mesh(geo,mat);m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;root.add(m);return m;};\n    const bark=new THREE.MeshStandardMaterial({color:0x263d32,roughness:.9}),leaf=new THREE.MeshStandardMaterial({color:0x476f54,roughness:1,flatShading:true});\n    const waterMat=new THREE.MeshStandardMaterial({color:waterColor,metalness:.65,roughness:.23});let shader;\n    waterMat.onBeforeCompile=p=>{shader=p;p.uniforms.uTime={value:0};p.vertexShader='uniform float uTime;\\n'+p.vertexShader;p.vertexShader=p.vertexShader.replace('#include <beginnormal_vertex>','#include <beginnormal_vertex>\\n objectNormal = normalize(vec3(-cos(position.x*.45+uTime)*.02475, sin(position.y*.33-uTime*.7)*.0132, 1.0));');p.vertexShader=p.vertexShader.replace('#include <begin_vertex>','#include <begin_vertex>\\n transformed.z += sin(position.x*.45+uTime)*.055 + cos(position.y*.33-uTime*.7)*.04;');};\n    const water=mesh(new THREE.PlaneGeometry(220,220,96,96),waterMat,0,-.05,0);water.rotation.x=-Math.PI/2;water.castShadow=false;\n    const trunkGeo=new THREE.CylinderGeometry(.18,.32,1,7),crownGeo=new THREE.IcosahedronGeometry(1,1);\n    for(let i=0;i<95;i++){\n        const a=rand()*Math.PI*2,r=radius+(rand()-.35)*22,h=5+rand()*13,x=Math.cos(a)*r,z=Math.sin(a)*r;\n        const trunk=mesh(trunkGeo,bark,x,h/2-.4,z);trunk.scale.y=h;\n        const crown=mesh(crownGeo,leaf,x,h-.3,z);crown.scale.set(2+rand()*2,1.3+rand()*2,2+rand()*2);\n    }\n    const islandMat=new THREE.MeshStandardMaterial({color:0x506947,roughness:1}),islandGeo=new THREE.CylinderGeometry(1,1.25,.6,18);\n    for(let i=0;i<12;i++){const a=i/12*Math.PI*2,r=radius+6,x=Math.cos(a)*r,z=Math.sin(a)*r;const m=mesh(islandGeo,islandMat,x,-.3,z);m.scale.setScalar(2+rand()*3);}\n    const hemi=new THREE.HemisphereLight(0xd1eed3,0x223b35,2);root.add(hemi);\n    const sun=new THREE.DirectionalLight(0xffe0a3,3.3);sun.position.set(-20,30,-40);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);Object.assign(sun.shadow.camera,{left:-45,right:45,top:45,bottom:-45,near:.1,far:160});sun.shadow.normalBias=.04;root.add(sun);\n    const moon=mesh(new THREE.SphereGeometry(6,24,16),new THREE.MeshBasicMaterial({color:0xe5f0bd}),-48,12,-90);\n    const route=[[0,-14],[18,-25],[29,-4],[20,22],[-8,27],[-26,10],[-23,-17],[0,2]].map(([x,z])=>new THREE.Vector3(x,.8,z));\n    let t=0,dead=false;const handle={root,water,route,spawn:new THREE.Vector3(0,.8,5),bounds:[-42,42,-38,38],obstacles:[],\n        update(dt){if(dead)return;t+=dt;if(shader)shader.uniforms.uTime.value=t;moon.position.y=12+Math.sin(t*.03)*.5;},\n        dispose(){if(dead)return;dead=true;root.removeFromParent();const g=new Set(),m=new Set();root.traverse(o=>{if(o.geometry)g.add(o.geometry);if(o.material)m.add(o.material);});g.forEach(x=>x.dispose());m.forEach(x=>x.dispose());if(scene.background!==old.background)scene.background=old.background;scene.fog=old.fog;},\n    };onReady(handle);return handle;\n}\n"}