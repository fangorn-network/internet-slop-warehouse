{"js":"// SPDX-License-Identifier: CC0-1.0\n// Shared cooldown/cost gating for attacks, scanner pulses, healing or interaction skills.\nexport function attach(object,{abilities={},inventory,onActivate=()=>{},onReject=()=>{},initial={}}={}){\n const remaining={};for(const[id,a]of Object.entries(abilities)){if(a.cost&&Object.values(a.cost).some(n=>!Number.isSafeInteger(n)||n<0))throw Error('Invalid ability cost');if(!Number.isFinite(a.cooldown)||a.cooldown<0)throw Error('Invalid ability cooldown');const t=initial[id]??0;if(!Number.isFinite(t)||t<0||t>a.cooldown)throw Error('Invalid initial cooldown');remaining[id]=t;}let dead=false;\n return{get remaining(){return{...remaining};},activate(id,payload){const a=Object.hasOwn(abilities,id)?abilities[id]:null;if(dead||!a||remaining[id]>0||a.canUse&&!a.canUse(object,payload)){onReject(id,'unavailable');return false;}if(a.cost&&(!inventory||!inventory.transact(Object.fromEntries(Object.entries(a.cost).map(([k,n])=>[k,-n]))))){onReject(id,'resources');return false;}remaining[id]=a.cooldown;onActivate(id,payload,object);return true;},update(dt){if(dead||!Number.isFinite(dt)||dt<=0)return;for(const id of Object.keys(remaining))remaining[id]=Math.max(0,remaining[id]-dt);},dispose(){dead=true;}};\n}\n"}