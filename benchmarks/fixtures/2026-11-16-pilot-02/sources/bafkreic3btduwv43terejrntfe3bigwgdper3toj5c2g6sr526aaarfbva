{"js":"// CC0-1.0. Synthesized combat sound, no samples: rifle / shotgun / bolt-action shots (and suppressed versions),\n// dry fire, magazine/pump/bolt mechanics, bullet impacts by surface, and zombie groans. Positional: distance\n// muffles and quiets a sound and it pans by where it is relative to the listener (usually the camera).\nimport * as THREE from 'three';\n\nexport const SHOTS = {\n    rifle:   { crack: 0.11, crackHz: 2400, boomHz: 150, boom: 0.16, level: 1.0 },\n    shotgun: { crack: 0.2, crackHz: 1500, boomHz: 85, boom: 0.32, level: 1.3 },\n    bolt:    { crack: 0.15, crackHz: 2800, boomHz: 170, boom: 0.24, level: 1.25 },\n};\n\nexport function attach(listener, {\n    volume = 0.8, reverb = 0.3, falloff = 14, muffle = 55,\n    shots = SHOTS,\n    // Hook: change how distance affects a sound. Return { gain, cutoff }.\n    attenuate = (d) => ({ gain: 1 / (1 + Math.pow(d / falloff, 1.25)), cutoff: Math.max(500, 17000 * Math.exp(-d / muffle)) }),\n} = {}) {\n    let ctx = null, master = null, wet = null, noise = null, dead = false;\n    const v = new THREE.Vector3(), lp = new THREE.Vector3(), right = new THREE.Vector3(), q = new THREE.Quaternion();\n    function ensure() {\n        if (ctx || dead) return ctx;\n        const AC = globalThis.AudioContext || globalThis.webkitAudioContext; if (!AC) return null;\n        ctx = new AC(); master = ctx.createGain(); master.gain.value = volume; master.connect(ctx.destination);\n        const conv = ctx.createConvolver(), len = ctx.sampleRate * 2.2, ir = ctx.createBuffer(2, len, ctx.sampleRate);\n        for (let c = 0; c < 2; c++) { const d = ir.getChannelData(c); for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.6); }\n        conv.buffer = ir; wet = ctx.createGain(); wet.gain.value = reverb; conv.connect(wet).connect(master); wet.input = conv;\n        noise = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate); const nd = noise.getChannelData(0); for (let i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1;\n        return ctx;\n    }\n    // Output chain for a sound at `position` (null = at the listener).\n    function out(position, send = 1) {\n        const c = ensure(); if (!c) return null;\n        let gain = 1, cutoff = 18000, pan = 0;\n        if (position) {\n            listener.getWorldPosition(lp); v.set(position.x, position.y ?? lp.y, position.z).sub(lp);\n            const a = attenuate(v.length()); gain = a.gain; cutoff = a.cutoff;\n            listener.getWorldQuaternion(q); right.set(1, 0, 0).applyQuaternion(q);\n            pan = v.lengthSq() > 1e-6 ? Math.max(-1, Math.min(1, v.normalize().dot(right))) * 0.85 : 0;\n        }\n        const filter = c.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = cutoff;\n        const g = c.createGain(); g.gain.value = gain;\n        const p = c.createStereoPanner ? c.createStereoPanner() : c.createGain(); if (p.pan) p.pan.value = pan;\n        filter.connect(g).connect(p).connect(master);\n        if (send) { const s = c.createGain(); s.gain.value = send; p.connect(s).connect(wet.input); }\n        return filter;\n    }\n    function burst(dest, t, dur, level, type, hz, Q = 0.7) {\n        const src = ctx.createBufferSource(); src.buffer = noise; src.playbackRate.value = 0.8 + Math.random() * 0.4;\n        const f = ctx.createBiquadFilter(); f.type = type; f.frequency.value = hz; f.Q.value = Q;\n        const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(level, t + 0.002); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n        src.connect(f).connect(g).connect(dest); src.start(t, Math.random() * 0.5); src.stop(t + dur + 0.05);\n    }\n    function tone(dest, t, dur, level, f0, f1, type = 'sine') {\n        const o = ctx.createOscillator(); o.type = type; o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(f1, t + dur);\n        const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(level, t + 0.004); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n        o.connect(g).connect(dest); o.start(t); o.stop(t + dur + 0.05);\n    }\n    const clicks = (pattern, position) => { const d = out(position, 0.2); if (!d) return; const t = ctx.currentTime; for (const [at, hz, level, dur = 0.012] of pattern) burst(d, t + at, dur, level, 'bandpass', hz, 2.5); };\n\n    return {\n        /** Call from a user gesture (click/keypress) so the browser lets audio start. */\n        resume() { ensure()?.resume?.(); },\n        shot({ kind = 'rifle', suppressed = false, position = null } = {}) {\n            const s = shots[kind] ?? shots.rifle, d = out(position, suppressed ? 0.25 : 1); if (!d) return;\n            const t = ctx.currentTime;\n            if (suppressed) { burst(d, t, 0.07, 0.5 * s.level, 'lowpass', 1300); tone(d, t, 0.05, 0.25, 220, 90); burst(d, t + 0.01, 0.03, 0.15, 'highpass', 4000); return; }\n            burst(d, t, s.crack, 1.0 * s.level, 'highpass', s.crackHz * 0.4);\n            burst(d, t, s.crack * 2.2, 0.7 * s.level, 'lowpass', s.crackHz);\n            tone(d, t, s.boom, 0.9 * s.level, s.boomHz, 38);\n        },\n        dry(position) { clicks([[0, 3200, 0.35, 0.008]], position); },\n        mechanics(action, position) {\n            const p = { 'mag-out': [[0, 1400, 0.3], [0.05, 900, 0.25, 0.03]], 'mag-in': [[0, 1200, 0.4], [0.03, 2600, 0.35]], charge: [[0, 2200, 0.35], [0.12, 1800, 0.4]],\n                pump: [[0, 900, 0.45, 0.04], [0.22, 1300, 0.5, 0.03]], bolt: [[0, 2600, 0.35], [0.12, 1600, 0.3, 0.03], [0.32, 1800, 0.35, 0.03], [0.45, 2800, 0.4]],\n                shell: [[0, 1100, 0.3, 0.02], [0.06, 2000, 0.25]] }[action];\n            if (p) clicks(p, position);\n        },\n        impact(surface = 'concrete', position = null) {\n            const d = out(position, 0.3); if (!d) return; const t = ctx.currentTime;\n            if (surface === 'flesh') { burst(d, t, 0.09, 0.6, 'lowpass', 420); tone(d, t, 0.06, 0.3, 140, 60); }\n            else if (surface === 'metal') { burst(d, t, 0.03, 0.5, 'highpass', 3000); tone(d, t, 0.35, 0.18, 1150 + Math.random() * 300, 980, 'triangle'); }\n            else if (surface === 'wood') burst(d, t, 0.07, 0.55, 'bandpass', 700, 1.4);\n            else burst(d, t, 0.06, 0.6, 'bandpass', 2300, 1.1);\n        },\n        groan(position = null, pitch = 1) {\n            const d = out(position, 0.4); if (!d) return; const t = ctx.currentTime, dur = 0.7 + Math.random() * 0.6;\n            const o = ctx.createOscillator(); o.type = 'sawtooth'; o.frequency.setValueAtTime(110 * pitch, t); o.frequency.linearRampToValueAtTime(80 * pitch, t + dur);\n            const lfo = ctx.createOscillator(), lg = ctx.createGain(); lfo.frequency.value = 6 + Math.random() * 3; lg.gain.value = 9; lfo.connect(lg).connect(o.frequency);\n            const f = ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 650; f.Q.value = 3;\n            const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.45, t + 0.12); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n            o.connect(f).connect(g).connect(d); o.start(t); lfo.start(t); o.stop(t + dur + 0.05); lfo.stop(t + dur + 0.05);\n        },\n        update() {},\n        dispose() { dead = true; ctx?.close?.(); ctx = null; },\n    };\n}"}