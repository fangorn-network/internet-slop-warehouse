{"js":"// CC0-1.0. Who fights whom: a hostility table, nearest-visible-enemy targeting and conversion on death\n// (e.g. people killed by zombies rise as zombies). Engine-independent: actors are { faction, position, dead }.\n\nexport const DEFAULT_HOSTILITY = {\n    player: ['zombie', 'scav', 'faction'],\n    zombie: ['player', 'scav', 'faction'],\n    scav: ['player', 'zombie'],\n    faction: ['player', 'zombie'],\n};\n\nexport function attach(world, {\n    hostility = DEFAULT_HOSTILITY,\n    actors = () => [],\n    canSee = () => true,\n    range = 40,\n    // Return the faction the victim turns into, or null. Default: killed by a zombie -> zombie.\n    convert = (victim, killer) => (killer?.faction === 'zombie' && victim.faction !== 'zombie' && victim.faction !== 'player' ? 'zombie' : null),\n    onConvert = () => {},\n} = {}) {\n    let dead = false;\n    const sets = Object.fromEntries(Object.entries(hostility).map(([f, list]) => [f, new Set(list)]));\n    const hostile = (a, b) => !!a && !!b && a !== b && (sets[a.faction]?.has(b.faction) || sets[b.faction]?.has(a.faction) || false);\n    const d2 = (a, b) => (a.position.x - b.position.x) ** 2 + (a.position.z - b.position.z) ** 2;\n    return {\n        hostile,\n        /** Nearest living hostile within `range` that `canSee` accepts (pass see:false to skip sight). */\n        nearestHostile(actor, { range: r = range, see = true } = {}) {\n            if (dead || !actor) return null;\n            let best = null, bestD = r * r;\n            for (const other of actors()) {\n                if (other.dead || !hostile(actor, other)) continue;\n                const d = d2(actor, other);\n                if (d < bestD && (!see || canSee(actor, other))) { best = other; bestD = d; }\n            }\n            return best;\n        },\n        /** Report a death; returns the new faction if the victim converts (and calls onConvert), else null. */\n        killed(victim, killer) {\n            if (dead || !victim) return null;\n            const next = convert(victim, killer);\n            if (next) onConvert(victim, next, killer);\n            return next;\n        },\n        update() {},\n        dispose() { dead = true; },\n    };\n}"}