{"js":"// CC0. Accessible menus, camera, input, model loading, lighting and lifecycle for small 3D expeditions.\nimport * as THREE from 'three';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nimport { clone as cloneSkeleton } from 'three/addons/utils/SkeletonUtils.js';\nimport { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';\nexport function attach(root=document.body,{title='Expedition',eyebrow='WAREHOUSE FIELD TRIP',description='',controls='WASD / arrows to move',accent='#b8e5cc',parts={},assets=[],cameraOffset=[0,12,18],touch=null,autoRender=true,build=async()=>({}),onError=console.error}={}){\n const host=document.createElement('div');host.className='expedition';host.style.setProperty('--exp-accent',accent);\n host.innerHTML=`<style>\n .expedition{position:fixed;inset:0;background:#142320;color:#f0efe0;font:13px Arial,Helvetica,sans-serif;overflow:hidden;--exp-accent:#b8e5cc;touch-action:none}.expedition *{box-sizing:border-box}.expedition canvas{display:block;width:100%;height:100%}.exp-ui{position:absolute;inset:0;pointer-events:none;padding:25px 30px;display:flex;flex-direction:column;justify-content:space-between}.exp-top,.exp-bottom{display:flex;justify-content:space-between;gap:20px;align-items:start}.exp-brand{letter-spacing:.19em;text-transform:uppercase;font-size:9px;color:#dce8d5}.exp-title{display:block;letter-spacing:-.025em;text-transform:none;font:30px/1.2 Georgia,serif;color:#fff3d5;margin-top:5px;text-shadow:0 2px 12px #0008}.exp-readout{text-align:right;background:#132420b0;border:1px solid #dce9c52b;padding:12px 15px;min-width:145px;backdrop-filter:blur(8px)}.exp-value{display:block;font:26px Georgia,serif;color:var(--exp-accent)}.exp-label{font:9px 'Courier New',monospace;text-transform:uppercase;letter-spacing:.11em;color:#c6d2c0;margin-top:5px}.exp-actions{margin-top:8px;text-align:right}.expedition button{font:11px Arial,sans-serif;color:inherit;border:1px solid #e3edcc55;background:#132420d9;padding:8px 12px;cursor:pointer;pointer-events:auto}.expedition button:hover{border-color:var(--exp-accent)}.expedition button:focus-visible{outline:2px solid var(--exp-accent);outline-offset:3px}.exp-objective{background:#132420c9;padding:13px 16px;border-left:2px solid var(--exp-accent);max-width:360px;backdrop-filter:blur(8px);line-height:1.6}.exp-objective strong{display:block;font-size:13px;font-weight:500;color:var(--exp-accent)}.exp-secondary{font-size:11px;color:#c6d2c0;margin-top:4px}.exp-controls{text-align:right;color:#dde6d2;text-shadow:0 1px 5px #000b;font:10px/1.8 'Courier New',monospace;white-space:pre-line;align-self:end}.exp-toast{position:absolute;top:145px;left:50%;transform:translateX(-50%);max-width:85%;text-align:center;color:var(--exp-accent);text-shadow:0 2px 8px #000;background:#132420b0;padding:8px 15px;font-size:12px;pointer-events:none}.exp-toast:empty{display:none}.exp-overlay{position:absolute;inset:0;z-index:20;display:grid;place-items:center;background:linear-gradient(100deg,#101e21eb,#15251d66);padding:28px}.exp-intro{max-width:600px;width:100%}.exp-intro .exp-kicker{font:10px 'Courier New',monospace;letter-spacing:.17em;text-transform:uppercase;color:var(--exp-accent)}.exp-intro h1{font:clamp(44px,7vw,82px)/.98 Georgia,serif;letter-spacing:-.04em;font-weight:400;margin:21px 0 25px;text-wrap:balance}.exp-intro p{color:#cad5c4;font-size:14px;line-height:1.8;max-width:470px}.exp-intro .exp-start{background:var(--exp-accent);color:#182923;padding:15px 26px;border:0;font-size:12px;letter-spacing:.07em;margin-top:20px;font-weight:700;min-width:190px}.exp-start:disabled{opacity:.5;cursor:wait}.exp-help{font:10px/1.8 'Courier New',monospace;color:#c4d0ba;white-space:pre-line;margin-top:24px}.exp-error{color:#ffc19c!important}.exp-note{font-size:10px!important;opacity:.8;margin-top:20px}\n @media(max-width:650px){.exp-ui{padding:16px}.exp-title{font-size:23px;max-width:210px}.exp-readout{padding:9px 11px;min-width:105px}.exp-value{font-size:21px}.exp-brand{font-size:8px}.exp-top{gap:8px}.exp-bottom{padding-bottom:160px}.exp-objective{max-width:85%;padding:10px 12px}.exp-controls{display:none}.exp-intro h1{font-size:51px}.exp-intro p{font-size:13px}.exp-toast{top:135px;font-size:11px;width:max-content}.expedition button{min-height:38px}}\n </style><div class=\"exp-ui\"><div class=\"exp-top\"><div class=\"exp-brand\"><span class=\"exp-eyebrow\"></span><strong class=\"exp-title\"></strong></div><div><div class=\"exp-readout\"><span class=\"exp-value\">—</span><div class=\"exp-label\">Preparing world</div></div><div class=\"exp-actions\"><button class=\"exp-pause\">Pause</button> <button class=\"exp-reset\">Restart</button></div></div></div><div class=\"exp-bottom\"><div class=\"exp-objective\"><strong></strong><div class=\"exp-secondary\"></div></div><div class=\"exp-controls\"></div></div></div><div class=\"exp-toast\" role=\"status\" aria-live=\"polite\"></div><div class=\"exp-overlay\"><div class=\"exp-intro\"><div class=\"exp-kicker\"></div><h1></h1><p class=\"exp-description\"></p><button class=\"exp-start\" disabled>Preparing world…</button><div class=\"exp-help\"></div><p class=\"exp-error\" role=\"alert\"></p><p class=\"exp-note\">A CC0 world from the internet slop warehouse. Built to play, built to pull apart.</p></div></div>`;\n root.append(host);const $=s=>host.querySelector(s);\n $('.exp-eyebrow').textContent=eyebrow;$('.exp-kicker').textContent=eyebrow;$('.exp-title').textContent=title;$('.exp-intro h1').textContent=title;$('.exp-description').textContent=description;$('.exp-controls').textContent=controls;$('.exp-help').textContent=controls;\n const keys=new Set(),pressed=new Set(),modelCache=new Map(),loader=new GLTFLoader(),listeners=[];\n let renderer,scene,camera,env,session={},mode='loading',dead=false,elapsed=0,toast=0,zoom=1,pmrem,audio=null,camTarget=null,touchHandle=null;\n const add=(target,type,fn,opts)=>{target.addEventListener(type,fn,opts);listeners.push(()=>target.removeEventListener(type,fn,opts));};\n function message(text){$('.exp-toast').textContent=text;toast=4;}\n function hud({value,label,objective,secondary}={}){if(value!==undefined)$('.exp-value').textContent=value;if(label!==undefined)$('.exp-label').textContent=label;if(objective!==undefined)$('.exp-objective strong').textContent=objective;if(secondary!==undefined)$('.exp-secondary').textContent=secondary;}\n function tone(frequency=440,duration=.14,type='sine',volume=.04){if(!audio)return;try{const o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.setValueAtTime(frequency,audio.currentTime);o.frequency.exponentialRampToValueAtTime(Math.max(40,frequency*.7),audio.currentTime+duration);g.gain.setValueAtTime(volume,audio.currentTime);g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+duration);o.connect(g).connect(audio.destination);o.start();o.stop(audio.currentTime+duration);}catch{}}\n function finish(text,won=true){if(mode!=='playing')return;mode=won?'won':'lost';keys.clear();pressed.clear();$('.exp-description').textContent=text;$('.exp-start').textContent=won?'Go again →':'Try again →';$('.exp-overlay').style.display='grid';tone(won?660:90,.8);}\n function pause(){if(mode!=='playing')return;mode='paused';keys.clear();pressed.clear();$('.exp-description').textContent='Take your time. The world will wait.';$('.exp-start').textContent='Resume →';$('.exp-overlay').style.display='grid';}\n function start(){if(dead||mode==='loading'||mode==='error')return;try{audio??=new(window.AudioContext||window.webkitAudioContext)();audio.resume();}catch{}if(mode!=='paused'){keys.clear();pressed.clear();elapsed=0;session.reset?.();}mode='playing';$('.exp-overlay').style.display='none';$('.exp-toast').textContent='';}\n $('.exp-start').onclick=start;$('.exp-pause').onclick=pause;$('.exp-reset').onclick=()=>{if(mode==='loading'||mode==='error')return;mode='ready';start();};\n const context={parts,host,THREE,keys,get elapsed(){return elapsed;},get playing(){return mode==='playing';},\n  input(){let x=Number(keys.has('KeyD')||keys.has('ArrowRight'))-Number(keys.has('KeyA')||keys.has('ArrowLeft')),z=Number(keys.has('KeyS')||keys.has('ArrowDown'))-Number(keys.has('KeyW')||keys.has('ArrowUp'));return{x,z,boost:keys.has('ShiftLeft')||keys.has('ShiftRight')};},\n  consume(code){const has=pressed.has(code);pressed.delete(code);return has;},message,hud,tone,finish,\n  follow(target){camTarget=target;},\n  async model(id,height=1,fit='height'){if(!parts[id])throw Error(`Missing asset ${id}`);if(!modelCache.has(id))modelCache.set(id,loader.loadAsync(parts[id]));const gltf=await modelCache.get(id),model=cloneSkeleton(gltf.scene),wrapper=new THREE.Group();wrapper.add(model);model.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true;}});const b=new THREE.Box3().setFromObject(model),size=b.getSize(new THREE.Vector3()),center=b.getCenter(new THREE.Vector3());const factor=height/Math.max(.001,fit==='max'?Math.max(size.x,size.y,size.z):size.y);model.position.sub(new THREE.Vector3(center.x,b.min.y,center.z));wrapper.scale.setScalar(factor);return wrapper;},\n };\n add(window,'keydown',e=>{if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();if(e.code==='Escape'&&!e.repeat){mode==='paused'?start():pause();return;}if(!keys.has(e.code)&&!e.repeat)pressed.add(e.code);keys.add(e.code);});\n add(window,'keyup',e=>keys.delete(e.code));add(window,'blur',()=>{keys.clear();pressed.clear();pause();});add(document,'visibilitychange',()=>{if(document.hidden)pause();});\n add(host,'wheel',e=>{zoom=Math.max(.65,Math.min(1.6,zoom+e.deltaY*.0006));e.preventDefault();},{passive:false});\n const resize=()=>{if(!renderer)return;const w=host.clientWidth,h=host.clientHeight;renderer.setPixelRatio(Math.min(devicePixelRatio||1,1.6));renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();};add(window,'resize',resize);\n const ready=(async()=>{\n  try{\n   renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=.9;renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;host.prepend(renderer.domElement);\n   scene=new THREE.Scene();camera=new THREE.PerspectiveCamera(52,1,.1,250);context.scene=scene;context.camera=camera;context.renderer=renderer;\n   pmrem=new THREE.PMREMGenerator(renderer);const room=new RoomEnvironment();env=pmrem.fromScene(room,.04).texture;room.dispose();pmrem.dispose();scene.environment=env;scene.environmentIntensity=.8;\n   resize();await Promise.all(assets.map(id=>{if(!parts[id])throw Error(`Missing asset ${id}`);const p=loader.loadAsync(parts[id]);modelCache.set(id,p);return p;}));\n   session=await build(context);if(dead){session.dispose?.();return;}\n   session.reset?.();\n   if(camTarget){camera.position.copy(camTarget.position).add(new THREE.Vector3(...cameraOffset));camera.lookAt(camTarget.position);}\n   touchHandle=touch?.attach(host,{size:80,buttons:[{label:'USE',code:'KeyE'},{label:'BOOST',code:'ShiftLeft'}]});\n   mode='ready';$('.exp-start').disabled=false;$('.exp-start').textContent='Enter the world →';\n  }catch(error){mode='error';$('.exp-error').textContent='This world could not load. Check the connection, then reload the game.';onError(error);}\n })();\n let last=performance.now();\n function update(dt){if(dead||!renderer||!scene)return;dt=Math.min(.15,Math.max(0,Number.isFinite(dt)?dt:0));session.ambient?.(dt);if(mode==='playing'){let remaining=dt;while(remaining>1e-8&&mode==='playing'){const step=Math.min(.05,remaining);elapsed+=step;session.update?.(step);remaining-=step;}}if(toast>0){toast-=dt;if(toast<=0)$('.exp-toast').textContent='';}\n  if(camTarget){const desired=camTarget.position.clone().add(new THREE.Vector3(...cameraOffset).multiplyScalar(zoom));camera.position.lerp(desired,1-Math.exp(-5*dt));camera.lookAt(camTarget.position.clone().add(new THREE.Vector3(0,.7,0)));}renderer.render(scene,camera);\n }\n if(autoRender)renderer?.setAnimationLoop(()=>{const now=performance.now();update((now-last)/1000);last=now;});\n // Initialization reaches renderer before its first await; render throughout async model preparation.\n const diagnostic={get snapshot(){return{mode,elapsed,...session.snapshot?.()};}};\n window.worldDebug=diagnostic;\n return{ready,update,get scene(){return scene;},get camera(){return camera;},dispose(){if(dead)return;dead=true;listeners.forEach(fn=>fn());session.dispose?.();touchHandle?.dispose();audio?.close().catch(()=>{});renderer?.setAnimationLoop(null);env?.dispose();renderer?.dispose();modelCache.forEach(p=>p.then(g=>g.scene.traverse(o=>{o.geometry?.dispose();const mats=Array.isArray(o.material)?o.material:[o.material];for(const m of mats)if(m){for(const v of Object.values(m))if(v?.isTexture)v.dispose();m.dispose();}})).catch(()=>{}));host.remove();if(window.worldDebug===diagnostic)delete window.worldDebug;}};\n}\n"}