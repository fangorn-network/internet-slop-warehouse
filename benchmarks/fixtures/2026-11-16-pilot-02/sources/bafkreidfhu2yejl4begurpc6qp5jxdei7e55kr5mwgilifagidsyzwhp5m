{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Feed the cat</title>\n<meta name=\"description\" content=\"Night in the moss garden. A concrete cat sits in the clearing and it is hungry. Bring it apples. It grows. It watches you.\">\n<style>\n  html,body{margin:0;touch-action:none;-webkit-user-select:none;user-select:none;height:100%;overflow:hidden;background:#05060c;font:14px system-ui,sans-serif}\n  #hud{position:fixed;top:10px;left:12px;color:#ffe9b0;text-shadow:0 1px 3px #000;font-weight:600;pointer-events:none}\n  #msg{position:fixed;inset:0;display:grid;place-items:center;color:#ffe9b0;text-shadow:0 2px 6px #000;font-size:22px;text-align:center;cursor:pointer;background:#0008}\n  #msg small{display:block;font-size:14px;opacity:.85;margin-top:8px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script>\n</head><body>\n<div id=\"hud\"></div><div id=\"msg\">loading…</div>\n<script type=\"module\">\nimport * as THREE from \"three\";\nimport { GLTFLoader } from \"three/addons/loaders/GLTFLoader.js\";\nimport * as SkeletonUtils from \"three/addons/utils/SkeletonUtils.js\";\n\n// A remix of the moss garden: same ground, trees, barrels and lanterns, at night, with a cat.\nconst PARTS = {\"robot\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiezecuxadyslgydj7gwc3ihmujswsynwykrj4yjbofc4eggugam2y\",\"cat-statue\":\"https://ipfs-test.fangorn.network/ipfs/bafybeig44rx6x7ie2iv5k2hjkdysq5bujf6s4ac5umdfeyfcwza2dwk5pq\",\"barrel\":\"https://ipfs-test.fangorn.network/ipfs/bafybeigpbqf3fnybpgtnuqjsyp2khyslehbngb6huq3gjpa4cklq7jc4ra\",\"lantern\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiebl5stslnp5wmc4ysvkbdzw2ucetszwy63m563mgx3vlsclwuhzu\",\"apple\":\"https://ipfs-test.fangorn.network/ipfs/bafybeibhskuycs7yyxlmxwx5yfgnohrf4xrgzdgt5u32w545tvyy7a2nx4\",\"forest-ground-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafybeidjlqgtwmhoy4hjkskxgreaug2x2kg6f6vmwtt3powbhemzzw33ua\",\"night-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafybeidn23supl34jiik45vleaoxzh5vzfzbv5f7zmyt3xfvq4ip2t26se\",\"coin-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6lmgvb7xur2rnodcgqbebxr4z4zypv7j2m5egibysabahllmxf4\",\"jump-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreickrhtm4jnxehlxtq2qlowctwixqt3xth7yi7vlwaxv63nvjlnf54\",\"platformer-controller\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihbjdl3wwjfiiu7qne4a5qnskfj4lrieutjlv64yhqd25kbth7m74\",\"follow-camera\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiauise4tsy3llffneifcfwo25whtfrccjdjynf2bqj4jj5kypypha\",\"clip-animator\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiahogjc53z7qaa7x4j7nnus5rxahr6ojuaxb2m7oukkb3fxc3zj2y\",\"low-poly-trees\":\"https://ipfs-test.fangorn.network/ipfs/bafkreig5j3257727ytjzyvtfbd7rirnnpyeh7zwv4sci5w463uhjgft7ky\",\"hdri-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafkreif4o56shppr6t5ttbczmnyjhm5bgaklfsujajbd7y7mjznvtkv2ce\",\"spawner\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiagesa7q5b7qmfy6v3uuk4ulpxghs3tja6a2zc5vsqxl55g6l7rda\",\"wobble\":\"https://ipfs-test.fangorn.network/ipfs/bafkreid7piflgn7mohnohbswhqpp3d2udg4cwmy5n4vz6p4pa5ukydarry\",\"boids\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihc4k4ck3cvcpnnknakoowm6xfp2vseku7ulserahpynjy3woywkm\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\"};\nconst logic = async (id) => import(\"data:text/javascript;charset=utf-8,\" + encodeURIComponent((await (await fetch(PARTS[id])).json()).js));\nlogic(\"touch-controls\").then((t) => t.attach()); // a joystick and jump button on phones\nconst glb = (id) => new GLTFLoader().loadAsync(PARTS[id]);\n\nconst [controller, followCam, animator, trees, sky, spawner, wobble, boids, robotG, catG, barrelG, lanternG, appleG, groundTex] = await Promise.all([\n    logic(\"platformer-controller\"), logic(\"follow-camera\"), logic(\"clip-animator\"), logic(\"low-poly-trees\"), logic(\"hdri-sky\"),\n    logic(\"spawner\"), logic(\"wobble\"), logic(\"boids\"),\n    glb(\"robot\"), glb(\"cat-statue\"), glb(\"barrel\"), glb(\"lantern\"), glb(\"apple\"),\n    new THREE.TextureLoader().loadAsync(PARTS[\"forest-ground-texture\"]),\n]);\nconst audio = new AudioContext();\nconst sounds = Object.fromEntries(await Promise.all([\"coin-sound\", \"jump-sound\"].map(async (id) => [id, await audio.decodeAudioData(await (await fetch(PARTS[id])).arrayBuffer())])));\nconst play = (id, rate = 1) => { const s = audio.createBufferSource(); s.buffer = sounds[id]; s.playbackRate.value = rate; s.connect(audio.destination); s.start(); };\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.shadowMap.enabled = true; renderer.toneMapping = THREE.ACESFilmicToneMapping;\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(55, 1, 0.1, 300);\nscene.fog = new THREE.FogExp2(0x05060c, 0.035);\nconst moon = new THREE.DirectionalLight(0x8899ff, 0.6); moon.position.set(-10, 20, 5); moon.castShadow = true;\nObject.assign(moon.shadow.camera, { left: -30, right: 30, top: 30, bottom: -30 }); scene.add(moon);\nconst skyH = sky.attach(scene, { url: PARTS[\"night-sky\"], intensity: 0.5 });\nconst world = [skyH];\n\nconst R = 30, solids = [];\ngroundTex.wrapS = groundTex.wrapT = THREE.RepeatWrapping; groundTex.repeat.set(20, 20); groundTex.colorSpace = THREE.SRGBColorSpace;\nconst ground = new THREE.Mesh(new THREE.BoxGeometry(2 * R, 2, 2 * R), new THREE.MeshStandardMaterial({ map: groundTex, roughness: 1 }));\nground.position.y = -1; ground.receiveShadow = true; scene.add(ground); solids.push(ground);\nconst place = (src, [x, y, z], s = 1, ry = 0) => {\n    const m = src.clone(); m.position.set(x, y, z); m.scale.setScalar(s); m.rotation.y = ry;\n    m.traverse((o) => { if (o.isMesh) o.castShadow = o.receiveShadow = true; }); scene.add(m); return m;\n};\nfor (const [x, z] of [[8, 8], [-8, 8], [8, -8], [-8, -8], [0, 12], [12, 0], [-12, 0], [0, -12]]) {\n    solids.push(place(barrelG.scene, [x, 0, z], 1.4, x));\n    place(lanternG.scene, [x, 1.23, z], 2);\n    const l = new THREE.PointLight(0xffaa55, 8, 9); l.position.set(x, 1.6, z); scene.add(l);\n}\nworld.push(trees.attach(scene, { count: 90, area: [2 * R - 4, 2 * R - 4], clear: 15, seed: 11 }));\n\n// The cat: concrete, in the clearing, lit from below like a campfire story.\nconst cat = place(catG.scene, [0, 0, 0], 10);\nconst catLight = new THREE.PointLight(0xff7744, 20, 14); catLight.position.set(0, 0.5, 2.5); scene.add(catLight);\nconst catWob = wobble.attach(cat, { amount: 0.25, damping: 5 });\nworld.push(catWob);\n\n// Fireflies: a flock of tiny glowing dots that drifts after you.\nconst flies = Array.from({ length: 40 }, () => {\n    const f = new THREE.Mesh(new THREE.SphereGeometry(0.05, 6, 4), new THREE.MeshBasicMaterial({ color: 0xccff66 }));\n    f.position.set((Math.random() - 0.5) * 20, 1 + Math.random() * 2, (Math.random() - 0.5) * 20); scene.add(f); return f;\n});\nconst player = SkeletonUtils.clone(robotG.scene); player.scale.setScalar(0.35);\nplayer.traverse((o) => { if (o.isMesh) o.castShadow = true; }); scene.add(player);\nconst fireflies = boids.attach(flies, { target: player, speed: 2, seek: 0.25, sight: 1.5, bounds: 20,\n    steer: (f) => new THREE.Vector3(0, (1.6 - f.position.y) * 0.8, 0) }); // hover at head height\nworld.push(fireflies);\n\nconst GOAL = 15, CARRY = 3;\nlet over = true, start = 0, fed = 0, carried = [];\nconst systems = [];\nlet apples;\nfunction begin() {\n    for (const s of systems.splice(0)) s.dispose();\n    for (const a of carried) a.removeFromParent();\n    carried = []; fed = 0; catWob.resize(10);\n    player.position.set(0, 0, 6);\n    const ctl = controller.attach(player, { solids, camera, onJump: () => play(\"jump-sound\") });\n    apples = spawner.attach(scene, { every: 1.5, max: 8, area: [2 * R - 8, 2 * R - 8], y: 0.6, first: 1.5,\n        where: () => { let p; do p = new THREE.Vector3((Math.random() - 0.5) * (2 * R - 8), 0.6, (Math.random() - 0.5) * (2 * R - 8)); while (p.length() < 6); return p; },\n        make: () => { const a = appleG.scene.clone(); a.scale.setScalar(5); return a; } });\n    systems.push(ctl, apples, animator.attach(player, { animations: robotG.animations, state: () => ctl.state }), followCam.attach(camera, { target: player, offset: [0, 5, 9] }));\n    over = false; start = performance.now(); $msg.style.display = \"none\";\n}\nconst $msg = document.getElementById(\"msg\"), $hud = document.getElementById(\"hud\");\n$msg.innerHTML = `Feed the cat<small>WASD / arrows · Shift to run · Space to jump<br>apples appear in the dark; carry up to ${CARRY} at a time to the cat<br>it needs ${GOAL}<br><br>click to start</small>`;\n$msg.onclick = () => { audio.resume(); begin(); };\n\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\ncamera.position.set(0, 5, 15); camera.lookAt(0, 1, 0);\nconst clock = new THREE.Clock();\nrenderer.setAnimationLoop(() => {\n    const dt = clock.getDelta(), t = clock.elapsedTime;\n    for (const w of world) w.update(dt);\n    cat.rotation.y = Math.atan2(player.position.x, player.position.z); // it watches you\n    catLight.intensity = 18 + Math.sin(t * 9) * 3 + Math.sin(t * 23) * 2;\n    if (!over) {\n        for (const s of systems) s.update(dt);\n        // Pick up apples you walk into; they bob over your head.\n        for (const a of apples.alive) if (carried.length < CARRY && a.position.distanceTo(player.position) < 1.2) {\n            apples.alive.delete(a); carried.push(a); play(\"coin-sound\", 1.5);\n        }\n        carried.forEach((a, i) => a.position.set(player.position.x + Math.sin(t * 3 + i * 2) * 0.5, player.position.y + 2 + i * 0.35, player.position.z + Math.cos(t * 3 + i * 2) * 0.5));\n        // Feed it: each apple makes it bigger.\n        const catR = 1.5 + cat.scale.x * 0.12;\n        if (carried.length && Math.hypot(player.position.x, player.position.z) < catR + 0.6) {\n            for (const a of carried) { a.removeFromParent(); fed++; }\n            play(\"coin-sound\", 0.5 + fed * 0.03); carried = [];\n            catWob.resize(10 + fed * 1.4); catWob.poke(1.5);\n            if (fed >= GOAL) {\n                over = true; skyH.update(0);\n                $msg.innerHTML = `The cat has eaten ${fed} apples in ${((performance.now() - start) / 1000).toFixed(0)}s.<small>it is satisfied, for now · click to feed it again</small>`; $msg.style.display = \"\";\n            }\n        }\n        $hud.textContent = `fed ${fed}/${GOAL} · carrying ${carried.length}/${CARRY}`;\n    }\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}