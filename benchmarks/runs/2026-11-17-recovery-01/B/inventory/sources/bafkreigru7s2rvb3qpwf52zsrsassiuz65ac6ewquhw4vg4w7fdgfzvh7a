{"js":"// SPDX-License-Identifier: CC0-1.0\n// Renderer-free exploration and shared camp construction over real mapped streets.\nconst clone=x=>JSON.parse(JSON.stringify(x)),distance=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z);\nexport const blueprints={shelter:{title:'Open shelter',cost:{wood:8,cloth:2},radius:2.6,solid:false},wall:{title:'Timber wall',cost:{wood:3},radius:1.55,solid:true},workbench:{title:'Workbench',cost:{wood:6,stone:2},radius:1.1,solid:true},hearth:{title:'Hearth · rest & return',cost:{wood:2,stone:4},radius:.85,solid:false},stash:{title:'Supply chest',cost:{wood:4},radius:.8,solid:true},lantern:{title:'Camp lantern',cost:{wood:1,cloth:1},radius:.35,solid:false},bedroll:{title:'Bedroll',cost:{cloth:3},radius:1,solid:false},planter:{title:'Planter',cost:{wood:3,stone:1},radius:.9,solid:true}};\nexport function attach(district,{modules,onEvent=()=>{},canBuild=()=>true,maxStructures=64}={}){const osm=modules['osm-district'],roads=district.roads.filter(r=>!r.labelOnly&&r.kind!=='water'),walkRoads=roads.filter(r=>!['motorway','trunk','motorway_link'].includes(r.kind));let state,bag,dead=false;\n const onWater=p=>district.water.some(w=>osm.inside(p,w.points)&&!w.holes.some(h=>osm.inside(p,h))),inBuilding=p=>district.buildings.some(b=>b.minHeight<2&&osm.inside(p,b.points)&&!b.holes.some(h=>osm.inside(p,h)));\n function groundClear(p,r=.3){if(Math.abs(p.x)+r>district.radius-8||Math.abs(p.z)+r>district.radius-8)return false;for(const dx of[-r,0,r])for(const dz of[-r,0,r])if(onWater({x:p.x+dx,z:p.z+dz})||inBuilding({x:p.x+dx,z:p.z+dz}))return false;return true;}\n function offStreet(p,r){return !roads.some(road=>osm.nearestRoad(p,[road]).distance<road.width/2+r+1);}\n function clearPlot(p,r){return groundClear(p,r)&&offStreet(p,r);}\n function findPlot(){for(let radius=15;radius<=180;radius+=8)for(let i=0;i<20;i++){const a=i*Math.PI/10,p={x:Math.round((district.spawn.x+Math.cos(a)*radius)/3)*3,z:Math.round((district.spawn.z+Math.sin(a)*radius)/3)*3};if(clearPlot(p,4.5))return p;}return null;}\n const plot=findPlot();\n const points=[];const candidates=[...district.pois,...district.buildings.filter(b=>b.kind!=='building')].filter(p=>Math.abs(p.x)<district.radius*.87&&Math.abs(p.z)<district.radius*.87).sort((a,b)=>distance(a,district.spawn)-distance(b,district.spawn));\n for(const p of candidates){if(points.length>=14)break;const road=osm.nearestRoad(p,walkRoads);if(road.distance>80||!groundClear(road)||points.some(t=>distance(t,road)<48))continue;const kind=p.kind||'building',yieldMap={shop:{wood:3,cloth:2},commercial:{wood:2,cloth:2},industrial:{wood:4,stone:3},hospital:{cloth:3,stone:1},home:{wood:4,cloth:1},civic:{stone:3,cloth:1},school:{wood:3,cloth:2}};points.push({id:p.id,x:road.x,z:road.z,name:p.name||({home:'Residential lane',shop:'Neighborhood shop',industrial:'Workshop district'})[kind]||'Street corner',kind,yield:yieldMap[kind]??{wood:3,stone:2}});}\n for(const r of walkRoads){if(points.length>=8)break;const p=r.points[Math.floor(r.points.length/2)];if(!groundClear(p)||distance(p,district.spawn)>district.radius*.8||points.some(t=>distance(t,p)<60))continue;points.push({id:'trail-'+r.id,x:p.x,z:p.z,name:r.name||'Neighborhood trail',kind:'trail',yield:{wood:3,stone:2}});}\n function init(){return{version:1,district:district.fingerprint,age:0,supplies:{wood:14,stone:8,cloth:4},structures:[],visited:[],gathered:{},xp:0,sequence:0};}\n function inventory(s){bag?.dispose();bag=modules['resource-inventory'].attach(null,{capacity:5000,initial:s.supplies});}\n state=init();inventory(state);\n const output=(ok,text)=>({ok,text});const emit=text=>onEvent({type:'camp',text});\n function placement(player,kind,rotation=0){const spec=blueprints[kind];if(!player||!spec)return{ok:false,reason:'Choose a blueprint.'};const yaw=Number.isFinite(player.yaw)?player.yaw:0,q=Number.isFinite(rotation)?Math.round(rotation)%4:0,p={x:Math.round((player.x-Math.sin(yaw)*5)/3)*3,z:Math.round((player.z-Math.cos(yaw)*5)/3)*3,rotation:q*Math.PI/2,kind};if(!clearPlot(p,spec.radius))return{...p,ok:false,reason:'Choose dry open space clear of mapped buildings and streets.'};if(state.structures.some(s=>distance(p,s)<spec.radius+blueprints[s.kind].radius+.15))return{...p,ok:false,reason:'Leave space between structures.'};if(!canBuild(p,spec))return{...p,ok:false,reason:'Building is unavailable here.'};return{...p,ok:true};}\n function nearest(player){if(!player)return null;return points.filter(p=>distance(p,player)<12).sort((a,b)=>distance(a,player)-distance(b,player))[0]??null;}\n function build(player,kind,rotation=0,players=[]){if(dead)return output(false,'Session ended.');const spec=blueprints[kind],p=placement(player,kind,rotation);if(!p.ok)return output(false,p.reason);if(state.structures.length>=maxStructures)return output(false,'Camp structure limit reached.');if(spec.solid&&players.some(other=>distance(p,other)<spec.radius+.6))return output(false,'Someone is standing in this space.');if(!bag.transact(Object.fromEntries(Object.entries(spec.cost).map(([k,n])=>[k,-n]))))return output(false,'Need '+Object.entries(spec.cost).map(([k,n])=>n+' '+k).join(', '));state.structures.push({id:'camp-'+(++state.sequence),kind,x:p.x,z:p.z,rotation:p.rotation});state.xp+=5;emit('Built '+spec.title);return output(true,'Built '+spec.title+'.');}\n function interact(player){if(dead)return output(false,'Session ended.');const p=nearest(player);if(!p)return output(false,'Follow a supply marker or explore a named place.');if(state.age<(state.gathered[p.id]??-Infinity)+90)return output(false,'Supplies here replenish in '+Math.ceil(state.gathered[p.id]+90-state.age)+'s.');if(!bag.transact(p.yield))return output(false,'Shared supplies are full.');state.gathered[p.id]=state.age;return output(true,'Collected '+Object.entries(p.yield).map(([k,n])=>n+' '+k).join(', ')+'.');}\n function update(dt,players={}){if(dead||!Number.isFinite(dt)||dt<=0)return;state.age+=Math.min(dt,.1);for(const p of Object.values(players)){const point=nearest(p);if(point&&!state.visited.includes(point.id)){state.visited.push(point.id);state.xp+=20;emit('Discovered '+point.name+' · +20 exploration XP');}}}\n function milestones(){const s=state.structures;return[{title:'Discover three places',done:state.visited.length>=3},{title:'Build an open shelter',done:s.some(b=>b.kind==='shelter')},{title:'Establish a hearth',done:s.some(b=>b.kind==='hearth')},{title:'Build a workbench',done:s.some(b=>b.kind==='workbench')},{title:'Make camp comfortable',done:s.some(b=>b.kind==='bedroll')&&s.some(b=>b.kind==='lantern')}];}\n function validateSnapshot(s,{ignoreDistrict=false}={}){try{const keys=['wood','stone','cloth'];return s?.version===1&&(ignoreDistrict||s.district===district.fingerprint)&&Number.isFinite(s.age)&&s.age>=0&&s.age<=1000000&&Number.isSafeInteger(s.xp)&&s.xp>=0&&Number.isSafeInteger(s.sequence)&&s.sequence>=0&&s.sequence<=1000000&&s.supplies&&Object.keys(s.supplies).every(k=>keys.includes(k))&&Object.values(s.supplies).every(n=>Number.isSafeInteger(n)&&n>=0&&n<=5000)&&Object.values(s.supplies).reduce((a,b)=>a+b,0)<=5000&&Array.isArray(s.visited)&&s.visited.length<=32&&new Set(s.visited).size===s.visited.length&&s.visited.every(id=>typeof id==='string'&&id.length<200&&(ignoreDistrict||points.some(p=>p.id===id)))&&s.gathered&&Object.keys(s.gathered).length<=32&&Object.entries(s.gathered).every(([id,n])=>typeof id==='string'&&id.length<200&&Number.isFinite(n)&&n>=0&&n<=s.age)&&Array.isArray(s.structures)&&s.structures.length<=maxStructures&&new Set(s.structures.map(b=>b.id)).size===s.structures.length&&s.structures.every(b=>typeof b.id==='string'&&b.id.length<100&&Object.hasOwn(blueprints,b.kind)&&[b.x,b.z,b.rotation].every(Number.isFinite)&&Math.abs(b.x)<=district.radius&&Math.abs(b.z)<=district.radius&&(!ignoreDistrict?clearPlot(b,blueprints[b.kind].radius):true));}catch{return false;}}\n return{plot,points:clone(points),blueprints:clone(blueprints),get state(){return{...clone(state),supplies:bag.items,rank:1+Math.floor(state.xp/80),milestones:milestones()};},placement,nearest,build,interact,update,blocked(p){return state.structures.some(b=>{if(!blueprints[b.kind].solid)return false;const dx=p.x-b.x,dz=p.z-b.z;if(b.kind==='wall'){const x=Math.cos(b.rotation)*dx-Math.sin(b.rotation)*dz,z=Math.sin(b.rotation)*dx+Math.cos(b.rotation)*dz;return Math.abs(x)<1.7&&Math.abs(z)<.4;}return distance(p,b)<blueprints[b.kind].radius+.25;});},reclaim(player,id){const s=state.structures.find(b=>b.id===id);if(!s||distance(s,player)>9)return output(false,'Stand close to your camp structure.');if(!bag.transact(blueprints[s.kind].cost))return output(false,'Shared supplies are full.');state.structures=state.structures.filter(b=>b.id!==id);return output(true,'Reclaimed all materials.');},milestones,snapshot(){return{...clone(state),supplies:bag.items};},validateSnapshot,load(s){if(!validateSnapshot(s))throw Error('Invalid camp snapshot');state=clone(s);inventory(state);},dispose(){dead=true;bag.dispose();}};\n}\n"}