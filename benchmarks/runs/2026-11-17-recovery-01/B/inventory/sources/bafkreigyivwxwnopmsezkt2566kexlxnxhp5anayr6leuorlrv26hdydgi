{"js":"// SPDX-License-Identifier: CC0-1.0\n// Host-authoritative 3D ray combat, personal crafting bags and a contested relay.\nconst clone=x=>JSON.parse(JSON.stringify(x)),TAU=Math.PI*2;\nexport function sanitizeInput(i={}){const finite=n=>Number.isFinite(n)?n:0;return{x:Math.max(-1,Math.min(1,finite(i.x))),z:Math.max(-1,Math.min(1,finite(i.z))),yaw:Math.atan2(Math.sin(finite(i.yaw)),Math.cos(finite(i.yaw))),pitch:Math.max(-1.2,Math.min(1.2,finite(i.pitch))),run:i.run===true,fire:i.fire===true};}\nexport function attach(initialDistrict,{modules,practice=true,onEvent=()=>{},targetScore=15}={}){\n let district=clone(initialDistrict),state,dead=false;const bags=new Map(),hp=new Map(),abilities=new Map();\n const inside=modules['osm-district'].inside,dist=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z),emit=(type,text)=>onEvent({type,text});\n const recipes={cells:{title:'24 pulse cells',cost:{scrap:2},gain:{cells:24}},armor:{title:'40-point armor',cost:{scrap:3}},heal:{title:'Field repair',cost:{scrap:3}},cover:{title:'Deploy cover',cost:{scrap:4}}};\n function blocked(x,z,cover=true){return Math.abs(x)>district.radius-2||Math.abs(z)>district.radius-2||district.buildings.some(b=>b.minHeight<2&&inside({x,z},b.points)&&!b.holes.some(h=>inside({x,z},h)))||district.water.some(w=>inside({x,z},w.points)&&!w.holes.some(h=>inside({x,z},h)))&&!district.roads.some(r=>r.bridge&&modules['osm-district'].nearestRoad({x,z},[r]).distance<r.width/2+1)||cover&&state?.covers.some(c=>Math.abs(x-c.x)<1.8&&Math.abs(z-c.z)<.65);}\n function spawn(index=0){const centre=district.spawn;for(let k=0;k<20;k++){const angle=index*2.4+k*.5,p={x:centre.x+Math.sin(angle)*(18+index*7),z:centre.z+Math.cos(angle)*(18+index*7)};const road=modules['osm-district'].nearestRoad(p,district.roads.filter(r=>r.kind!=='water'&&!r.labelOnly));if(!blocked(road.x,road.z,false))return{x:road.x,z:road.z};}return{...centre};}\n function player(index=0){return{...spawn(index),heading:0,yaw:0,pitch:0,hp:100,armor:0,cooldown:0,shield:3,score:0,kills:0,deaths:0,light:false,charge:100,inventory:{scrap:6,cells:32}};}\n function hydrate(s){bags.forEach(b=>b.dispose());hp.forEach(h=>h.dispose());abilities.forEach(a=>a.dispose());bags.clear();hp.clear();abilities.clear();state=clone(s);for(const[id,p]of Object.entries(state.players)){const bag=modules['resource-inventory'].attach(p,{capacity:999,initial:p.inventory});bags.set(id,bag);hp.set(id,modules.health.attach(p,{initial:p.hp,invulnerability:0}));abilities.set(id,modules['ability-clock'].attach(p,{inventory:bag,abilities:{fire:{cooldown:.25,cost:{cells:1}}},initial:{fire:p.cooldown}}));}}\n function fresh(){state={age:0,covers:[]};const p={solo:player(0)};if(practice)p.practice=player(1);return{version:1,kind:'relay-skirmish.v1',district:district.fingerprint,age:0,players:p,covers:[],shots:[],piles:district.sites.map((s,i)=>({id:s.id,x:s.x,z:s.z,ready:0})),relay:{...district.spawn,owner:null,tick:0},winner:null,sequence:0};}\n function rayBlock(origin,dir,limit){let nearest=limit;for(const b of district.buildings){for(let i=1;i<b.points.length;i++){const a=b.points[i-1],c=b.points[i],ex=c.x-a.x,ez=c.z-a.z,det=dir.x*ez-dir.z*ex;if(Math.abs(det)<1e-7)continue;const dx=a.x-origin.x,dz=a.z-origin.z,t=(dx*ez-dz*ex)/det,u=(dx*dir.z-dz*dir.x)/det,y=1.6+dir.y*t;if(t>0&&t<nearest&&u>=0&&u<=1&&y>=b.minHeight&&y<=b.minHeight+b.height)nearest=t;}}for(const c of state.covers){const dx=c.x-origin.x,dz=c.z-origin.z,t=dx*dir.x+dz*dir.z,y=1.6+dir.y*t;if(t>0&&t<nearest&&Math.hypot(dx-dir.x*t,dz-dir.z*t)<1.8&&y<2.2)nearest=t;}return nearest;}\n function fire(id){const p=state.players[id];if(!p||p.shield>0||state.winner||!abilities.get(id).activate('fire'))return false;const cp=Math.cos(p.pitch),dir={x:-Math.sin(p.yaw)*cp,y:Math.sin(p.pitch),z:-Math.cos(p.yaw)*cp},limit=rayBlock(p,dir,160);let hit=null,distance=limit;for(const[other,t]of Object.entries(state.players)){if(other===id||t.shield>0)continue;const dx=t.x-p.x,dy=1.1-1.6,dz=t.z-p.z,projection=dx*dir.x+dy*dir.y+dz*dir.z,perp=dx*dx+dy*dy+dz*dz-projection*projection;if(projection>0&&projection<distance&&perp<.75*.75){distance=projection;hit=other;}}\n if(!hit)for(const cover of state.covers){const t=(cover.x-p.x)*dir.x+(cover.z-p.z)*dir.z;if(Math.abs(t-limit)<.2)cover.hp-=25;}state.covers=state.covers.filter(c=>c.hp>0);state.sequence++;state.shots.push({id:state.sequence,from:{x:p.x,y:1.6,z:p.z},to:{x:p.x+dir.x*distance,y:1.6+dir.y*distance,z:p.z+dir.z*distance},hit:!!hit,ttl:.16});if(hit){const target=state.players[hit],absorbed=Math.min(target.armor,25);target.armor-=absorbed;hp.get(hit).damage(25-absorbed);if(hp.get(hit).dead){p.kills++;p.score+=3;target.deaths++;Object.assign(target,spawn(Object.keys(state.players).indexOf(hit)));target.shield=3;target.armor=0;hp.get(hit).revive(100);bags.get(hit).transact({cells:Math.max(0,24-bags.get(hit).count('cells'))});bags.get(id).transact({scrap:2});emit('frag','Signal disrupted. +3 points, +2 scrap.');}}return true;}\n function validateSnapshot(s,{ignoreDistrict=false}={}){try{if(!s||s.version!==1||s.kind!=='relay-skirmish.v1'||!ignoreDistrict&&s.district!==district.fingerprint||!Number.isFinite(s.age)||s.age<0||s.age>100000||!s.players||Object.keys(s.players).length<1||Object.keys(s.players).length>4)return false;for(const[id,p]of Object.entries(s.players)){if(id.length>100||['__proto__','constructor','prototype'].includes(id)||![p.x,p.z,p.yaw,p.pitch,p.heading,p.hp,p.armor,p.cooldown,p.shield,p.score,p.kills,p.deaths].every(Number.isFinite)||Math.abs(p.x)>2000||Math.abs(p.z)>2000||p.hp<0||p.hp>100||p.armor<0||p.armor>60||p.cooldown<0||p.cooldown>.25||p.shield<0||p.shield>3||!p.inventory||Object.keys(p.inventory).some(k=>!['scrap','cells'].includes(k))||Object.values(p.inventory).some(n=>!Number.isSafeInteger(n)||n<0||n>999))return false;}return Array.isArray(s.covers)&&s.covers.length<=32&&s.covers.every(c=>[c.x,c.z,c.hp].every(Number.isFinite)&&c.hp>=0)&&Array.isArray(s.shots)&&s.shots.length<=64&&s.shots.every(b=>[b.from?