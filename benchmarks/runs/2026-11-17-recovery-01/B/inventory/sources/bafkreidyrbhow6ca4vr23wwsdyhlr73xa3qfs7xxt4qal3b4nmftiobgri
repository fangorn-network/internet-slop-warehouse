{"js":"// SPDX-License-Identifier: CC0-1.0\n// Original meter-scale, Y-up models. References inform layout only; no reference pixels used.\nimport * as T from 'three';\nconst mats=new Map();\nconst mat=c=>{if(!mats.has(c))mats.set(c,new T.MeshStandardMaterial({color:c,roughness:.72}));return mats.get(c);};\nfunction box(g,c,x,y,z,w,h,d){const m=new T.Mesh(new T.BoxGeometry(w,h,d),mat(c));m.position.set(x,y,z);g.add(m);return m;}\nfunction ball(g,c,x,y,z,a,b=a,d=a){const m=new T.Mesh(new T.SphereGeometry(1,12,8),mat(c));m.position.set(x,y,z);m.scale.set(a,b,d);g.add(m);return m;}\nfunction cyl(g,c,x,y,z,rt,rb,h){const m=new T.Mesh(new T.CylinderGeometry(rt,rb,h,16),mat(c));m.position.set(x,y,z);g.add(m);return m;}\nfunction line(g,c,points,r=.018){const curve=new T.CatmullRomCurve3(points.map(p=>new T.Vector3(...p)));const m=new T.Mesh(new T.TubeGeometry(curve,16,r,6,false),mat(c));g.add(m);return m;}\nexport const kinds=['shelf','rack','round-rack','shirt','trousers','lamp','mug','plate','hammer','hanger','radio','book','sofa','register','extinguisher','cat','cashier','shopper','manager','car'];\nexport function makePiece(kind,variant=0){const g=new T.Group();g.name=kind;const colors=['#b67267','#7a8a65','#597b91','#d4b46c','#c4b0bb','#686a92'];const color=colors[variant%colors.length];\nif(kind==='shelf'){for(const x of [-1.2,1.2])for(const z of [-.34,.34])box(g,'#aaa9a1',x,1.05,z,.055,2.1,.055);for(const y of [.16,.7,1.24,1.78])box(g,'#dfdcd1',0,y,0,2.5,.045,.8);box(g,'#cbc8be',0,1,0,2.45,2,.035);}\nif(kind==='rack'||kind==='round-rack'){for(const x of [-1.3,1.3]){cyl(g,'#a5aca8',x,.88,0,.025,.025,1.76);box(g,'#858e8a',x,.09,0,.08,.08,.9);}const rail=cyl(g,'#c3c8c4',0,1.75,0,.025,.025,2.6);rail.rotation.z=Math.PI/2;if(kind==='round-rack'){g.clear();cyl(g,'#9ba3a0',0,.9,0,.04,.04,1.8);box(g,'#88918b',0,.05,0,1.5,.08,.1);box(g,'#88918b',0,.05,0,.1,.08,1.5);const ring=new T.Mesh(new T.TorusGeometry(1,.025,6,32),mat('#aeb7b0'));ring.rotation.x=Math.PI/2;ring.position.