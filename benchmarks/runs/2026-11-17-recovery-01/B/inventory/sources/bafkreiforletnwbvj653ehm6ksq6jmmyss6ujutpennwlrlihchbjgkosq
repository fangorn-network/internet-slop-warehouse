{"js":"// CC0-1.0. Procedural, texture-free PBR tactical gear: three body-armor tiers, three chest rigs, three backpacks,\n// a folded field map, a cash bundle, a bandage roll and a field medkit. Metres, +Y up, front +Z, origin at the wearer's chest centre\n// (an adult torso ~0.36 m wide), so it can be parented to a \"Chest\" bone or laid on the ground as loot.\nimport * as THREE from 'three';\n\nexport const KINDS = ['armor-light', 'armor-medium', 'armor-heavy', 'rig-light', 'rig-medium', 'rig-big',\n    'pack-small', 'pack-medium', 'pack-large', 'map', 'cash', 'bandage', 'medkit'];\n\nconst fabric = (color, roughness = 0.92) => new THREE.MeshStandardMaterial({ color, roughness, metalness: 0 });\n\nexport function defaultMaterials() {\n    return {\n        tan: fabric(0x8a7a58), olive: fabric(0x4a5233), black: fabric(0x222428), coyote: fabric(0x7b6849),\n        ranger: fabric(0x3d4836), khaki: fabric(0x6a6448), plate: fabric(0x2b2d2a, 0.7), webbing: fabric(0x2f2e29),\n        buckle: new THREE.MeshStandardMaterial({ color: 0x151515, roughness: 0.5, metalness: 0.2 }),\n        paper: fabric(0xd8cfae, 0.85), ink: fabric(0x7a6b4c), water: fabric(0x5c7d93), road: fabric(0xa04b3a),\n        bill: fabric(0x6f8a5a, 0.8), band: fabric(0xe6dec6, 0.8),\n        gauze: fabric(0xe9e4d8, 0.95), medred: fabric(0x8e2a22, 0.7), cross: fabric(0xf2efe6, 0.7),\n    };\n}\n\nfunction kit(mats) {\n    const g = new THREE.Group();\n    const box = (w, h, d, mat, x, y, z, rx = 0, ry = 0, rz = 0) => { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mats[mat]); m.position.set(x, y, z); m.rotation.set(rx, ry, rz); m.castShadow = m.receiveShadow = true; g.add(m); return m; };\n    const roll = (r, len, mat, x, y, z) => { const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, len, 14), mats[mat]); m.rotation.z = Math.PI / 2; m.position.set(x, y, z); m.castShadow = true; g.add(m); return m; };\n    return { g, box, roll };\n}\n\nfunction armor(tier, mats) {\n    const { g, box } = kit(mats);\n    const col = { light: 'tan', medium: 'olive', heavy: 'black' }[tier];\n    const t = tier === 'light' ? 0.03 : 0.05;\n    for (const s of [1, -1]) {\n        box(0.32, 0.36, t, col, 0, 0, s * 0.125);                                  // front/back panel or plate bag\n        box(0.07, 0.035, 0.27, col, s * 0.1, 0.2, 0);                             // shoulder straps\n    }\n    for (const s of [1, -1]) box(0.035, tier === 'light' ? 0.3 : 0.16, 0.24, tier === 'light' ? col : 'webbing', s * 0.175, tier === 'light' ? 0 : -0.08, 0); // sides / cummerbund\n    if (tier !== 'light') {\n        for (let i = 0; i < 3; i++) box(0.28, 0.012, 0.004, 'webbing', 0, -0.1 + i * 0.05, 0.152); // MOLLE rows\n        box(0.14, 0.08, 0.03, col, 0, 0.11, 0.165);                               // admin pouch\n        box(0.02, 0.02, 0.01, 'buckle', 0.05, 0.11, 0.182);\n    }\n    if (tier === 'heavy') {\n        for (const s of [1, -1]) { box(0.045, 0.2, 0.17, 'plate', s * 0.2, -0.03, 0); box(0.11, 0.04, 0.12, col, s * 0.2, 0.2, 0, 0, 0, s * -0.5); }\n        box(0.3, 0.06, 0.05, col, 0, 0.21, 0.11); box(0.3, 0.06, 0.05, col, 0, 0.21, -0.11);   // collar\n        box(0.2, 0.14, 0.03, col, 0, -0.26, 0.13);                                 // groin flap\n    }\n    return g;\n}\n\nfunction rig(size, mats) {\n    const { g, box } = kit(mats);\n    const col = { light: 'coyote', medium: 'ranger', big: 'khaki' }[size];\n    const pouches = { light: 3, medium: 4, big: 6 }[size];\n    const w = 0.06 + pouches * 0.055;\n    box(w, 0.17, 0.035, col, 0, -0.05, 0.175);                                   // panel\n    for (let i = 0; i < pouches; i++) {\n        const x = (i - (pouches - 1) / 2) * 0.055;\n        box(0.05, 0.1, 0.045, col, x, -0.03, 0.21);                                // mag pouch\n        box(0.052, 0.025, 0.05, 'webbing', x, 0.025, 0.21);                        // flap\n    }\n    if (size !== 'light') for (const s of [1, -1]) box(0.06, 0.07, 0.05, col, s * (w / 2 + 0.03), -0.09, 0.19); // utility pouches\n    if (size === 'big') box(w * 0.8, 0.06, 0.04, col, 0, -0.15, 0.2);              // dump pouch row\n    for (const s of [1, -1]) { box(0.035, 0.012, 0.3, 'webbing', s * 0.1, 0.17, 0.02, 0.45); box(0.012, 0.012, 0.012, 'buckle', s * 0.1, 0.03, 0.195); }\n    box(0.36, 0.03, 0.012, 'webbing', 0, -0.1, -0.13);                            // back strap\n    return g;\n}\n\nfunction pack(size, mats) {\n    const { g, box, roll } = kit(mats);\n    const col = { small: 'olive', medium: 'coyote', large: 'ranger' }[size];\n    const [w, h, d] = { small: [0.27, 0.34, 0.13], medium: [0.31, 0.43, 0.19], large: [0.34, 0.62, 0.24] }[size];\n    const y = size === 'large' ? 0.0 : 0.02, z = -0.14 - d / 2;\n    box(w, h, d, col, 0, y, z);                                                   // main body\n    box(w * 0.9, 0.05, d * 1.02, col, 0, y + h / 2 - 0.01, z);                    // top lid\n    box(w * 0.7, h * 0.4, 0.05, col, 0, y - h * 0.18, z - d / 2 - 0.02);          // front pocket\n    for (let i = 0; i < 3; i++) box(w * 0.66, 0.012, 0.004, 'webbing', 0, y - h * 0.05 - i * 0.04, z - d / 2 - 0.047);\n    for (const s of [1, -1]) box(0.05, h * 0.85, 0.02, 'webbing', s * 0.09, y, -0.13);   // shoulder straps\n    if (size !== 'small') for (const s of [1, -1]) box(0.04, h * 0.45, d * 0.6, col, s * (w / 2 + 0.02), y - h * 0.1, z);\n    if (size === 'large') { roll(0.07, w * 1.05, 'tan', 0, y - h / 2 - 0.06, z); box(0.012, 0.16, 0.012, 'webbing', w * 0.3, y - h / 2 - 0.02, z - d / 2 - 0.01); }\n    return g;\n}\n\nfunction fieldMap(mats) {\n    const { g, box } = kit(mats);\n    box(0.21, 0.006, 0.15, 'paper', 0, 0.003, 0);\n    box(0.002, 0.0062, 0.15, 'ink', 0.035, 0.003, 0); box(0.002, 0.0062, 0.15, 'ink', -0.035, 0.003, 0); box(0.21, 0.0062, 0.002, 'ink', 0, 0.003, 0);\n    box(0.17, 0.0064, 0.008, 'road', 0, 0.003, 0.03, 0, 0.3); box(0.008, 0.0064, 0.12, 'road', -0.05, 0.003, 0);\n    box(0.05, 0.0064, 0.03, 'water', 0.06, 0.003, -0.04);\n    return g;\n}\n\nfunction cash(mats) {\n    const { g, box } = kit(mats);\n    for (let i = 0; i < 3; i++) { box(0.156, 0.012, 0.066, 'bill', i * 0.01 - 0.01, 0.006 + i * 0.012, i * 0.006, 0, i * 0.12); box(0.03, 0.0125, 0.068, 'band', i * 0.01 - 0.01, 0.006 + i * 0.012, i * 0.006, 0, i * 0.12); }\n    return g;\n}\n\nfunction bandage(mats) {\n    const { g, roll } = kit(mats);\n    const r = roll(0.035, 0.07, 'gauze', 0, 0.035, 0); r.rotation.set(0, 0, 0);\n    const tail = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.003, 0.08), mats.gauze); tail.position.set(0, 0.002, 0.07); g.add(tail);\n    return g;\n}\n\nfunction medkit(mats) {\n    const { g, box } = kit(mats);\n    box(0.2, 0.08, 0.13, 'olive', 0, 0.04, 0);                                    // pouch\n    box(0.21, 0.02, 0.135, 'webbing', 0, 0.065, 0);                               // zip lid\n    box(0.07, 0.003, 0.022, 'medred', 0, 0.0765, 0); box(0.022, 0.003, 0.07, 'medred', 0, 0.0765, 0); // red cross patch\n    box(0.08, 0.002, 0.08, 'cross', 0, 0.0755, 0);\n    box(0.03, 0.03, 0.02, 'webbing', 0.11, 0.05, 0);                              // handle\n    return g;\n}\n\nexport function build(kind, { materials = defaultMaterials() } = {}) {\n    const [type, variant] = kind.split('-');\n    const g = type === 'armor' ? armor(variant, materials) : type === 'rig' ? rig(variant, materials) : type === 'pack' ? pack(variant, materials)\n        : kind === 'map' ? fieldMap(materials) : kind === 'cash' ? cash(materials) : kind === 'bandage' ? bandage(materials) : kind === 'medkit' ? medkit(materials) : null;\n    if (!g) throw new Error('Unknown gear ' + kind);\n    g.name = kind; g.userData.kind = kind;\n    return g;\n}\n\n/** Wear or place a gear piece on `parent` (e.g. a Chest bone, or a loot spot). */\nexport function attach(parent, { kind = 'armor-medium', materials = defaultMaterials(), scale = 1, offset = [0, 0, 0] } = {}) {\n    const object = build(kind, { materials }); object.scale.setScalar(scale); object.position.set(...offset); parent.add(object);\n    return { object, update() {}, dispose() { object.removeFromParent(); object.traverse((o) => o.geometry?.dispose()); } };\n}"}