{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Bust swarm</title>\n<meta name=\"description\" content=\"A horde of classical marble busts flocks after you across a snowfield. Jump on their heads. Three lives.\">\n<style>\n  html,body{margin:0;touch-action:none;-webkit-user-select:none;user-select:none;height:100%;overflow:hidden;background:#cfe0ee;font:14px system-ui,sans-serif}\n  #hud{position:fixed;top:10px;left:12px;color:#234;text-shadow:0 1px 2px #fff8;font-weight:700;pointer-events:none}\n  #msg{position:fixed;inset:0;display:grid;place-items:center;color:#fff;text-shadow:0 2px 4px #000a;font-size:22px;text-align:center;cursor:pointer;background:#0005}\n  #msg small{display:block;font-size:14px;opacity:.85;margin-top:8px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script>\n</head><body>\n<div id=\"hud\"></div><div id=\"msg\">loading…</div>\n<script type=\"module\">\nimport * as THREE from \"three\";\nimport { GLTFLoader } from \"three/addons/loaders/GLTFLoader.js\";\nimport * as SkeletonUtils from \"three/addons/utils/SkeletonUtils.js\";\n\nconst PARTS = {\"robot\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiezecuxadyslgydj7gwc3ihmujswsynwykrj4yjbofc4eggugam2y\",\"marble-bust\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiex2mosu3rf53rxbutbjdyq6pa4n7z4sblqvc6ygbiuuuzqxioacy\",\"snow-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafybeicy7gx23fvgrdylsbzb3ftp7zv6jxb4akeleyaso4yducd632rpzy\",\"brick-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafybeicmbd6ebhhh5h5e7rp45dcao5lcblowjpcgnzt2oovamcw452uzge\",\"day-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafybeid7dhs2ji7cfsd5mug7iagvtozqfp4yei7t4r3v6emzbxpqh7df7u\",\"jump-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreickrhtm4jnxehlxtq2qlowctwixqt3xth7yi7vlwaxv63nvjlnf54\",\"hit-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreidqejf2negsnotb3xo7p3m7fv2xfst6oqlpqfnk5dn4vctwp56k74\",\"coin-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6lmgvb7xur2rnodcgqbebxr4z4zypv7j2m5egibysabahllmxf4\",\"platformer-controller\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihbjdl3wwjfiiu7qne4a5qnskfj4lrieutjlv64yhqd25kbth7m74\",\"follow-camera\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiauise4tsy3llffneifcfwo25whtfrccjdjynf2bqj4jj5kypypha\",\"clip-animator\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiahogjc53z7qaa7x4j7nnus5rxahr6ojuaxb2m7oukkb3fxc3zj2y\",\"hdri-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafkreif4o56shppr6t5ttbczmnyjhm5bgaklfsujajbd7y7mjznvtkv2ce\",\"spawner\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiagesa7q5b7qmfy6v3uuk4ulpxghs3tja6a2zc5vsqxl55g6l7rda\",\"wobble\":\"https://ipfs-test.fangorn.network/ipfs/bafkreid7piflgn7mohnohbswhqpp3d2udg4cwmy5n4vz6p4pa5ukydarry\",\"boids\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihc4k4ck3cvcpnnknakoowm6xfp2vseku7ulserahpynjy3woywkm\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\"};\nconst logic = async (id) => import(\"data:text/javascript;charset=utf-8,\" + encodeURIComponent((await (await fetch(PARTS[id])).json()).js));\nlogic(\"touch-controls\").then((t) => t.attach()); // a joystick and jump button on phones\nconst glb = (id) => new GLTFLoader().loadAsync(PARTS[id]);\n\nconst [controller, followCam, animator, sky, spawner, wobble, boids, robotG, bustG, snowTex, brickTex] = await Promise.all([\n    logic(\"platformer-controller\"), logic(\"follow-camera\"), logic(\"clip-animator\"), logic(\"hdri-sky\"), logic(\"spawner\"), logic(\"wobble\"), logic(\"boids\"),\n    glb(\"robot\"), glb(\"marble-bust\"),\n    new THREE.TextureLoader().loadAsync(PARTS[\"snow-texture\"]), new THREE.TextureLoader().loadAsync(PARTS[\"brick-texture\"]),\n]);\nconst audio = new AudioContext();\nconst sounds = Object.fromEntries(await Promise.all([\"jump-sound\", \"hit-sound\", \"coin-sound\"].map(async (id) => [id, await audio.decodeAudioData(await (await fetch(PARTS[id])).arrayBuffer())])));\nconst play = (id, rate = 1) => { const s = audio.createBufferSource(); s.buffer = sounds[id]; s.playbackRate.value = rate; s.connect(audio.destination); s.start(); };\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.shadowMap.enabled = true; renderer.toneMapping = THREE.ACESFilmicToneMapping;\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(55, 1, 0.1, 300);\nconst sun = new THREE.DirectionalLight(0xffffff, 2); sun.position.set(8, 16, 10); sun.castShadow = true;\nObject.assign(sun.shadow.camera, { left: -18, right: 18, top: 18, bottom: -18 }); sun.shadow.mapSize.set(2048, 2048); scene.add(sun);\nconst world = [sky.attach(scene, { url: PARTS[\"day-sky\"], intensity: 1, spin: 0.01 })];\n\n// A snowfield ringed by low brick walls (the busts glide through them; you don't).\nconst R = 14, solids = [];\nfor (const t of [snowTex, brickTex]) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.colorSpace = THREE.SRGBColorSpace; }\nsnowTex.repeat.set(8, 8);\nconst ground = new THREE.Mesh(new THREE.BoxGeometry(2 * R, 2, 2 * R), new THREE.MeshStandardMaterial({ map: snowTex, roughness: 0.9 }));\nground.position.y = -1; ground.receiveShadow = true; scene.add(ground); solids.push(ground);\nfor (const [x, z, w, d] of [[0, -R, 2 * R, 0.6], [0, R, 2 * R, 0.6], [-R, 0, 0.6, 2 * R], [R, 0, 0.6, 2 * R]]) {\n    const tex = brickTex.clone(); tex.repeat.set(Math.max(w, d) / 2, 0.5); tex.needsUpdate = true;\n    const wall = new THREE.Mesh(new THREE.BoxGeometry(w, 1, d), new THREE.MeshStandardMaterial({ map: tex }));\n    wall.position.set(x, 0.5, z); wall.castShadow = wall.receiveShadow = true; scene.add(wall); solids.push(wall);\n}\n\nconst player = SkeletonUtils.clone(robotG.scene); player.scale.setScalar(0.35);\nplayer.traverse((o) => { if (o.isMesh) o.castShadow = true; }); scene.add(player);\nconst BUST = 2.6, HEAD = 0.51 * BUST; // a bust's height in the world\n\nlet over = true, start = 0, lives = 3, stomps = 0, safeUntil = 0, ctl, horde, busts;\nconst systems = [], wobbles = new Map();\nfunction begin() {\n    for (const s of systems.splice(0)) s.dispose();\n    wobbles.clear(); player.position.set(0, 0, 0); lives = 3; stomps = 0; safeUntil = 0;\n    ctl = controller.attach(player, { solids, camera, onJump: () => play(\"jump-sound\"), onFall: () => hurt() });\n    horde = boids.attach([], { target: player, speed: 2.2, seek: 1.4, sight: 2.4, separation: 3, height: 0, bounds: R - 1 });\n    busts = spawner.attach(scene, { every: 2.2, max: 14, first: 0.5,\n        where: () => { const a = Math.random() * Math.PI * 2; return new THREE.Vector3(Math.cos(a) * (R - 2), 0, Math.sin(a) * (R - 2)); },\n        make: () => { const b = bustG.scene.clone(); b.scale.setScalar(BUST); b.traverse((o) => { if (o.isMesh) o.castShadow = true; }); return b; },\n        onSpawn: (b) => { horde.add(b); const w = wobble.attach(b, { amount: 0.4 }); w.poke(-1); wobbles.set(b, w); } });\n    systems.push(ctl, horde, busts, animator.attach(player, { animations: robotG.animations, state: () => ctl.state }),\n        followCam.attach(camera, { target: player, offset: [0, 8, 9] }));\n    over = false; start = performance.now(); $msg.style.display = \"none\";\n}\nfunction hurt() {\n    if (performance.now() < safeUntil) return;\n    play(\"hit-sound\"); lives--; safeUntil = performance.now() + 1500;\n    if (lives <= 0) {\n        over = true; const t = ((performance.now() - start) / 1000).toFixed(0);\n        $msg.innerHTML = `Overwhelmed by antiquity.<small>${stomps} busts stomped in ${t}s · click to try again</small>`; $msg.style.display = \"\";\n    } else { player.position.set(0, 0, 0); ctl.velocity.set(0, 6, 0); }\n}\nconst $msg = document.getElementById(\"msg\"), $hud = document.getElementById(\"hud\");\n$msg.innerHTML = \"Bust swarm<small>WASD / arrows · Shift to run · Space to jump<br>land on a bust's head to stomp it · don't let them touch you<br><br>click to start</small>\";\n$msg.onclick = () => { audio.resume(); begin(); };\n\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\ncamera.position.set(0, 10, 14); camera.lookAt(0, 0, 0);\nconst clock = new THREE.Clock();\nrenderer.setAnimationLoop(() => {\n    const dt = clock.getDelta();\n    for (const w of world) w.update(dt);\n    if (!over) {\n        for (const s of systems) s.update(dt);\n        for (const w of wobbles.values()) w.update(dt);\n        const p = player.position;\n        for (const b of [...horde.flock]) {\n            if (Math.hypot(b.position.x - p.x, b.position.z - p.z) > 0.8) continue;\n            if (ctl.velocity.y < 0 && p.y > HEAD * 0.55) { // landed on it: stomp, bounce\n                stomps++; play(\"coin-sound\", 0.8 + Math.random() * 0.4); ctl.velocity.y = 9;\n                horde.remove(b); wobbles.get(b).poke(2.5);\n                setTimeout(() => { busts.remove(b); wobbles.delete(b); }, 250);\n            } else if (p.y < HEAD * 0.5) hurt();\n        }\n        player.visible = performance.now() > safeUntil || Math.floor(performance.now() / 100) % 2 === 0;\n        $hud.textContent = `${\"♥\".repeat(Math.max(lives, 0))} · stomped ${stomps} · ${((performance.now() - start) / 1000).toFixed(0)}s`;\n    }\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}