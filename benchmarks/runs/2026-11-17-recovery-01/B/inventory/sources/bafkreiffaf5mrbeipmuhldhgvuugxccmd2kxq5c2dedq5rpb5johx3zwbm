{"js":"// CC0. Generic Three.js view of a survival-kit scenario. The simulation owns all rules.\nimport * as T from 'three';\nexport function attach(scene,{session,models={},accent=0xd5b77c}={}){\n if(!session?.navigation)throw Error('A survival-kit session is required');\n const root=new T.Group();scene.add(root);const nav=session.navigation,spec=session.scenario;\n const old={background:scene.background,fog:scene.fog};scene.background=new T.Color(0x263c39);scene.fog=new T.FogExp2(0x263c39,.012);\n const mat=(color,emissive=0)=>new T.MeshStandardMaterial({color,emissive,emissiveIntensity:.35,roughness:.8});\n const stone=mat(0x8a9688),floor=mat(0x384b44),metal=mat(0x76847a),warm=mat(accent),mint=mat(0x97ceb3,0x2f8055);\n const box=new T.BoxGeometry(1,1,1),meshes=[];\n function cube(material,pos,scale){const m=new T.Mesh(box,material);m.position.set(pos.x,pos.y??0,pos.z);m.scale.set(...scale);m.castShadow=m.receiveShadow=true;root.add(m);meshes.push(m);return m;}\n const center=nav.world((nav.width-1)/2,(nav.height-1)/2);cube(floor,{...center,y:-.2},[nav.width*nav.cellSize,.3,nav.height*nav.cellSize]);\n let count=0;spec.rows.forEach(r=>[...r].forEach(c=>{if(c==='#')count++;}));const walls=new T.InstancedMesh(box,stone,count);const helper=new T.Object3D();let index=0;\n for(let z=0;z<nav.height;z++)for(let x=0;x<nav.width;x++)if(spec.rows[z][x]==='#'){helper.position.set(nav.world(x,z).x,1.1,nav.world(x,z).z);helper.scale.set(nav.cellSize,2.2,nav.cellSize);helper.updateMatrix();walls.setMatrixAt(index++,helper.matrix);}\n walls.castShadow=walls.receiveShadow=true;root.add(walls);\n const grid=new T.GridHelper(Math.max(nav.width,nav.height)*nav.cellSize,Math.max(nav.width,nav.height),0x64776a,0x40584a);grid.position.y=-.035;root.add(grid);\n function cloneModel(source,tint){const g=source?source.clone(true):new T.Group();if(!source){const body=new T.Mesh(new T.CapsuleGeometry(.3,.7,4,10),mat(tint??0xd9d6ba));body.position.y=.8;g.add(body);}if(tint)g.traverse(o=>{if(o.isMesh){o.material=o.material.clone();if(!o.name.includes('Eye')){o.material.color.set(tint);o.material.emissive?.set(0x251a18);}}});g.traverse(o=>{if(o.isMesh)o.castShadow=true;});root.add(g);return g;}\n const player=cloneModel(models.player);const actors=spec.enemies.map(()=>cloneModel(models.player,0x856b67));\n const indicators=actors.map(()=>{const m=new T.Mesh(new T.OctahedronGeometry(.13),new T.MeshBasicMaterial({color:0xffa27d}));root.add(m);return m;});\n const doorMeshes=spec.doors.map(d=>{const p=nav.world(...d.cell);const horizontal=spec.rows[d.cell[1]][d.cell[0]-1]==='#';return cube(metal.clone(),{...p,y:1},horizontal?[nav.cellSize,.1,nav.cellSize]:[nav.cellSize,.1,nav.cellSize]);});\n function label(text){const c=document.createElement('canvas');c.width=512;c.height=96;const x=c.getContext('2d');x.fillStyle='#152821dd';x.fillRect(0,0,512,96);x.font='24px Arial';x.textAlign='center';x.fillStyle='#e5e3c2';x.fillText(text,256,59);const texture=new T.CanvasTexture(c);texture.colorSpace=T.SRGBColorSpace;const sprite=new T.Sprite(new T.SpriteMaterial({map:texture,depthWrite:false}));sprite.scale.set(5,1,1);root.add(sprite);return sprite;}\n const markers=new Map();for(const l of session.locations){let model;\n  if(l.type==='cache'&&models.cache)model=cloneModel(models.cache);\n  else if(l.type==='ward'&&models.lamp)model=cloneModel(models.lamp);\n  else if(l.type==='bench'){model=cube(warm,{...l.position,y:.65},[1.3,.2,1]);}\n  else if(l.type==='radio'){model=cube(metal,{...l.position,y:1},[1.2,2,1]);cube(warm,{...l.position,y:3},[.08,3,.08]);const dish=new T.Mesh(new T.TorusGeometry(.7,.06,8,24),mint);dish.position.set(l.position.x,4,l.position.z);root.add(dish);}\n  else model=cube(l.type==='exit'?mint:warm,{...l.position,y:.25},[1.1,.5,1.1]);\n  model.position.x=l.position.x;model.position.z=l.position.z;\n  const ring=new T.Mesh(new T.TorusGeometry(.8,.045,6,32),new T.MeshBasicMaterial({color:l.type==='exit'?0x7bcfa4:0xe7c48c}));ring.rotation.x=Math.PI/2;ring.position.set(l.position.x,.05,l.position.z);root.add(ring);\n  const sign=label(l.title);sign.position.set(l.position.x,3,l.position.z);markers.set(l.id,{model,ring,sign});\n }\n const wardRing=new T.Mesh(new T.RingGeometry(spec.ward.radius-.1,spec.ward.radius,64),new T.MeshBasicMaterial({color:0xe6c183,side:T.DoubleSide,transparent:true,opacity:.45}));wardRing.rotation.x=-Math.PI/2;const wardPoint=nav.world(...spec.ward.cell);wardRing.position.set(wardPoint.x,.035,wardPoint.z);root.add(wardRing);\n const hemi=new T.HemisphereLight(0xc8d9bc,0x263b32,1.8);root.add(hemi);const sun=new T.DirectionalLight(0xffdeb0,2);sun.position.set(12,25,8);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);Object.assign(sun.shadow.camera,{left:-35,right:35,top:35,bottom:-35,far:100});sun.shadow.normalBias=.04;root.add(sun);\n const light=new T.PointLight(0xffc67c,35,18);light.position.set(wardPoint.x,3,wardPoint.z);root.add(light);const noise=new T.Mesh(new T.RingGeometry(.97,1,48),new T.MeshBasicMaterial({color:0xe6a478,transparent:true,opacity:.3,side:T.DoubleSide}));noise.rotation.x=-Math.PI/2;root.add(noise);\n let dead=false,dim=0;\n return{root,player,drawMap(canvas){const x=canvas.getContext('2d'),s=session.state,cw=canvas.width/nav.width,ch=canvas.height/nav.height;x.fillStyle='#17271f';x.fillRect(0,0,canvas.width,canvas.height);for(let z=0;z<nav.height;z++)for(let a=0;a<nav.width;a++)if(spec.rows[z][a]==='#'){x.fillStyle='#82917c';x.fillRect(a*cw,z*ch,cw,ch);}for(const d of s.doors){x.fillStyle=d.open?'#467c60':'#d3ac6d';x.fillRect(d.cell[0]*cw,d.cell[1]*ch,cw,ch);}function dot(p,color,r=2){const c=nav.cell(p);x.fillStyle=color;x.beginPath();x.arc((c.x+.5)*cw,(c.z+.5)*ch,r,0,Math.PI*2);x.fill();}for(const l of session.locations)if(l.type!=='cache'||!s.looted.includes(l.id))dot(l.position,l.type==='cache'?'#c3c79b':'#a0d4b5');for(const e of s.enemies)if(e.hp>0&&e.mode!=='patrol')dot(e.position,'#ed9274');dot(s.player.position,'#fff5b0',3);const target=session.locations.find(l=>l.id===s.objectives[0]?.target);if(target){const c=nav.cell(target.position);x.strokeStyle='#fff07c';x.lineWidth=2;x.strokeRect(c.x*cw-1,c.z*ch-1,cw+2,ch+2);}},update(dt){if(dead)return;const s=session.state;player.position.set(s.player.position.x,0,s.player.position.z);player.rotation.y=s.player.heading;\n  actors.forEach((m,i)=>{const e=s.enemies[i];m.position.set(e.position.x,0,e.position.z);m.rotation.y=e.heading;m.rotation.z=e.hp<=0?Math.PI/2:0;indicators[i].position.set(e.position.x,2.2,e.position.z);indicators[i].visible=e.hp>0&&e.mode!=='patrol';indicators[i].material.color.set(e.mode==='chase'?0xff866d:0xe9c36c);});\n  s.doors.forEach((d,i)=>{const m=doorMeshes[i];m.scale.y=d.open?.1:2;m.position.y=d.open?.04:1;m.material.color.set(d.hp<25?0xa26b58:d.locked?0xad9571:0x76847a);});\n  for(const l of session.locations){const m=markers.get(l.id),used=s.looted.includes(l.id);m.ring.visible=!used&&(l.type!=='exit'||s.rescueReady);m.sign.visible=used?false:Math.hypot(l.position.x-s.player.position.x,l.position.z-s.player.position.z)<15;}\n  light.intensity=s.wardFuel>0?35:0;wardRing.visible=s.wardFuel>0;dim+=(Number(s.night)-dim)*(1-Math.exp(-dt));hemi.intensity=1.8-dim;sun.intensity=2-dim*1.6;scene.background.setRGB(.15-dim*.09,.23-dim*.13,.21-dim*.1);scene.fog.color.copy(scene.background);\n  noise.visible=!!s.lastNoise;if(s.lastNoise){noise.position.set(s.lastNoise.x,.055,s.lastNoise.z);noise.scale.setScalar(Math.max(.2,(1.5-s.lastNoise.ttl)*s.lastNoise.radius));noise.material.opacity=s.lastNoise.ttl*.18;}\n },dispose(){if(dead)return;dead=true;root.removeFromParent();const geometries=new Set(),materials=new Set();root.traverse(o=>{if(o.geometry)geometries.add(o.geometry);if(o.material)materials.add(o.material);});geometries.forEach(g=>g.dispose());materials.forEach(m=>{if(m.map&&!Object.values(models).some(g=>g===m.map))m.map.dispose();m.dispose();});scene.background=old.background;scene.fog=old.fog;}};\n}\n"}