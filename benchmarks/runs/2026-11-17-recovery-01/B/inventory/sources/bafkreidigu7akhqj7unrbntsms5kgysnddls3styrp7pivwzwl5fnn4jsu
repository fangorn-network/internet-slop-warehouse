{"js":"// CC0-1.0. Per-body-part health: head, thorax, stomach, both arms, both legs. Lethal parts kill at zero, an\n// \"instant\" part (the head) kills on any hit, a destroyed limb passes further damage on to the rest of the body.\n// Same surface as the warehouse `health` part (value, max, dead, damage, heal, revive, update, dispose), so it\n// drops in where `health` was; damage takes the part as a third argument.\n\nexport const HUMAN = {\n    head:     { name: 'Head', max: 35, lethal: true, instant: true },\n    thorax:   { name: 'Thorax', max: 85, lethal: true },\n    stomach:  { name: 'Stomach', max: 70 },\n    leftArm:  { name: 'Left arm', max: 60 },\n    rightArm: { name: 'Right arm', max: 60 },\n    leftLeg:  { name: 'Left leg', max: 65 },\n    rightLeg: { name: 'Right leg', max: 65 },\n};\n\n/**\n * Which part a hit landed on, from the hit height as a fraction of standing height and the sideways offset\n * (metres, + = the character's own right) from the body's centre line.\n */\nexport function hitZone(heightFraction, lateral, { torso = 0.17 } = {}) {\n    const side = lateral >= 0 ? 'right' : 'left', wide = Math.abs(lateral) > torso;\n    if (heightFraction >= 0.85) return 'head';\n    if (heightFraction >= 0.63) return wide ? side + 'Arm' : 'thorax';\n    if (heightFraction >= 0.5) return wide ? side + 'Arm' : 'stomach';\n    return side + 'Leg';\n}\n\nexport function attach(object, {\n    parts = HUMAN, scale = 1, overflow = 0.7, initial = null,\n    onChange = () => {}, onDestroyed = () => {}, onDeath = () => {},\n} = {}) {\n    const state = Object.fromEntries(Object.entries(parts).map(([k, p]) => {\n        const max = Math.max(1, Math.round(p.max * scale));\n        return [k, { ...p, max, hp: Math.min(max, initial?.[k] ?? max) }];\n    }));\n    let dead = false, disposed = false;\n    const fallback = state.thorax ? 'thorax' : Object.keys(state)[0];\n    const total = () => Object.values(state).reduce((s, p) => s + p.hp, 0);\n    const maxTotal = Object.values(state).reduce((s, p) => s + p.max, 0);\n    const die = (source, part) => { if (dead) return; dead = true; onDeath(object, source, part); };\n    function hurt(key, amount, source, spread) {\n        const p = state[key];\n        if (p.instant && amount > 0) { const lost = p.hp; p.hp = 0; onChange(key, -lost, source); die(source, key); return lost; }\n        if (p.hp <= 0) return spread ? 0 : passOn(key, amount, source);\n        const lost = Math.min(p.hp, amount); p.hp -= lost; onChange(key, -lost, source);\n        if (p.hp === 0) { onDestroyed(key, source); if (p.lethal) { die(source, key); return lost; } }\n        return lost + (amount > lost && !spread ? passOn(key, amount - lost, source) : 0);\n    }\n    // Damage into a destroyed part spreads (reduced) over the remaining non-instant parts.\n    function passOn(from, amount, source) {\n        const rest = Object.keys(state).filter((k) => k !== from && state[k].hp > 0 && !state[k].instant);\n        if (!rest.length) { die(source, from); return 0; }\n        let lost = 0; for (const k of rest) { if (dead) break; lost += hurt(k, amount * overflow / rest.length, source, true); }\n        return lost;\n    }\n    return {\n        get value() { return total(); }, get max() { return maxTotal; }, get dead() { return dead; },\n        get invulnerable() { return false; },\n        get parts() { return Object.fromEntries(Object.entries(state).map(([k, p]) => [k, { name: p.name, hp: p.hp, max: p.max }])); },\n        get destroyed() { return Object.keys(state).filter((k) => state[k].hp <= 0); },\n        part(key) { const p = state[key]; return p ? { name: p.name, hp: p.hp, max: p.max } : null; },\n        /** Damage a part (default thorax). Returns HP actually lost. */\n        damage(amount, source = null, part = fallback) {\n            if (disposed || dead || !(amount > 0)) return 0;\n            return hurt(state[part] ? part : fallback, amount, source, false);\n        },\n        /** Heal up to `amount`, most damaged (by fraction) living parts first. restore: also bring destroyed parts back. */\n        heal(amount, { restore = false, part = null } = {}) {\n            if (disposed || dead || !(amount > 0)) return 0;\n            let left = amount;\n            if (restore) for (const p of Object.values(state)) if (p.hp <= 0 && !p.instant && left >= 1) { p.hp = 1; left -= 1; }\n            const order = Object.entries(state).filter(([k, p]) => p.hp > 0 && p.hp < p.max && (!part || k === part)).sort(([, a], [, b]) => a.hp / a.max - b.hp / b.max);\n            for (const [k, p] of order) { const g = Math.min(p.max - p.hp, left); p.hp += g; left -= g; if (g) onChange(k, g, null); if (left <= 0) break; }\n            return amount - left;\n        },\n        revive() { if (disposed) return false; for (const p of Object.values(state)) p.hp = p.max; dead = false; return true; },\n        snapshot() { return Object.fromEntries(Object.entries(state).map(([k, p]) => [k, p.hp])); },\n        update() {},\n        dispose() { disposed = true; },\n    };\n}"}