{"js":"// SPDX-License-Identifier: CC0-1.0\n// Semantically distinct facade kits and inhabited street edges. Inferred designs, never replicas.\nimport * as T from 'three';\nexport function profile(b){const t=b.tags??{};if(t.amenity==='hospital'||t.healthcare||b.kind==='hospital')return'medical';if(['cafe','restaurant','bar','pub','fast_food'].includes(t.amenity))return'cafe';if(t.building==='church'||t.amenity==='place_of_worship')return'church';if(t.tourism==='hotel'||t.building==='hotel')return'lodge';if(t.building==='apartments')return'apartments';if(b.kind==='home')return'home';if(['shop','commercial'].includes(b.kind)||t.shop)return'shop';if(b.kind==='school')return'school';if(b.kind==='civic')return'civic';if(b.kind==='industrial'||['warehouse','industrial','garages'].includes(t.building))return'workshop';// Sparse vector tiles omit building use; these visual fallbacks are inferred, not mapped facts.\n const area=Math.abs((b.points??[]).slice(1).reduce((n,p,i)=>n+(b.points[i].x*p.z-p.x*b.points[i].z),0)/2);if((t['addr:housenumber']||area<260)&&b.height<13)return'home';if(area>1100&&b.height<15)return'workshop';if(b.height>=15)return'apartments';return'building';}\nexport function frontage(b,roads){let best=null;for(let i=1;i<b.points.length;i++){const a=b.points[i-1],c=b.points[i],dx=c.x-a.x,dz=c.z-a.z,length=Math.hypot(dx,dz);if(length<2)continue;const x=(a.x+c.x)/2,z=(a.z+c.z)/2;let score=Infinity,roadPoint;for(const road of roads){if(road.labelOnly||road.kind==='water')continue;for(let j=1;j<road.points.length;j++){const u=road.points[j-1],v=road.points[j],lx=v.x-u.x,lz=v.z-u.z,t=Math.max(0,Math.min(1,((x-u.x)*lx+(z-u.z)*lz)/(lx*lx+lz*lz||1))),p={x:u.x+lx*t,z:u.z+lz*t},d=Math.hypot(p.x-x,p.z-z);if(d<score){score=d;roadPoint=p;}}}if(!best||score<best.score){let nx=-dz/length,nz=dx/length;if(roadPoint&&(roadPoint.x-x)*nx+(roadPoint.z-z)*nz<0){nx=-nx;nz=-nz;}best={x,z,dx:dx/length,dz:dz/length,nx,nz,length,score};}}return best;}\nexport function attach(parent,{district,models={},maxDecorated=150,labelDistance=85}={}){const root=new T.Group();parent.add(root);const geometries=new Set(),materials=new Set(),textures=new Set(),labels=[],groups=[],batches=new Map();const material=(color,emissive=false)=>{const key=color+emissive;if(batches.has(key))return batches.get(key).m;const m=new T.MeshStandardMaterial({color,roughness:.85,...(emissive?{emissive:color,emissiveIntensity:.25}:{})});materials.add(m);batches.set(key,{m,items:[]});return m;};const wood=material('#806b50'),cream=material('#dad2ba'),dark=material('#334d51'),green=material('#587f67'),red=material('#a77360'),gold=material('#ebc58b',true),white=material('#c3d4cc');const boxGeometry=new T.BoxGeometry(1,1,1);geometries.add(boxGeometry);\n function box(f,x,y,z,w,h,d,m,tilt=0){const p=new T.Vector3(f.x+f.dx*x+f.nx*z,y,f.z+f.dz*x+f.nz*z),q=new T.Quaternion().setFromAxisAngle(new T.Vector3(0,1,0),-Math.atan2(f.dz,f.dx));if(tilt)q.multiply(new T.Quaternion().setFromAxisAngle(new T.Vector3(0,0,1),tilt));const matrix=new T.Matrix4().compose(p,q,new T.Vector3(w,h,d));const batch=[...batches.values()].find(b=>b.m===m);batch.items.push(matrix);}\n function model(kind,f,x,z){const source=models[kind];if(!source)return;const g=source.clone(true);g.position.set(f.x+f.dx*x+f.nx*z,0,f.z+f.dz*x+f.nz*z);g.rotation.y=-Math.atan2(f.dz,f.dx);root.add(g);groups.push(g);}\n function sign(text,f,y,width){const canvas=document.createElement('canvas');canvas.width=512;canvas.height=96;const c=canvas.getContext('2d');c.fillStyle='#24473f';c.fillRect(0,0,512,96);c.strokeStyle='#c7b17d';c.lineWidth=6;c.strokeRect(3,3,506,90);c.fillStyle='#f3e9cf';c.font='600 33px Georgia';c.textAlign='center';c.textBaseline='middle';c.fillText(text.slice(0,42),256,49,475);const texture=new T.CanvasTexture(canvas);texture.colorSpace=T.SRGBColorSpace;textures.add(texture);const m=new T.MeshBasicMaterial({map:texture,side:T.DoubleSide});materials.add(m);const g=new T.PlaneGeometry(width,.7);geometries.add(g);const mesh=new T.Mesh(g,m);mesh.position.set(f.x+f.nx*.24,y,f.z+f.nz*.24);mesh.rotation.y=Math.atan2(f.nx,f.nz);root.add(mesh);labels.push(mesh);}\n const nearest=[...district.buildings].filter(b=>b.minHeight<2).sort((a,b)=>Math.hypot(a.x-district.spawn.x,a.z-district.spawn.z)-Math.hypot(b.x-district.spawn.x,b.z-district.spawn.z)).slice(0,maxDecorated);let decorated=0;const counts={};\n for(const b of nearest){const kind=profile(b),f=frontage(b,district.roads);if(!f||f.length<2||f.score>100)continue;decorated++;counts[kind]=(counts[kind]??0)+1;const width=Math.min(12,f.length*.85),height=b.height;\n  if(['shop','cafe','lodge'].includes(kind)){box(f,0,.4,.6,width,.8,.8,cream);box(f,0,1.6,.12,width,1.7,.16,dark);for(const x of[-width/2,width/2])box(f,x,1.7,.3,.2,3.4,.4,cream);box(f,0,3.2,.9,width+1,.2,2,kind==='cafe'?red:green);box(f,0,1.2,.25,1.15,2.4,.22,wood);sign(b.name||({cafe:'Neighborhood café',lodge:'Lakeside lodging',shop:'Trading post'})[kind],f,3.7,Math.max(2,Math.min(7,width)));if(kind==='cafe'&&f.score>4)model('cafe-table',f,Math.min(3,width*.3),2.8);else if(f.score>4)model('planter',f,width/2+.8,1.6);}\n  else if(kind==='home'||kind==='apartments'){box(f,0,.15,1.2,Math.min(4,width),.3,2.3,wood);box(f,0,1.15,.18,1.1,2.3,.2,green);for(const x of[-1.5,1.5]){box(f,x,1.4,2.1,.13,2.8,.13,cream);box(f,x,.75,1.4,.1,.8,1.4,cream);}box(f,0,2.8,1.1,3.6,.18,2.7,dark);model('planter',f,2.6,1.1);if(kind==='apartments')for(let y=4;y<Math.min(height,13);y+=3){box(f,0,y,1,width,.15,1.8,cream);box(f,0,y+.65,1.8,width,.08,.08,dark);}}\n  else if(kind==='civic'||kind==='school'||kind==='church'){for(let i=0;i<3;i++)box(f,0,.1+i*.12,1.4-i*.4,Math.min(6,width),.2+i*.2,2-i*.4,cream);for(const x of[-width*.35,width*.35])box(f,x,1.8,.8,.35,3.6,.35,cream);box(f,0,3.8,.8,width+.5,.35,2.1,kind==='school'?red:white);box(f,0,1.3,.2,1.8,2.6,.2,dark);sign(b.name||({civic:'Community hall',school:'School',church:'Meeting house'})[kind],f,4.3,Math.min(8,width));if(f.score>5){model('bench',f,width/2+1,2.5);model('planter',f,-width/2-1,2.5);}}\n  else if(kind==='medical'){box(f,0,3,.9,width,.3,2.5,white);box(f,0,1.3,.2,2.1,2.6,.22,dark);box(f,0,3.9,.3,.5,1.6,.16,red);box(f,0,3.9,.3,1.6,.5,.16,red);sign(b.name||'Medical station',f,5,Math.min(8,width));model('bench',f,3,1.8);}\n  else if(kind==='workshop'){box(f,0,.3,1.2,width,.6,2.4,dark);box(f,0,1.8,.18,Math.min(5,width),3,.2,white);for(let y=.5;y<3.2;y+=.4)box(f,0,y,.3,Math.min(5,width),.05,.08,dark);for(const x of[-width*.45,width*.45])box(f,x,.55,1.9,.15,1.1,.15,gold);model('supply-cache',f,width/2+1,1.3);sign(b.name||'Workshop & supplies',f,4.2,Math.min(7,width));}\n  else {box(f,0,1.2,.15,1,2.4,.15,wood);if(b.name)sign(b.name,f,3.2,Math.min(6,width));}\n }\n for(const batch of batches.values()){if(!batch.items.length)continue;const mesh=new T.InstancedMesh(boxGeometry,batch.m,batch.items.length);batch.items.forEach((m,i)=>mesh.setMatrixAt(i,m));mesh.castShadow=mesh.receiveShadow=true;root.add(mesh);}\n return{root,stats:{decorated,profiles:counts},update(dt,state,viewer){for(const label of labels)label.visible=!viewer||Math.hypot(label.position.x-viewer.x,label.position.z-viewer.z)<labelDistance;for(const g of groups)g.visible=!viewer||Math.hypot(g.position.x-viewer.x,g.position.z-viewer.z)<180;},dispose(){root.traverse(o=>{if(o.isInstancedMesh)o.dispose();});root.removeFromParent();geometries.forEach(g=>g.dispose());materials.forEach(m=>m.dispose());textures.forEach(t=>t.dispose());}};\n}\n// Hooks for osm-town-view: preserve footprint geometry while varying category materials.\nexport function classifyBuilding(b){const p=profile(b);return({medical:'hospital',cafe:'shop',lodge:'home',apartments:'home',workshop:'industrial',church:'civic'})[p]??p;}\nexport function styleBuilding(b,mesh){const p=profile(b);if(['home','apartments','lodge','medical','school','civic','church'].includes(p)){let n=0;for(const c of b.id??'')n=(Math.imul(n,31)+c.charCodeAt(0))>>>0;mesh.material.map=null;mesh.material.color.set(p==='medical'?'#cad8ce':['#a6b6a8','#c8c2aa','#aab9bf','#b5b7a0','#c2b29c'][n%5]);mesh.material.needsUpdate=true;}else if(p==='workshop'){mesh.material.map=null;mesh.material.color.set('#87938b');mesh.material.needsUpdate=true;}}\n"}