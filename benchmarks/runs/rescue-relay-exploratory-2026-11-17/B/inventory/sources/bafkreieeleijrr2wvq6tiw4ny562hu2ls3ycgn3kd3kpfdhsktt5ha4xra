ns{gap:4px}.hud-buttons button{padding:8px;font-size:10px}.statbox{gap:4px}.statbox span{font-size:9px;padding:4px 6px}#objective{left:14px;top:160px;font-size:10px;max-width:210px}#mini{right:14px;top:158px;width:110px;height:110px}#panel{right:10px;left:10px;width:auto;top:116px;bottom:24px;padding:15px}#footer{font-size:8px;left:8px;max-width:calc(100% - 16px)}.coords{margin-top:8px}}@media(max-width:600px){#hud{display:block}#hud .hud-buttons{position:absolute;right:0;top:0}.statbox{flex-wrap:nowrap;margin-top:10px;gap:3px}.statbox span{font-size:8px;padding:4px 5px;white-space:nowrap}#objective{top:151px}#message{bottom:256px}}@media(max-height:500px){#hud{top:56px}#mini{top:120px;width:100px;height:100px}#objective{top:131px}#panel{top:105px;bottom:15px}#message{bottom:150px;max-width:350px}#prompt{bottom:50px;max-width:320px}#controls{bottom:30px}#joystick{bottom:35px;width:90px;height:90px}#nub{left:25px;top:25px}}\n\n#place-form{margin-top:14px}#place-results{display:grid;gap:7px;margin-top:10px}#place-results button{text-align:left;white-space:normal;width:100%;line-height:1.4;padding:12px}#place-results small{display:block;color:var(--muted);font-size:10px;margin-top:3px}#run-button,#nav-chip{display:none}\n@media(pointer:coarse){#joystick{left:16px;bottom:max(52px,env(safe-area-inset-bottom));width:120px;height:120px;background:radial-gradient(circle,#d6c69712 0 40%,transparent 41% 62%,#d6c6972e 63% 65%,transparent 66%)}#joystick.sprinting{border-color:var(--gold);box-shadow:0 0 0 3px #d9b77d25}#nub{width:44px;height:44px;left:50%;top:50%;margin:-22px}#run-button{display:block;position:absolute;left:146px;bottom:58px;min-width:60px;max-width:64px;min-height:48px;padding:8px 5px;font-size:10px;z-index:4;touch-action:manipulation}#run-button.active{background:#d4b57c;color:#102a31;border-color:#d4b57c}#nav-chip{display:block;position:absolute;bottom:184px;left:16px;right:16px;z-index:4;min-height:48px;font-size:12px;line-height:1.4;padding:9px 12px;background:#10282cf0;border-color:#b5b78c}#nav-chip[hidden]{display:none}#prompt{display:none}#controls{right:12px;grid-template-columns:repeat(2,64px)}#controls button{font-size:10px}body.menu #run-button,body.menu #nav-chip{display:none}}\n@media(max-height:500px) and (pointer:coarse){#joystick{width:100px;height:100px;bottom:34px}#run-button{left:130px;bottom:42px}#nav-chip{left:16px;right:auto;width:min(310px,calc(100% - 200px));bottom:145px;min-height:44px;font-size:11px}#message{bottom:196px;max-width:350px}#nub{left:50%;top:50%}}\n\n/* v3: keep the world readable and reveal secondary controls only when needed. */\n#mobile-status,#tools-button{display:none}#tools-tray[hidden]{display:none}#atlas-wrap{position:relative;overflow:hidden;border:1px solid #61766d;border-radius:5px}#atlas{border:0;aspect-ratio:1;display:block}#map-tools{position:absolute;right:10px;top:10px;display:grid;gap:5px}#map-tools button{width:44px;min-height:44px;padding:6px;background:#10262def;font-size:17px;touch-action:manipulation}.map-credit{font-size:10px;color:var(--muted)}.menu-choice{display:block;width:100%;text-align:left;margin:10px 0;min-height:48px}button:active{filter:brightness(1.15)}\n@media(pointer:coarse){#hud{left:14px;right:14px;top:max(62px,env(safe-area-inset-top));height:44px;display:flex;justify-content:flex-end;align-items:center}#hud>div:first-child,#journal-button,#mini,#objective,#prompt,#controls #scan{display:none!important}#mobile-status{display:block;position:absolute;left:16px;top:76px;z-index:2;font-size:12px;color:#f1e9d1;text-shadow:0 1px 8px #10262d;pointer-events:none}#hud .hud-buttons{position:static;gap:6px}.hud-buttons button{min-width:52px;min-height:44px;background:#10282ce8}#joystick{width:100px;height:100px;left:16px;bottom:40px;opacity:.78}#nub{width:40px;height:40px;margin:-20px}#controls{right:16px;bottom:42px;display:flex;flex-direction:column-reverse;gap:9px;transform:none;left:auto}#controls #interact{width:70px;height:70px;border-radius:50%;background:#d5b981;color:#10262d;font-size:13px;font-weight:700;border-color:#e0c795}#tools-button{display:block;width:70px;min-height:44px;font-size:11px;background:#10282ce8}#tools-tray{display:grid;position:absolute;right:96px;bottom:42px;width:154px;padding:10px;gap:7px;background:#10282cf5;border:1px solid #607c78;border-radius:6px;z-index:5}#tools-tray button{position:static;display:block;max-width:none;width:100%;min-height:44px;font-size:12px}#run-button{display:none}#tools-tray #run-button{display:block}#nav-chip{left:16px;right:16px;bottom:158px;min-height:38px;padding:8px 10px;border:0;background:#10282ccf;font-size:11px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}#message{bottom:210px;left:16px;transform:none;width:calc(100% - 32px);padding:9px 12px;font-size:11px;max-height:70px;overflow:hidden}#footer{font-size:8px;line-height:1.3;left:8px;bottom:max(4px,env(safe-area-inset-bottom));background:#10262d99;max-width:calc(100% - 16px)}#footer-context{display:none}#panel{inset:56px 0 0;width:100%;padding:14px 16px 24px;border:0;border-radius:14px 14px 0 0;box-shadow:0 -10px 60px #071b2966;background:#10252b;overscroll-behavior:contain}#panel .panel-top{top:-14px;padding:9px 0;background:#10252b}.panel-open #hud,.panel-open #mobile-status,.panel-open #controls,.panel-open #joystick,.panel-open #nav-chip,.panel-open #message,.panel-open #footer,.panel-open #tools-tray{display:none!important}body.menu #mobile-status,body.menu #tools-tray{display:none}#atlas{height:min(64dvh,calc(100vw - 32px));aspect-ratio:auto}#panel.atlas-panel{padding-top:10px}.atlas-help{font-size:11px;margin:8px 0}.tower-row button{font-size:11px;min-width:94px}.map-credit{margin:8px 0;font-size:9px}}\n@media(max-height:500px) and (pointer:coarse){#hud{top:56px}#mobile-status{top:70px}#joystick{width:86px;height:86px;bottom:30px}#controls{bottom:28px;flex-direction:row-reverse;align-items:end}#controls #interact{width:60px;height:60px}#tools-button{width:60px}#nav-chip{left:118px;right:165px;bottom:32px;width:auto;min-height:40px}#tools-tray{right:16px;bottom:100px;width:190px}#message{bottom:102px;left:118px;max-width:380px}#atlas{height:calc(100dvh - 138px)}#panel{top:52px}#map-tools{grid-template-columns:repeat(4,44px);top:auto;bottom:8px}}\n</style><script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script></head><body class=\"menu\">\n<div id=\"loading\">Receiving the atlas…<small>Real streets. A fictional missing hour.</small></div>\n<div id=\"hud\"><div><div class=\"eyebrow\">Field service / case 01</div><div class=\"mast\">Dead Air Atlas</div><div class=\"statbox\"><span id=\"clarity\">CLARITY 100</span><span id=\"charge\">LIGHT 100%</span><span id=\"inventory\">6 CELLS</span><span id=\"score\">0 POINTS</span></div></div><div class=\"hud-buttons\"><button id=\"journal-button\">Notebook</button><button id=\"map-button\">Atlas</button><button id=\"desk-button\">Desk</button></div></div><div id=\"mobile-status\" aria-live=\"polite\"></div><div id=\"objective\"></div><canvas id=\"mini\" width=\"284\" height=\"284\" aria-label=\"District minimap. Open the atlas for routes.\"></canvas><div id=\"message\" role=\"status\"></div><div id=\"prompt\"></div><button id=\"nav-chip\" hidden>Route to next trace</button><button id=\"run-button\" aria-pressed=\"false\" title=\"Keep running without holding the stick at its edge\">Run</button><div id=\"joystick\" aria-label=\"Drag to walk. Push farther to run.\"><div id=\"nub\"></div></div><div id=\"controls\"><button id=\"interact\">Inspect [E]</button><button id=\"scan\">Scan [Q]</button><button id=\"tune\">91.3 MHz</button><button id=\"light\">Light [F]</button><button id=\"tools-button\" aria-expanded=\"false\" aria-controls=\"tools-tray\">Tools</button></div><div id=\"tools-tray\" hidden></div><div id=\"footer\"><a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">Map data © OpenStreetMap contributors · ODbL</a> <span id=\"provider-credit\" hidden> · <a href=\"https://openfreemap.org/\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> / <a href=\"https://openmaptiles.org/\" target=\"_blank\" rel=\"noopener\">OpenMapTiles</a></span><span id=\"footer-context\"> · Fictional case · <span id=\"location\"></span></span></div>\n<aside id=\"panel\" hidden><div class=\"panel-top\"><span class=\"eyebrow\" id=\"panel-title\"></span><button id=\"panel-close\">Close</button></div><div id=\"panel-body\"></div></aside>\n<main id=\"desk\"><div class=\"desk-inner\"><div class=\"eyebrow\">An investigation in real streets</div><h1>Dead Air<br><i>Atlas.</i></h1><p class=\"intro\">At 02:17 the town lost an hour. The water towers kept broadcasting it.</p><p>Recover three impossible recordings. Match their radio frequencies, hold a steady light, then reconnect the relay. Bring someone who hears things you don’t.</p><div class=\"desk-actions\"><button class=\"primary\" id=\"start\" disabled>Receiving district…</button><button id=\"restart-case\">New case</button></div><p class=\"small\" id=\"district-info\"></p><div class=\"rule\"></div><div class=\"eyebrow\">Start from an address or town</div><form id=\"place-form\"><label>ADDRESS, TOWN OR PLACE NAME<input id=\"place-query\" type=\"search\" enterkeyhint=\"search\" value=\"Bayfield waterfront, Wisconsin\" placeholder=\"e.g. 42 N Broad St, Bayfield, WI\" autocomplete=\"off\" maxlength=\"120\"></label><div class=\"row\" style=\"margin-top:9px\"><button id=\"search-places\" type=\"button\">Find places</button><button id=\"offline\" type=\"button\">Use Bayfield</button></div></form><div id=\"place-results\" aria-live=\"polite\"></div><p class=\"small\">A 1.8 km district, built from OSM footprints and tags. Follow streets at its edge to load the next district, or travel between mapped water towers after restoring a relay.</p><details id=\"coop-options\"><summary>Investigate together · up to 4 players</summary><div class=\"row\"><button id=\"host\">Host a case</button><button id=\"join\">Join room</button><button id=\"leave\" hidden>Leave room</button></div><input id=\"room-code\" placeholder=\"Paste the complete room code\" aria-label=\"P2P room code\"><button id=\"copy-room\">Copy room code</button><p class=\"small\">The host shares its exact atlas and owns the case state. The party travels between districts together. Keep the host online and this tab active.</p></details><button id=\"sound\" style=\"margin-top:16px\">Sound on</button><details><summary>Field controls</summary><p class=\"small\">WASD / arrows walk · Shift runs · E inspects / repairs<br>Q scans · 1/2/3 tune · F light · R replaces a cell<br>M atlas · Tab notebook · Escape field desk<br>On phones, push the stick farther to run, or tap Run to keep running. The next-trace button follows the streets automatically. Tap it again to stop. Pinch the world or atlas to zoom; drag the atlas to pan. Wheel zooms.</p></details><div id=\"status\" role=\"status\"></div></div></main>\n<script type=\"module\">\nimport * as THREE from 'three';import {GLTFLoader} from 'three/addons/loaders/GLTFLoader.js';\nconst PARTS={\"osm-district\":\"https://ipfs-test.fangorn.network/ipfs/bafkreicfq65wiob467jrsd2ixi6rjthgq4xcrl2eu32qvhwyqksexdjyqu\",\"street-navigation\":\"https://ipfs-test.fangorn.network/ipfs/bafkreib7bhhtbm7jpjt35y6vmqx726bvexixw5qeffze6nwyduzotabivq\",\"water-tower\":\"https://ipfs-test.fangorn.network/ipfs/bafkreicasak273btddtjklytl6tmwzxbgdrwemuqxfgyw5bkvvqb2dhfpm\",\"osm-town-view\":\"https://ipfs-test.fangorn.network/ipfs/bafkreia7ibnrc6k7yflonzgxtqb7b5krc63cpl6thray4uhb5xzygdamnm\",\"dead-air-case\":\"https://ipfs-test.fangorn.network/ipfs/bafkreicjelxr3zjno4lxvbomoq5gfxdvody7vza67vj46kwjxqg2azh2si\",\"p2p-case-session\":\"https://ipfs-test.fangorn.network/ipfs/bafkreifj4d6zl3sn4opf7xexdyy5m4dnypnbnstzbd7kf2zmsnla7cabtm\",\"health\":\"https://ipfs-test.fan