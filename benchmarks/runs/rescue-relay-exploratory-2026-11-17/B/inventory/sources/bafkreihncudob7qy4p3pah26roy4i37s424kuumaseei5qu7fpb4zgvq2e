{"js":"// SPDX-License-Identifier: CC0-1.0\n// Renderer-independent sliding solver; substeps avoid tunneling at slow frame rates.\nexport function moveDisk(position,dx,dz,{colliders=[],bounds=48,radius=.32}={}){\n const steps=Math.max(1,Math.ceil(Math.hypot(dx,dz)/Math.max(.1,radius*.5)));\n const blocked=(x,z)=>Math.abs(x)>bounds-radius||Math.abs(z)>bounds-radius||colliders.some(c=>Math.hypot(x-c.x,z-c.z)<radius+c.radius);\n for(let i=0;i<steps;i++){if(!blocked(position.x+dx/steps,position.z))position.x+=dx/steps;if(!blocked(position.x,position.z+dz/steps))position.z+=dz/steps;}return position;\n}\nexport function attach(camera,{controls,heightAt=()=>0,colliders=[],bounds=48,speed=2.8,eyeHeight=1.68,canMove=()=>true,onStep=()=>{}}={}){\n let stride=0,distance=0,dead=false;camera.rotation.order='YXZ';\n return{get distance(){return distance;},update(dt){if(dead||!canMove())return;const input=controls.input,p=camera.position,old={x:p.x,z:p.z},n=Math.max(1,Math.hypot(input.x,input.z)),s=speed*(input.run?1.65:1)*Math.min(.1,Math.max(0,dt));\n moveDisk(p,input.x/n*s,input.z/n*s,{colliders,bounds});const moved=Math.hypot(p.x-old.x,p.z-old.z);distance+=moved;stride+=moved;\n if(stride>.75){stride%=.75;onStep({x:p.x,z:p.z,distance});}p.y=heightAt(p.x,p.z)+eyeHeight+Math.sin(distance*9)*Math.min(.025,moved);camera.rotation.set(input.pitch,input.yaw,0);},dispose(){dead=true;controls.clear();}};\n}\n"}