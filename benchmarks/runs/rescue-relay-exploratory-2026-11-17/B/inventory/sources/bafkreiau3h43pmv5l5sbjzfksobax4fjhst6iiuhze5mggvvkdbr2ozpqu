{"html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>The Quiet Engine</title><meta name=\"description\" content=\"Restore three resonators in a quiet architectural garden and wake its kinetic sculpture.\"><style>html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#142320;color:#e2e7d2;font:14px Arial}#boot{position:fixed;inset:0;display:grid;place-items:center;letter-spacing:.08em}</style><script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script></head><body><div id=\"boot\" role=\"status\">Opening the world…</div><script type=\"module\">\nimport * as THREE from 'three';\nconst PARTS = {\"expedition-shell\":\"https://ipfs-test.fangorn.network/ipfs/bafkreia7e3czgfc3ayugvo3q4kpilwmkta57qbvarttuhgkba6yz6inure\",\"world-resonance-garden\":\"https://ipfs-test.fangorn.network/ipfs/bafkreigpklhezupfxjsjqeqrjbvjiftp3kcc7onwu7bmteq5bjgqebxe3q\",\"inertial-drive\":\"https://ipfs-test.fangorn.network/ipfs/bafkreicyvzo3p3czhk444lflmtm3yepfaliw42qwcdsx5ngeqqptzu7t2y\",\"spring-tether\":\"https://ipfs-test.fangorn.network/ipfs/bafkreig7q52wnrcvdzq4ck64lmv26kcd7pxnr5wv2mcag7d3fx5bn5pszi\",\"trigger-zones\":\"https://ipfs-test.fangorn.network/ipfs/bafkreieid7xttemo3ty6gk47tmb37f7ht7oztmevsgorvhuok4b5ly3iuy\",\"ambient-motes\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiagmkd36o4beczofxhuwsr2lw4q46gbibisbrrsxniv75dn4iereu\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\",\"garden-caretaker\":\"https://ipfs-test.fangorn.network/ipfs/bafkreietucopaif37bgo4ktqziwtfvzec55kg3hqu5zxp4c4kk62gjc2ji\",\"resonator-crystal\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihbtjdiurh2brkfv3rhbawkrzp247ya35l7hgenci4gkpjsrpmlbq\",\"ph-ceramic-vase-03\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiemn7z3q7w2osgjvrm4iorzp5vipzm6byu46hdtw4tb45qkyt2drq\",\"ph-watering-can-metal-01\":\"https://ipfs-test.fangorn.network/ipfs/bafybeifx2pei2qcylqi4raph7iezooxfihyrhdxrerxf32dm2zzj5nzb7y\"};\nasync function logic(id){const r=await fetch(PARTS[id]);if(!r.ok)throw Error('Could not load '+id);return import('data:text/javascript;charset=utf-8,'+encodeURIComponent((await r.json()).js));}\nfunction plaque(text,color='#e7efc9'){\n const c=document.createElement('canvas');c.width=640;c.height=128;const x=c.getContext('2d');x.fillStyle='#132522df';x.fillRect(0,0,640,128);x.strokeStyle=color;x.lineWidth=3;x.strokeRect(2,2,636,124);x.font='30px Arial';x.textAlign='center';x.fillStyle=color;x.fillText(text,320,77);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,depthWrite:false}));s.scale.set(5.5,1.1,1);return s;\n}\nfunction bearing(a,b){const dx=b.x-a.x,dz=b.z-a.z;return ['N','NE','E','SE','S','SW','W','NW'][(Math.round(Math.atan2(dx,-dz)/(Math.PI/4))+8)%8]+' · '+Math.round(Math.hypot(dx,dz))+'m';}\nfunction material(color,emissive=0){return new THREE.MeshStandardMaterial({color,emissive,emissiveIntensity:.8,metalness:.5,roughness:.3});}\nfunction ring(parent,x,z,color,radius=2.2){const r=new THREE.Mesh(new THREE.TorusGeometry(radius,.075,10,64),new THREE.MeshBasicMaterial({color}));r.rotation.x=Math.PI/2;r.position.set(x,.2,z);parent.add(r);return r;}\n\ntry{\n const [shell,world,drive,tether,triggers,motes,touch]=await Promise.all(['expedition-shell','world-resonance-garden','inertial-drive','spring-tether','trigger-zones','ambient-motes','touch-controls'].map(logic));\n document.getElementById('boot').remove();\n shell.attach(document.body,{title:'The Quiet Engine',eyebrow:'AN IMPOSSIBLE GARDEN / A SMALL REPAIR',accent:'#d3c8ed',description:'The engine has forgotten how to turn. Three resonators have wandered away from their pedestals. Bring each crystal to its matching color, set it down, and see what the garden remembers.',controls:'WASD / ARROWS — wander · SHIFT — hurry\\nE — pick up / set down a crystal\\nSCROLL — camera distance · ESC — pause',parts:PARTS,assets:['garden-caretaker','resonator-crystal','ph-ceramic-vase-03','ph-watering-can-metal-01'],touch,cameraOffset:[0,12,18],build:async ctx=>{\n  const place=world.attach(ctx.scene),field=motes.attach(ctx.scene,{count:180,area:[58,58],height:[.6,10],color:0xd8eab6,size:.09,speed:.15});\n  const player=await ctx.model('garden-caretaker',1.8);ctx.scene.add(player);ctx.follow(player);\n  const colors=[0xf1b080,0x8fd3db,0xc9b1ed],names=['Amber','Tide','Lilac'],starts=[[-13,12],[0,-9],[13,11]],crystals=[],labels=[],springs=[];let held=null,occupied=[false,false,false],won=false,clock=0;const carry=new THREE.Vector3();\n  for(let i=0;i<3;i++){\n   const crystal=await ctx.model('resonator-crystal',1.8);crystal.traverse(o=>{if(o.isMesh){o.material=o.material.clone();if(o.name==='Crystal'){o.material.color.set(colors[i]);o.material.emissive.set(colors[i]);o.material.emissiveIntensity=.55;}}});crystal.userData.match=i;ctx.scene.add(crystal);crystals.push(crystal);\n   const marker=plaque(names[i].toUpperCase(), '#'+new THREE.Color(colors[i]).getHexString());ctx.scene.add(marker);labels.push(marker);\n   springs.push(tether.attach(crystal,{target:()=>held===crystal?carry:null,stiffness:35,damping:11,maxDistance:10,onBreak:()=>{held=null;ctx.message('The crystal slipped free.');}}));\n   const label=plaque(names[i].toUpperCase()+' / RESONATOR','#'+new THREE.Color(colors[i]).getHexString());label.position.copy(place.zones[i].position).setY(3.2);ctx.scene.add(label);\n  }\n  const vase=await ctx.model('ph-ceramic-vase-03',1.2,'max');vase.position.set(-5,.1,3);ctx.scene.add(vase);const can=await ctx.model('ph-watering-can-metal-01',1.4,'max');can.position.set(4.5,.1,2.5);ctx.scene.add(can);\n  const motor=drive.attach(player,{input:ctx.input,speed:5.2,acceleration:10,drag:10,radius:.4,bounds:place.bounds});\n  const zones=triggers.attach(place,{zones:place.zones,actors:()=>crystals.filter(c=>c!==held),accept:(actor,zone)=>actor.userData.match===zone.index,onEnter:(actor,zone,i)=>{ctx.tone([261.63,329.63,392][i],.7,'sine',.05);ctx.message(names[i]+' is home.');},onChange:state=>{occupied=state;place.setPower(state.filter(Boolean).length/3);},onComplete:()=>{won=true;ctx.message('The engine remembers the sun. Stay a while.');ctx.tone(523.25,1.5,'sine',.035);}});\n  function reset(){held=null;won=false;motor.stop();player.position.copy(place.spawn);player.position.y=.02;player.rotation.y=Math.PI;crystals.forEach((c,i)=>{c.position.set(starts[i][0],.15,starts[i][1]);springs[i].update(.01);});zones.update();occupied=zones.occupied;place.setPower(0);ctx.hud({value:'0 / 3',label:'resonators restored',objective:'Find a colored crystal. E picks it up.',secondary:'Each crystal belongs on the pedestal with the same color.'});}\n  return{reset,ambient(dt){place.update(dt);field.update(dt);clock+=dt;},update(dt){\n   motor.update(dt);carry.set(0,1.2,2.2).applyAxisAngle(new THREE.Vector3(0,1,0),player.rotation.y).add(player.position);\n   let nearest=null,distance=3.8;for(const c of crystals){const d=c.position.distanceTo(player.position);if(d<distance){nearest=c;distance=d;}}\n   if(ctx.consume('KeyE')){if(held){const c=held;held=null;c.position.y=.15;const zone=place.zones[c.userData.match];if(Math.hypot(c.position.x-zone.position.x,c.position.z-zone.position.z)<3.2)c.position.copy(zone.position).setY(.15);ctx.message('Resonator set down.');}else if(nearest){held=nearest;ctx.message('Carrying '+names[held.userData.match].toLowerCase()+'. Find its matching pedestal.');}else ctx.message('Get closer to a crystal to pick it up.');}\n   springs.forEach(s=>s.update(dt));zones.update();\n   labels.forEach((l,i)=>{l.position.copy(crystals[i].position).add(new THREE.Vector3(0,2.5,0));l.visible=!occupied[i]||held===crystals[i];});\n   const count=occupied.filter(Boolean).length;\n   ctx.hud({value:count+' / 3',label:won?'THE ENGINE IS AWAKE':'resonators restored',objective:won?'The engine remembers the sun.':held?'Carry '+names[held.userData.match].toLowerCase()+' to its matching pedestal.':nearest?'E · Pick up '+names[nearest.userData.match].toLowerCase():'Find a colored crystal. E picks it up.',secondary:won?'Take a quiet lap around the garden. You did a good thing.':held?bearing(player.position,place.zones[held.userData.match].position)+' to its pedestal · E sets it down.':'No timer. Look for the three colored rings.'});\n  },snapshot(){return{world:'the-quiet-engine',position:player.position.toArray(),held:held?.userData.match??null,occupied:[...occupied],complete:won,crystals:crystals.map(c=>c.position.toArray()),zones:place.zones.map(z=>z.position.toArray())};},dispose(){motor.dispose();springs.forEach(s=>s.dispose());zones.dispose();field.dispose();place.dispose();crystals.forEach(c=>c.removeFromParent());player.removeFromParent();}};\n }});\n}catch(e){document.getElementById('boot')?.replaceChildren(document.createTextNode('Could not load this world. Please reload.'));console.error(e);}\n\n</script></body></html>"}