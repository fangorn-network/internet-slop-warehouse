{"html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><title>Stillwater Field Station</title>\n<style>\n:root{color-scheme:dark;--ink:#e9e6d7;--soft:#b8c6b8;--gold:#d8b877}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#152321;color:var(--ink);font:14px/1.5 system-ui}canvas.world{display:block;touch-action:none;user-select:none;-webkit-user-select:none}button,input{font:inherit}button{border:1px solid #d1cfb359;background:#112622dd;color:var(--ink);border-radius:3px;padding:10px 16px;min-height:44px;cursor:pointer}button:hover{background:#435648}button:focus-visible,input:focus-visible{outline:2px solid var(--gold);outline-offset:3px}button:disabled{opacity:.45;cursor:wait}[hidden]{display:none!important}.eyebrow{font:11px ui-monospace,monospace;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}#shade{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,transparent 35%,#07110f65)}#hud{position:fixed;inset:22px 24px auto;display:flex;justify-content:space-between;gap:20px;pointer-events:none}#hud button{pointer-events:auto}#heading{font:30px Georgia,serif;line-height:1.1;margin-top:5px}#task{margin-top:8px;font-size:12px;max-width:310px;color:#d0d9c9;text-shadow:0 1px 5px #000}#bearing{font:11px ui-monospace,monospace;color:#d2d2b7;letter-spacing:.12em;text-align:right;margin-top:7px}#bag{position:fixed;bottom:28px;left:24px;display:flex;gap:8px}#bag span{padding:8px 12px;background:#10231dcc;border:1px solid #c7d0b733;font:11px ui-monospace,monospace;color:#b5c1b0}#bag span.found{color:var(--gold);border-color:#d8b87788}#reticle{position:fixed;left:50%;top:50%;width:4px;height:4px;border-radius:50%;background:#e9e6d7aa;pointer-events:none}#interact{position:fixed;left:50%;bottom:76px;transform:translateX(-50%);border-color:#d8b87780;max-width:90%;background:#14271be8}#toast{position:fixed;top:25%;left:50%;transform:translateX(-50%);max-width:460px;width:85%;text-align:center;background:#10231dea;padding:14px 22px;border-left:2px solid var(--gold);pointer-events:none}#toast:empty{display:none}#help{position:fixed;bottom:28px;right:24px;font:10px ui-monospace,monospace;text-align:right;color:#d2d2bd}#sound{margin-right:7px}.overlay{position:fixed;inset:0;z-index:20;display:flex;align-items:center;padding:clamp(24px,6vw,80px);background:linear-gradient(90deg,#0c1c19ef,#0c1c1966 65%,#0c1c1922);overflow:auto}.intro{max-width:540px}h1{font:400 clamp(46px,8vw,90px)/.98 Georgia,serif;letter-spacing:-.04em;margin:22px 0}h1 em{font-weight:400;color:#c8d4bc}p{color:var(--soft);max-width:440px}.primary{background:#d8b877;color:#192a20;border-color:#d8b877;font-weight:650;padding:13px 24px}.fine{font-size:11px;color:#9cae9e;margin-top:25px}.fine a{color:#bdcbb7}#loading{font:12px ui-monospace,monospace;color:var(--gold);margin:18px 0}.modal{position:fixed;inset:0;z-index:25;display:grid;place-items:center;background:#07110fab;padding:20px;overflow:auto}.panel{width:min(460px,100%);padding:28px;background:#142b25f7;border:1px solid #a5bca560;box-shadow:0 20px 70px #0008}h2{font:36px Georgia,serif;margin:10px 0 14px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between}.frequency{font:48px Georgia,serif;color:var(--gold);margin:24px 0 12px}input[type=range]{width:100%;accent-color:var(--gold);min-height:44px}meter{display:block;width:100%;height:12px;margin:10px 0 18px}.steps{padding-left:20px;color:#becdbd;font-size:13px}.steps li{padding:4px 0}#journal-freq{color:var(--gold)}#walkpad{position:fixed;bottom:32px;left:25px;z-index:12;width:108px;height:108px;border:1px solid #cdd4bd60;background:#203d2e66;border-radius:50%;touch-action:none;display:none}#nub{position:absolute;left:34px;top:34px;width:38px;height:38px;background:#cad2b077;border:1px solid #dfe5cd88;border-radius:50%}#look-note{display:none}body.playing #hud{display:flex}body:not(.playing) #hud,body:not(.playing) #bag,body:not(.playing) #help,body:not(.playing) #reticle{display:none}@media(pointer:coarse){body.playing #walkpad{display:block}#help{display:none}#look-note{display:block;font-size:11px}#bag{bottom:158px;left:20px;flex-wrap:wrap;max-width:180px}#bag span{font-size:10px;padding:5px 8px}#interact{bottom:45px;left:auto;right:20px;transform:none;max-width:45%;min-height:65px}#hud{inset:18px 16px auto;gap:8px}#heading{font-size:24px}#hud button{padding:8px 10px;font-size:11px}#task{font-size:11px;max-width:210px}#toast{top:26%}.panel{padding:22px}.overlay{align-items:center}h1{font-size:54px}}@media(max-height:500px){#bag{bottom:16px;left:150px}#heading{font-size:22px}#task{max-width:240px}#interact{bottom:25px}h1{font-size:46px}.fine{margin-top:12px}.overlay{padding:24px}.intro p{font-size:12px}.panel{padding:16px}h2{font-size:28px}.frequency{margin:6px 0;font-size:36px}}\n#toss{position:fixed;right:24px;bottom:90px;z-index:11}body:not(.playing) #toss{display:none}@media(pointer:coarse){#toss{right:20px;bottom:124px;min-height:50px}#interact{bottom:45px}}\n</style><script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script></head><body>\n<div id=\"shade\"></div><div id=\"hud\"><div><div class=\"eyebrow\">Stillwater / sector 04</div><div id=\"heading\">The valley went quiet.</div><div id=\"task\">Search the trails for fuel, a fuse, and the survey log.</div></div><div><button id=\"sound\" aria-pressed=\"false\">Sound off</button><button id=\"journal\">Field notes</button><div id=\"bearing\">N · 000°</div></div></div>\n<button id=\"toss\" title=\"Toss a stone (Space)\">Toss stone</button><div id=\"bag\"><span data-item=\"fuel\">FUEL —</span><span data-item=\"fuse\">FUSE —</span><span data-item=\"log\">LOG —</span></div><div id=\"reticle\"></div><button id=\"interact\" hidden></button><div id=\"toast\" role=\"status\"></div><div id=\"help\">WASD walk · Shift hurry<br>Right-drag look · E interact · Space toss · J field notes · Esc pause</div><div id=\"walkpad\" aria-label=\"Walk\"><div id=\"nub\"></div></div>\n<div id=\"intro\" class=\"overlay\"><div class=\"intro\"><div class=\"eyebrow\">A forest playground / no hurry</div><h1>Stillwater<br><em>Field Station.</em></h1><p>A patch of forest full of small things to try. Wake the generator. Turn the radio dial. Toss a stone at the clearing bells. Take a trail just to see where it goes.</p><p id=\"look-note\">Left thumb walks. Drag the world with your right thumb to look. Tap nearby objects to use them.</p><div id=\"loading\" role=\"status\">Unpacking the forest…</div><button id=\"start\" class=\"primary\" disabled>Go wandering →</button><div class=\"fine\">Scanned props &amp; lighting by <a href=\"https://polyhaven.com\" target=\"_blank\" rel=\"noopener\">Poly Haven</a> · CC0<br>A solo world built from reusable warehouse parts.</div></div></div>\n<div id=\"notes\" class=\"modal\" hidden><div class=\"panel\"><div class=\"eyebrow\">Survey crew / field notes</div><h2>Small things to try.</h2><ol class=\"steps\"><li>Follow the trails and inspect the detailed field props.</li><li>Switch the generator on and off. Listen as the shelter comes alive.</li><li>Turn the radio dial and listen for a clear carrier.</li><li>Toss stones at the brass bells beside the station. Each rings a different note.</li><li>Wander out to the creek, maintenance cache, or survey overlook. Collect things if you feel like it.</li></ol><p id=\"journal-freq\">The station frequency is recorded in the survey log.</p><p class=\"fine\">No enemies. No timer. Nothing here is mandatory. This playground resets when closed.</p><button id=\"notes-close\" class=\"primary\">Back to the forest</button></div></div>\n<div id=\"radio\" class=\"modal\" hidden><div class=\"panel\"><div class=\"eyebrow\">Stillwater / relay receiver</div><h2>Tune the valley.</h2><p id=\"radio-note\">Tune the carrier, then transmit.</p><div class=\"frequency\"><output id=\"frequency\">88.0</output> <small style=\"font:12px ui-monospace\">MHz</small></div><label for=\"dial\">Frequency</label><input id=\"dial\" type=\"range\" min=\"88\" max=\"96\" step=\".1\" value=\"88\"><label for=\"signal\">Signal strength</label><meter id=\"signal\" min=\"0\" max=\"1\" value=\"0\"></meter><div class=\"row\"><button id=\"transmit\" class=\"primary\">Ping the relay</button><button id=\"radio-close\">Step away</button></div><p id=\"radio-feedback\" role=\"status\"></p></div></div>\n<script type=\"module\">\nimport * as T from 'three';import {RGBELoader} from 'three/addons/loaders/RGBELoader.js';\nconst PARTS={\"ph-fern-02\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiaiqde2cklwce4vxh6vdns5alvsvekssserm25ehozh4citr5lvdm\",\"ph-tree-stump-01\":\"https://ipfs-test.fangorn.network/ipfs/bafybeifxfbh4to2fqojmm3ye5lag7idcicd73g752bdn5g6kosq4elwnoy\",\"ph-portable-generator\":\"https://ipfs-test.fangorn.network/ipfs/bafybeigbuud63rl357ytamluzas6vbvi3gs5anbhpl4accw7vbfjdgafs4\",\"ph-vintage-radio-transceiver\":\"https://ipfs-test.fangorn.network/ipfs/bafybeibm4ewepai7gdoib76nhesatbldb6wf2ytoqgmaqa2xba355awpaq\",\"ph-dead-tree-trunk\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiatstv3aafuhdw77fkrkjy5e4sqfsdetvukd7kpld5srio7kry65a\",\"ph-misty-pines\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiaial2qntopfpajt66peli2vbbpamq6hk3v5e3xwa3nrsgjgtzmke\",\"ph-forest-floor-normal\":\"https://ipfs-test.fangorn.network/ipfs/bafybeifitmj6bjn7lyhpinsoihtjt3hybucdn7y3bpxxq3fubchplkj4se\",\"ph-forest-floor-roughness\":\"https://ipfs-test.fangorn.network/ipfs/bafkreibq3c2wua6xwew2c32yaenwovtcuqhfryony5ubdgs7aolicqafrq\",\"world-prop-kit\":\"https://ipfs-test.fangorn.network/ipfs/bafkreieaqmu3xmvmy7jowft2lpzpk5cyxhnrk7rj5sssc7ja5asj6ejf44\",\"trail-walker\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihncudob7qy4p3pah26roy4i37s424kuumaseei5qu7fpb4zgvq2e\",\"signal-trail\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiab5y7bfx4gj6ednmstwekkomqfm46ie6rxxwt4jdl5ajiqlrwixa\",\"woodland-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiauoe7vvh7himeviyejhenompk72jp2tj3n2vngozsvmfocxlrezq\",\"stillwater-world\":\"https://ipfs-test.fangorn.network/ipfs/bafkreievdwv6fosf6i5upvwxv4iguf5o7tc67x7si75qezobmhtyhxe3di\",\"stillwater-world-guide\":\"https://ipfs-test.fangorn.network/ipfs/bafkreid4t42naird3bx436wbdmxmzphfairzfnicf6y5mfuy3fqap32j7m\",\"fps-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreifdkkwxdfthnenma3vyoypfvyr6zj5igr3ltzlycmg2wx2h3gtieu\",\"northwoods-trees\":\"https://ipfs-test.fangorn.network/ipfs/bafkreih46evdiqaverw2vnxf7dnrxfeasw63qbjm7jdhksfcpp77vdspxq\",\"winter-pine-bark\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiedolt5byg7qag763feifuh5oin6xl6s6cf4cghfkzfq6gjcolod4\",\"forest-ground-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafybeidjlqgtwmhoy4hjkskxgreaug2x2kg6f6vmwtt3powbhemzzw33ua\",\"mossy-rocks\":\"https://ipfs-test.fangorn.network/ipfs/bafybeihpw3wzbwhzj7w4em5zpart4camqcvz6bxcnhu7s52f5sf73c42kq\",\"planks-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafkreieuqm763jcoajnjcopxwvzd5kcoj4bfru5vje42phqqcpatgcc6fe\",\"ph-woodentable-01\":\"https://ipfs-test.fangorn.network/ipfs/bafybeifggcqvavttu5xp3uatcihhfixl3zut3llievtkfjrh5c52lbnoza\",\"ph-wooden-crate-01\":\"https://ipfs-test.fangorn.network/ipfs/bafybeihdxbef66b7io3dyibzoh2nfrfzsmhuexvlkfqzmnhpux7xxs5ydu\",\"ph-vintage-oil-lamp\":\"https://ipfs-test.fangorn.network/ipfs/bafybeigpbkkw2wn3daaf4ggfddu6aexqj7gj7nyjjvvl3nbklhidvsqozy\",\"field-pine-spray\":\"https://ipfs-test.fangorn.network/ipfs/bafybeid3m7xj6lgi7s6t26ii22qgtkfv6kk75r5r7k3olksw75tbladyhy\",\"trail-playground\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiagfukh6lbewfifog3t6csr4yimiwjmczfctalzjiacy3cawwmuoy\"},$=id=>document.getElementById(id);let running=false,ready=false,muted=true,toastTime=0,dead=false;const modules={},systems=[];let renderer,scene,camera,controls,walker,rules,sound,props,world,stationLight,beacon,sky,toys;let bellMeshes=[],stoneMeshes=new Map();const debug={};window.stillwaterDebug=debug;\nconst modal=()=>!$('notes').hidden||!$('radio').hidden;\nconst toast=message=>{$('toast').textContent=message;toastTime=6;};\nconst heightAt=(x,z)=>.48*Math.sin(x*.075)*Math.cos(z*.06)+.24*Math.sin(z*.13+x*.04);\nasync function module(id){const res=await fetch(PARTS[id]);if(!res.ok)throw Error('Cannot load '+id);const {js}=await res.json();return import('data:text/javascript;charset=utf-8,'+encodeURIComponent(js));}\nfunction resume(){if(!ready)return;renderer.domElement.focus({preventScroll:true});running=true;document.body.classList.add('playing');$('intro').hidden=true;controls.clear();if(!muted)sound.start();}\nfunction pause(){if(!running)return;running=false;controls.clear();sound.pause();if(document.pointerLockElement)void document.exitPointerLock();$('intro').hidden=false;$('start').textContent='Return to the valley →';$('loading').textContent='The forest will wait.';}\nfunction closeModal(id){renderer.domElement.focus({preventScroll:true});$(id).hidden=true;controls.clear();sound?.tune(88,0);}\nfunction openModal(id){$(id).hidden=false;controls.clear();if(document.pointerLockElement)void document.exitPointerLock();}\nfunction refreshRadio(){rules.tune(Number($('dial').value));$('frequency').value=rules.state.frequency.toFixed(1);$('signal').value=rules.signal;if(sound)sound.tune(rules.state.frequency,rules.signal);}\nfunction interact(){if(!running||modal())return;const focus=rules.focus;if(!focus)return;if(focus.id==='radio'&&rules.state.power){$('radio-note').textContent='Turn the dial. The valley relay is clearest at 91.6 MHz. There is no wrong answer.';$('dial').value=rules.state.frequency;refreshRadio();openModal('radio');return;}rules.use(focus.id);}\ntry{\n const ids=['fps-controls','trail-walker','world-prop-kit','signal-trail','woodland-sound','northwoods-trees','trail-playground'];await Promise.all(ids.map(async id=>modules[id]=await module(id)));world=await(await fetch(PARTS['stillwater-world'])).json();\n renderer=new T.WebGLRenderer({antialias:true,powerPreference:'high-performance'});const gl=renderer.getContext(),renderInfo=gl.getExtension('WEBGL_debug_renderer_info'),software=renderInfo&&/swiftshader|llvmpipe|software/i.test(gl.getParameter(renderInfo.UNMASKED_RENDERER_WEBGL));const mobileQuality=matchMedia('(pointer:coarse)').matches||software;renderer.setPixelRatio(Math.min(devicePixelRatio,software?.6:mobileQuality?1.15:1.4));renderer.setSize(innerWidth,innerHeight);renderer.domElement.className='world';renderer.domElement.tabIndex=0;document.body.prepend(renderer.domElement);renderer.toneMapping=T.ACESFilmicToneMapping;renderer.toneMappingExposure=1.1;renderer.shadowMap.enabled=!mobileQuality;renderer.shadowMap.type=T.PCFSoftShadowMap;\n scene=new T.Scene();scene.background=new T.Color('#899b91');scene.fog=new T.FogExp2('#8eaa9d',.020);camera=new T.PerspectiveCamera(66,innerWidth/innerHeight,.08,200);camera.position.set(world.spawn.x,heightAt(world.spawn.x,world.spawn.z)+1.68,world.spawn.z);\n const hemi=new T.HemisphereLight('#d3e3d5','#384338',1.3);scene.add(hemi);const sun=new T.DirectionalLight('#ffe2af',2.6);sun.position.set(-25,35,-25);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);Object.assign(sun.shadow.camera,{left:-40,right:40,top:40,bottom:-40,near:1,far:100});sun.shadow.bias=-.00025;sun.shadow.normalBias=.04;scene.add(sun);\n const textureLoader=new T.TextureLoader(),textures=await Promise.all(['forest-ground-texture','ph-forest-floor-normal','ph-forest-floor-roughness','winter-pine-bark','field-pine-spray','planks-texture'].map(id=>textureLoader.loadAsync(PARTS[id])));const [ground,normal,rough,bark,needles,planks]=textures;\n [ground,bark,needles,planks].forEach(t=>t.colorSpace=T.SRGBColorSpace);[ground,normal,rough].forEach(t=>{t.wrapS=t.wrapT=T.RepeatWrapping;t.repeat.set(32,32);t.anisotropy=Math.min(8,renderer.capabilities.getMaxAnisotropy());});planks.wrapS=planks.wrapT=T.RepeatWrapping;planks.repeat.set(3,2);\n const terrain=new T.PlaneGeometry(140,140,140,140);terrain.rotateX(-Math.PI/2);const pos=terrain.attributes.position;for(let i=0;i<pos.count;i++)pos.setY(i,heightAt(pos.getX(i),pos.getZ(i)));terrain.computeVertexNormals();const groundMesh=new T.Mesh(terrain,new T.MeshStandardMaterial({map:ground,normalMap:normal,roughnessMap:rough,roughness:1,normalScale:new T.Vector2(.6,.6),color:'#b6c3a3'}));groundMesh.receiveShadow=true;scene.add(groundMesh);\n sky=await new RGBELoader().loadAsync(PARTS['ph-misty-pines']);sky.mapping=T.EquirectangularReflectionMapping;scene.environment=sky;scene.environmentIntensity=.65;scene.background=sky;scene.backgroundBlurriness=.12;scene.backgroundIntensity=.7;\n props=modules['world-prop-kit'].attach(scene,{parts:PARTS,heightAt,onProgress:id=>$('loading').textContent='Unpacking '+id.replaceAll('-',' ')+'…'});systems.push(props);\n const instances=[];let seed=world.seed;const rand=()=>((seed=Math.imul(seed,1664525)+1013904223>>>0)/4294967296);\n const pathDistance=(x,z)=>Math.min(...world.paths.flatMap(path=>path.slice(1).map((b,i)=>{const a=path[i],dx=b[0]-a[0],dz=b[1]-a[1],t=Math.max(0,Math.min(1,((x-a[0])*dx+(z-a[1])*dz)/(dx*dx+dz*dz)));return Math.hypot(x-a[0]-t*dx,z-a[1]-t*dz);})));const clearing=(x,z)=>Math.hypot(x,z)<8||world.sites.some(s=>Math.hypot(s.x-x,s.z-z)<4)||pathDistance(x,z)<2.6;\n // Instanced forest and understory: real depth around the trail, not a backdrop.\n for(let i=0;i<3;i++){const tree=modules['northwoods-trees'].makeTree({species:'pine',seed:30+i,snow:0,height:14,barkTexture:bark,needleTexture:needles,detail:.65});props.register('pine-'+i,tree);const places=[];for(let n=0;n<(mobileQuality?32:48);n++){const x=(rand()-.5)*120,z=(rand()-.5)*120;if(!clearing(x,z)){places.push({x,z,height:11+rand()*12,yaw:rand()*6.28});if(Math.abs(x)<48&&Math.abs(z)<48)props.colliders.push({x,z,radius:.3});}}await props.scatter('pine-'+i,places,{castShadow:true});}\n const ferns=[];for(let i=0;i<(mobileQuality?64:110);i++){const x=(rand()-.5)*92,z=(rand()-.5)*92;if(!clearing(x,z))ferns.push({x,z,height:.35+rand()*.5,yaw:rand()*6.28});}await props.scatter('ph-fern-02',ferns);\n const rocks=[];for(let i=0;i<(mobileQuality?4:7);i++){const x=(rand()-.5)*95,z=(rand()-.5)*95;if(!clearing(x,z)){rocks.push({x,z,height:.6+rand()*1.4,yaw:rand()*6.28});props.colliders.push({x,z,radius:1});}}await props.scatter('mossy-rocks',rocks);\n for(const [id,x,z,height] of [['ph-dead-tree-trunk',-25,-14,5],['ph-dead-tree-trunk',24,-19,4],['ph-tree-stump-01',-20,-10,1.1],['ph-tree-stump-01',18,-15,.8],['ph-tree-stump-01',-3,-33,1.3]])await props.place(id,{x,z,height,yaw:rand()*6.28,radius:.65});\n // Trail ribbons follow the same terrain sampler used by the walking controller.\n const trailTexture=ground.clone();trailTexture.repeat.set(1,1);trailTexture.needsUpdate=true;const trailMat=new T.MeshStandardMaterial({map:trailTexture,color:'#9e8f70',roughness:1});\n for(const route of world.paths){const curve=new T.CatmullRomCurve3(route.map(([x,z])=>new T.Vector3(x,0,z)),false,'catmullrom',.1),points=curve.getPoints(120),p=[],uv=[],idx=[];for(let i=0;i<points.length;i++){const v=points[i],tangent=curve.getTangent(i/(points.length-1)),side=new T.Vector3(-tangent.z,0,tangent.x).multiplyScalar(.85);for(const sign of [-1,1]){const x=v.x+side.x*sign,z=v.z+side.z*sign;p.push(x,heightAt(x,z)+.025,z);uv.push(sign===-1?0:1,i*.13);}if(i<points.length-1){const n=i*2;idx.push(n,n+1,n+2,n+1,n+3,n+2);}}const g=new T.BufferGeometry();g.setAttribute('position',new T.Float32BufferAttribute(p,3));g.setAttribute('uv',new T.Float32BufferAttribute(uv,2));g.setIndex(idx);g.computeVertexNormals();const m=new T.Mesh(g,trailMat);m.receiveShadow=true;scene.add(m);}\n // A narrow reflective creek gives the west trail a different light and sound.\n const waterP=[],waterUV=[],waterIndex=[];for(let i=0;i<=90;i++){const z=