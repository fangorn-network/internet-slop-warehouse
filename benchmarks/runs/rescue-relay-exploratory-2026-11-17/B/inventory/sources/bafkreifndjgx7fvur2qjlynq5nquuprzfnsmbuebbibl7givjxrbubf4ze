{"js":"// CC0-1.0. Procedural, texture-free PBR firearms for first-person and world use: assault rifle, pump shotgun,\n// bolt-action rifle, plus scope, silencer and holographic sight that mount themselves.\n// Metres, +Y up, barrel toward -Z, origin at the firing hand. Named nodes: \"muzzle\" (flash point, moves with a\n// silencer), \"sight\" (eye line for aiming down sights, moves to a fitted optic), \"rail\", \"pump\", \"bolt\", \"reticle\".\nimport * as THREE from 'three';\n\nexport const KINDS = ['assault-rifle', 'shotgun', 'bolt-rifle'];\nexport const ATTACHMENTS = ['scope', 'silencer', 'holo'];\nexport const FITS = { 'assault-rifle': ['silencer', 'holo'], shotgun: ['silencer'], 'bolt-rifle': ['scope'] };\n\nexport function defaultMaterials() {\n    const m = (color, metalness, roughness, extra = {}) => new THREE.MeshStandardMaterial({ color, metalness, roughness, ...extra });\n    return {\n        steel: m(0x1d1e20, 0.7, 0.48),\n        parkerized: m(0x30312d, 0.45, 0.62),\n        polymer: m(0x1c1d1e, 0, 0.72),\n        wood: m(0x553723, 0, 0.55),\n        rubber: m(0x111111, 0, 0.95),\n        glass: m(0x0b1824, 0.3, 0.04),\n        reticle: m(0xff2a1a, 0, 1, { emissive: 0xff2a1a, emissiveIntensity: 3 }),\n    };\n}\n\nfunction kit(mats) {\n    const g = new THREE.Group();\n    const add = (mesh, x, y, z, rx = 0, ry = 0, rz = 0, parent = g) => { mesh.position.set(x, y, z); mesh.rotation.set(rx, ry, rz); mesh.castShadow = true; mesh.receiveShadow = true; parent.add(mesh); return mesh; };\n    const box = (w, h, d, mat, x, y, z, rx, ry, rz, parent) => add(new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mats[mat]), x, y, z, rx, ry, rz, parent);\n    // Cylinder along Z from z0 (radius r0) to z1 (radius r1). Rotating +90deg about X puts the cylinder's top at +Z.\n    const tube = (r0, z0, z1, mat, x, y, parent, r1 = r0, seg = 16) => add(new THREE.Mesh(new THREE.CylinderGeometry(z1 > z0 ? r1 : r0, z1 > z0 ? r0 : r1, Math.abs(z1 - z0), seg), mats[mat]), x, y, (z0 + z1) / 2, Math.PI / 2, 0, 0, parent);\n    const node = (name, x, y, z, parent = g) => { const o = new THREE.Object3D(); o.name = name; o.position.set(x, y, z); parent.add(o); return o; };\n    return { g, box, tube, node };\n}\n\nfunction assaultRifle(mats) {\n    const { g, box, tube, node } = kit(mats);\n    box(0.058, 0.085, 0.40, 'parkerized', 0, 0.035, -0.08);              // receiver\n    box(0.022, 0.012, 0.34, 'steel', 0, 0.084, -0.11);                  // top rail\n    for (let i = 0; i < 14; i++) box(0.026, 0.004, 0.012, 'steel', 0, 0.092, 0.05 - i * 0.024);\n    box(0.066, 0.072, 0.30, 'polymer', 0, 0.032, -0.43);                // handguard\n    for (let i = 0; i < 5; i++) box(0.068, 0.012, 0.03, 'rubber', 0, 0.028, -0.33 - i * 0.05);\n    tube(0.011, -0.58, -0.80, 'steel', 0, 0.035);                         // barrel\n    tube(0.016, -0.80, -0.85, 'steel', 0, 0.035, undefined, 0.016, 8);   // muzzle brake\n    box(0.006, 0.055, 0.012, 'steel', 0, 0.09, -0.555);                  // front sight post\n    box(0.03, 0.026, 0.02, 'steel', 0, 0.1, 0.07);                       // rear sight\n    box(0.014, 0.012, 0.03, 'steel', 0.035, 0.06, 0.02);                 // charging handle\n    // curved magazine\n    [[0, -0.12], [0.18, -0.13], [0.36, -0.145]].forEach(([a, z], i) => box(0.026, 0.07, 0.07, 'polymer', 0, -0.035 - i * 0.062, z - i * 0.012, a));\n    box(0.032, 0.11, 0.045, 'polymer', 0, -0.06, 0.035, 0.32);           // pistol grip\n    box(0.006, 0.006, 0.07, 'steel', 0, -0.02, -0.02);                   // trigger guard\n    box(0.004, 0.02, 0.006, 'steel', 0, -0.005, -0.01, 0.3);             // trigger\n    tube(0.016, 0.12, 0.30, 'steel', 0, 0.03);                            // buffer tube\n    box(0.046, 0.11, 0.17, 'polymer', 0, 0.0, 0.3);                       // stock\n    box(0.048, 0.13, 0.02, 'rubber', 0, -0.005, 0.39);                    // butt pad\n    node('rail', 0, 0.09, -0.06); node('muzzle', 0, 0.035, -0.86); node('sight', 0, 0.112, 0.08);\n    return g;\n}\n\nfunction shotgun(mats) {\n    const { g, box, tube, node } = kit(mats);\n    box(0.054, 0.085, 0.24, 'steel', 0, 0.03, -0.05);                     // receiver\n    box(0.004, 0.01, 0.2, 'steel', 0, 0.077, -0.05);\n    tube(0.013, -0.17, -0.70, 'steel', 0, 0.055);                         // barrel\n    tube(0.012, -0.17, -0.62, 'steel', 0, 0.016);                         // magazine tube\n    tube(0.012, -0.62, -0.635, 'steel', 0, 0.016, undefined, 0.013);\n    const pump = new THREE.Group(); pump.name = 'pump'; g.add(pump);\n    box(0.062, 0.05, 0.2, 'wood', 0, 0.015, -0.37, 0, 0, 0, pump);       // pump forend\n    for (let i = 0; i < 6; i++) box(0.064, 0.004, 0.006, 'polymer', 0, 0.03, -0.3 - i * 0.025, 0, 0, 0, pump);\n    const bead = new THREE.Mesh(new THREE.SphereGeometry(0.004, 8, 6), mats.steel); bead.position.set(0, 0.072, -0.69); g.add(bead);\n    box(0.006, 0.006, 0.08, 'steel', 0, -0.02, 0.0);                      // trigger guard\n    box(0.04, 0.065, 0.11, 'wood', 0, -0.02, 0.11, -0.25);               // wrist\n    box(0.046, 0.11, 0.26, 'wood', 0, -0.045, 0.27, -0.12);              // stock\n    box(0.048, 0.125, 0.02, 'rubber', 0, -0.06, 0.405, -0.12);          // butt pad\n    node('rail', 0, 0.075, -0.05); node('muzzle', 0, 0.055, -0.71); node('sight', 0, 0.082, 0.05);\n    return g;\n}\n\nfunction boltRifle(mats) {\n    const { g, box, tube, node } = kit(mats);\n    box(0.05, 0.055, 0.52, 'wood', 0, 0.01, -0.33);                       // forend\n    box(0.052, 0.08, 0.2, 'wood', 0, 0.0, 0.0);                           // action body\n    box(0.04, 0.075, 0.08, 'wood', 0, -0.035, 0.13, 0.35);               // wrist / grip\n    box(0.048, 0.12, 0.28, 'wood', 0, -0.045, 0.3, -0.08);               // buttstock\n    box(0.05, 0.13, 0.02, 'rubber', 0, -0.055, 0.445, -0.08);\n    tube(0.017, 0.11, -0.13, 'steel', 0, 0.05);                           // receiver\n    tube(0.0105, -0.13, -0.78, 'steel', 0, 0.05, undefined, 0.009);       // tapered barrel\n    box(0.005, 0.03, 0.01, 'steel', 0, 0.07, -0.76);                      // front post\n    box(0.006, 0.006, 0.08, 'steel', 0, -0.03, -0.02);                    // trigger guard\n    box(0.03, 0.01, 0.07, 'steel', 0, -0.04, -0.06);                      // floorplate\n    const bolt = new THREE.Group(); bolt.name = 'bolt'; bolt.position.set(0, 0.05, 0.07); g.add(bolt);\n    tube(0.009, -0.05, 0.05, 'steel', 0, 0, bolt);\n    const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.005, 0.005, 0.06, 8), mats.steel); handle.rotation.z = Math.PI / 2; handle.position.set(0.032, -0.005, 0.03); bolt.add(handle);\n    const knob = new THREE.Mesh(new THREE.SphereGeometry(0.009, 10, 8), mats.steel); knob.position.set(0.062, -0.01, 0.03); bolt.add(knob);\n    node('rail', 0, 0.068, -0.01); node('muzzle', 0, 0.05, -0.79); node('sight', 0, 0.082, 0.06);\n    return g;\n}\n\nexport function buildAttachment(kind, mats = defaultMaterials()) {\n    const { g, box, tube, node } = kit(mats);\n    g.name = kind;\n    if (kind === 'scope') {\n        tube(0.013, 0.09, -0.11, 'steel', 0, 0.04);                       // main tube\n        tube(0.013, -0.11, -0.17, 'steel', 0, 0.04, undefined, 0.022);    // objective bell\n        tube(0.022, -0.17, -0.19, 'steel', 0, 0.04);\n        tube(0.013, 0.09, 0.13, 'steel', 0, 0.04, undefined, 0.019);      // ocular bell\n        tube(0.019, 0.13, 0.17, 'rubber', 0, 0.04);\n        const top = new THREE.Mesh(new THREE.CylinderGeometry(0.009, 0.009, 0.022, 12), mats.steel); top.position.set(0, 0.062, -0.01); g.add(top);\n        const side = top.clone(); side.rotation.z = Math.PI / 2; side.position.set(0.022, 0.04, -0.01); g.add(side);\n        for (const z of [0.05, -0.07]) { box(0.03, 0.03, 0.018, 'steel', 0, 0.02, z); box(0.024, 0.01, 0.02, 'steel', 0, 0.004, z); }\n        for (const z of [-0.191, 0.171]) { const lens = new THREE.Mesh(new THREE.CircleGeometry(z < 0 ? 0.02 : 0.017, 20), mats.glass); lens.position.set(0, 0.04, z); lens.rotation.y = z < 0 ? Math.PI : 0; g.add(lens); }\n        node('sight', 0, 0.04, 0.1);\n    } else if (kind === 'holo') {\n        box(0.032, 0.012, 0.07, 'polymer', 0, 0.006, 0);                  // base\n        box(0.034, 0.014, 0.045, 'polymer', 0, 0.018, 0.012);             // battery housing\n        for (const x of [-0.015, 0.015]) box(0.004, 0.04, 0.03, 'polymer', x, 0.04, -0.02);\n        box(0.034, 0.004, 0.032, 'polymer', 0, 0.06, -0.02);              // hood\n        const glass = new THREE.Mesh(new THREE.PlaneGeometry(0.026, 0.032), mats.glass.clone()); glass.material.transparent = true; glass.material.opacity = 0.25; glass.position.set(0, 0.042, -0.03); g.add(glass);\n        const dot = new THREE.Mesh(new THREE.RingGeometry(0.0035, 0.0045, 24), mats.reticle); dot.name = 'reticle'; dot.position.set(0, 0.042, -0.029); g.add(dot);\n        const pip = new THREE.Mesh(new THREE.CircleGeometry(0.0007, 8), mats.reticle); pip.position.set(0, 0.042, -0.0289); g.add(pip);\n        node('sight', 0, 0.042, 0.05);\n    } else if (kind === 'silencer') {\n        tube(0.018, 0, -0.19, 'polymer', 0, 0);\n        tube(0.0185, 0, -0.012, 'steel', 0, 0); tube(0.0185, -0.18, -0.19, 'steel', 0, 0);\n        node('muzzle', 0, 0, -0.195);\n    } else throw new Error('Unknown attachment ' + kind);\n    return g;\n}\n\n/** Build a gun with attachments fitted. Unknown or unfitting attachments are ignored. */\nexport function build(kind, { attachments = [], materials = defaultMaterials() } = {}) {\n    const make = { 'assault-rifle': assaultRifle, shotgun, 'bolt-rifle': boltRifle }[kind];\n    if (!make) throw new Error('Unknown firearm ' + kind);\n    const g = make(materials); g.name = kind;\n    const muzzle = g.getObjectByName('muzzle'), sight = g.getObjectByName('sight'), rail = g.getObjectByName('rail');\n    for (const a of attachments) {\n        if (!FITS[kind].includes(a)) continue;\n        const part = buildAttachment(a, materials);\n        if (a === 'silencer') {\n            part.position.copy(muzzle.position); g.add(part);\n            muzzle.position.z += part.getObjectByName('muzzle').position.z;\n        } else {\n            part.position.copy(rail.position); g.add(part);\n            sight.position.copy(rail.position).add(part.getObjectByName('sight').position);\n        }\n        part.getObjectByName('muzzle')?.removeFromParent();\n        part.getObjectByName('sight')?.removeFromParent();\n    }\n    g.userData = { kind, attachments: attachments.filter((a) => FITS[kind].includes(a)) };\n    return g;\n}\n\n/** Mount a firearm on `parent` (a camera rig, a hand bone, a rack). */\nexport function attach(parent, { kind = 'assault-rifle', attachments = [], materials = defaultMaterials() } = {}) {\n    let object = build(kind, { attachments, materials }); parent.add(object);\n    return {\n        get object() { return object; },\n        set(nextKind = kind, nextAttachments = attachments) { object.removeFromParent(); kind = nextKind; attachments = nextAttachments; object = build(kind, { attachments, materials }); parent.add(object); return object; },\n        update() {},\n        dispose() { object.removeFromParent(); object.traverse((o) => o.geometry?.dispose()); },\n    };\n}"}