{"html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Dead Letter Lake</title><meta name=\"description\" content=\"A courier skiff, a luminous flooded grove, and eight letters nobody is waiting for.\"><style>html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#142320;color:#e2e7d2;font:14px Arial}#boot{position:fixed;inset:0;display:grid;place-items:center;letter-spacing:.08em}</style><script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script></head><body><div id=\"boot\" role=\"status\">Opening the world…</div><script type=\"module\">\nimport * as THREE from 'three';\nconst PARTS = {\"expedition-shell\":\"https://ipfs-test.fangorn.network/ipfs/bafkreia7e3czgfc3ayugvo3q4kpilwmkta57qbvarttuhgkba6yz6inure\",\"world-lantern-marsh\":\"https://ipfs-test.fangorn.network/ipfs/bafkreic3ypvrj5s65tz2yihyfztyk2dmlri6raeitr7du7onhjzbtd466a\",\"inertial-drive\":\"https://ipfs-test.fangorn.network/ipfs/bafkreicyvzo3p3czhk444lflmtm3yepfaliw42qwcdsx5ngeqqptzu7t2y\",\"checkpoint-course\":\"https://ipfs-test.fangorn.network/ipfs/bafkreifwrvocc6rrnwhfn7nbghgzoubbcxqq5czbygbz3s7wvo3hguopky\",\"ambient-motes\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiagmkd36o4beczofxhuwsr2lw4q46gbibisbrrsxniv75dn4iereu\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\",\"courier-skiff\":\"https://ipfs-test.fangorn.network/ipfs/bafkreigtxotugi23ih7jj7lew4s4fb47iq27mjnql3rxgjcx7uwqzuwxvi\",\"signal-buoy\":\"https://ipfs-test.fangorn.network/ipfs/bafkreigt3m5w2fmklcgqtvcufhyonvnjoq4u3n7bdnp5np5pebhsh5bjs4\",\"ph-vintage-oil-lamp\":\"https://ipfs-test.fangorn.network/ipfs/bafybeigpbkkw2wn3daaf4ggfddu6aexqj7gj7nyjjvvl3nbklhidvsqozy\"};\nasync function logic(id){const r=await fetch(PARTS[id]);if(!r.ok)throw Error('Could not load '+id);return import('data:text/javascript;charset=utf-8,'+encodeURIComponent((await r.json()).js));}\nfunction plaque(text,color='#e7efc9'){\n const c=document.createElement('canvas');c.width=640;c.height=128;const x=c.getContext('2d');x.fillStyle='#132522df';x.fillRect(0,0,640,128);x.strokeStyle=color;x.lineWidth=3;x.strokeRect(2,2,636,124);x.font='30px Arial';x.textAlign='center';x.fillStyle=color;x.fillText(text,320,77);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,depthWrite:false}));s.scale.set(5.5,1.1,1);return s;\n}\nfunction bearing(a,b){const dx=b.x-a.x,dz=b.z-a.z;return ['N','NE','E','SE','S','SW','W','NW'][(Math.round(Math.atan2(dx,-dz)/(Math.PI/4))+8)%8]+' · '+Math.round(Math.hypot(dx,dz))+'m';}\nfunction material(color,emissive=0){return new THREE.MeshStandardMaterial({color,emissive,emissiveIntensity:.8,metalness:.5,roughness:.3});}\nfunction ring(parent,x,z,color,radius=2.2){const r=new THREE.Mesh(new THREE.TorusGeometry(radius,.075,10,64),new THREE.MeshBasicMaterial({color}));r.rotation.x=Math.PI/2;r.position.set(x,.2,z);parent.add(r);return r;}\n\ntry{\n const [shell,world,drive,course,motes,touch]=await Promise.all(['expedition-shell','world-lantern-marsh','inertial-drive','checkpoint-course','ambient-motes','touch-controls'].map(logic));\n document.getElementById('boot').remove();\n shell.attach(document.body,{title:'Dead Letter Lake',eyebrow:'POSTAL SERVICE / END OF THE WORLD',accent:'#d3e6a3',description:'The lake swallowed the roads. The mail still has to get through. Pilot an electric skiff through eight lantern gates before the last post closes. Let the momentum carry you.',controls:'WASD / ARROWS — steer\\nSHIFT — boost · SCROLL — camera distance\\nESC — pause',parts:PARTS,assets:['courier-skiff','signal-buoy','ph-vintage-oil-lamp'],touch,cameraOffset:[0,7.5,19],build:async ctx=>{\n  const place=world.attach(ctx.scene),field=motes.attach(ctx.scene,{count:220,area:[95,95],height:[.3,5],color:0xd8f3ae,size:.09,speed:.4,seed:7});\n  const boat=await ctx.model('courier-skiff',1.6);ctx.scene.add(boat);ctx.follow(boat);\n  const names=['Willow Inlet','The Drowned Road','Heron Crossing','House Without Windows','Last Light Reach','The Old Orchard','No Forwarding Address','Dead Letter Office'];\n  const markers=[],buoys=[],signs=[];const markerRoot=new THREE.Group();ctx.scene.add(markerRoot);\n  for(let i=0;i<place.route.length;i++){\n   const p=place.route[i],mat=new THREE.MeshStandardMaterial({color:0xc2df9b,emissive:0x67944d,emissiveIntensity:1.8,transparent:true,roughness:.3,metalness:.5});\n   const gate=new THREE.Mesh(new THREE.TorusGeometry(2.1,.095,10,64),mat);gate.position.set(p.x,2.3,p.z);markerRoot.add(gate);markers.push(gate);\n   const buoy=await ctx.model('signal-buoy',1.8);buoy.position.set(p.x+3,.03,p.z);markerRoot.add(buoy);buoys.push(buoy);\n   const sign=plaque(String(i+1).padStart(2,'0')+' / '+names[i]);sign.position.set(p.x,5.3,p.z);markerRoot.add(sign);signs.push(sign);\n   const halo=ring(markerRoot,p.x,p.z,0xb6d98d,2.4);halo.material.transparent=true;halo.material.opacity=.4;\n  }\n  // A tiny unmanned post office at the finishing gate.\n  const office=new THREE.Group();office.position.set(-5,.2,3);markerRoot.add(office);\n  const deck=new THREE.Mesh(new THREE.BoxGeometry(5,.3,4),material(0x6f7153));office.add(deck);\n  for(const x of [-2,2]){const pole=new THREE.Mesh(new THREE.CylinderGeometry(.09,.09,3.7,8),material(0x6c7461));pole.position.set(x,1.7,-1.5);office.add(pole);}\n  const roof=new THREE.Mesh(new THREE.BoxGeometry(5.5,.25,4.5),material(0x526b5d));roof.position.y=3.6;office.add(roof);\n  const lamp=await ctx.model('ph-vintage-oil-lamp',.8);lamp.position.set(0,.2,0);office.add(lamp);const light=new THREE.PointLight(0xffd58c,12,12);light.position.set(-5,2,3);ctx.scene.add(light);\n  let penalty=0,impact=0,clock=0;\n  const motor=drive.attach(boat,{input:ctx.input,speed:9,boost:1.7,acceleration:3.2,drag:1.8,bounds:place.bounds,onImpact:()=>{if(impact<=0){penalty+=2;impact=1.5;ctx.message('Shallows. Two seconds lost.');ctx.tone(100,.15);}}});\n  const route=course.attach(boat,{points:place.route,radius:2.6,onCheckpoint:(i)=>{markers[i].material.color.set(0x5e9986);markers[i].material.emissiveIntensity=.2;ctx.message(names[i]+' — delivered.');ctx.tone(360+i*55,.2,'triangle');},onComplete:()=>ctx.finish('All eight deliveries made in '+Math.ceil(ctx.elapsed+penalty)+' seconds. Nobody was home. Someone left the lamps on for you.')});\n  function reset(){boat.position.copy(place.spawn);boat.position.y=.08;boat.rotation.y=Math.PI;motor.stop();route.reset();penalty=0;impact=0;markers.forEach(m=>{m.material.color.set(0xc2df9b);m.material.emissiveIntensity=1.8;});ctx.hud({value:'00 / 08',label:'120 seconds to last post',objective:'Follow the numbered lantern gates.',secondary:'You can boost through the wide water. Ease off before a turn.'});}\n  return{reset,ambient(dt){place.update(dt);field.update(dt);clock+=dt;buoys.forEach((b,i)=>b.position.y=.03+Math.sin(clock*1.5+i)*.06);markers.forEach((m,i)=>{m.rotation.z=Math.sin(clock*.5+i)*.06;m.material.opacity=i===route.index?1:.22;signs[i].visible=i===route.index;m.material.emissiveIntensity=i===route.index?2.4:route.index>i?.2:.8;});},update(dt){impact-=dt;motor.update(dt);route.update();boat.position.y=.08+Math.sin(clock*3)*.04;const left=Math.max(0,120-ctx.elapsed-penalty),next=place.route[Math.min(route.index,7)];ctx.hud({value:String(Math.min(route.index,8)).padStart(2,'0')+' / 08',label:Math.ceil(left)+' seconds to last post',objective:route.complete?'All deliveries made.':names[route.index],secondary:route.complete?'The office is closed. The lake is yours.':bearing(boat.position,next)+' to next gate · SHIFT boosts'});if(left===0)ctx.finish('The last post has closed. Your letters can wait until tomorrow. Try a wider line into the turns.',false);},snapshot(){return{world:'dead-letter-lake',position:boat.position.toArray(),checkpoint:route.index,targets:place.route.map(p=>p.toArray()),complete:route.complete,timeLeft:120-ctx.elapsed-penalty};},dispose(){motor.dispose();route.dispose();field.dispose();place.dispose();markerRoot.removeFromParent();boat.removeFromParent();light.removeFromParent();}};\n }});\n}catch(e){document.getElementById('boot')?.replaceChildren(document.createTextNode('Could not load this world. Please reload.'));console.error(e);}\n\n</script></body></html>"}