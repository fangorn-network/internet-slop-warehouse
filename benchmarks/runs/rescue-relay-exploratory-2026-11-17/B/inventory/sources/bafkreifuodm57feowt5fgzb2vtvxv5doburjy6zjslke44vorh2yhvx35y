{"js":"// CC0-1.0. Ammo-versus-armor hit resolution for shooters and extraction games. Engine-independent.\n// Penetration is a chance from (ammo pen - armor class) and armor wear; armor soaks durability on every hit.\n\nexport const AMMO = {\n    standard: { name: 'Standard', pen: 3, flesh: 40, armorDamage: 6, throughArmor: 0.85 },\n    hollow:   { name: 'Hollow point', pen: 1, flesh: 60, armorDamage: 4, throughArmor: 0.9 },\n    // Low flesh damage on bare targets; when it goes through armor first it keeps its energy (x1.85).\n    ap:       { name: 'Armor piercing', pen: 5, flesh: 26, armorDamage: 9, throughArmor: 1.85 },\n};\n\nexport const ARMOR = {\n    light:  { name: 'Light armor', cls: 2, durability: 40 },\n    medium: { name: 'Medium armor', cls: 3, durability: 60 },\n    heavy:  { name: 'Heavy armor', cls: 4, durability: 85 },\n};\n\n// Damage multipliers by zone; unlisted zones (thorax, stomach, leftArm ... from body-parts) count 1.\nexport const ZONES = { head: 2.2, body: 1, limb: 0.6 };\n// Zones body armor protects: the torso. Heads and limbs are bare.\nexport const COVERS = ['body', 'thorax', 'stomach'];\n\nconst clamp = (n, a, b) => Math.max(a, Math.min(b, n));\n\n/** Default penetration chance: 0.5 at equal pen/class, +-0.3 per point, worn armor lets more through. */\nexport function penetrationChance(pen, cls, wear) {\n    const base = clamp(0.5 + (pen - cls) * 0.3, 0.02, 0.98);\n    return clamp(base + (1 - base) * wear * 0.6, 0, 1);\n}\n\n/**\n * Resolve one projectile hit. armor: { cls, durability, max } or null. Returns\n * { flesh, armorLoss, penetrated, blocked, zone }. Does not mutate.\n */\nexport function resolveHit({ ammo, armor = null, zone = 'body', multiplier = 1, rng = Math.random,\n    chance = penetrationChance, blunt = 0.15, zones = ZONES, covers = COVERS } = {}) {\n    if (!ammo || !Number.isFinite(ammo.flesh) || !Number.isFinite(ammo.pen)) throw new TypeError('ammo needs pen and flesh');\n    const z = zones[zone] ?? 1;\n    const covered = covers.includes(zone) && armor && armor.durability > 0;\n    if (!covered) return { flesh: ammo.flesh * z * multiplier, armorLoss: 0, penetrated: false, blocked: false, zone };\n    const wear = 1 - armor.durability / (armor.max || armor.durability);\n    const penetrated = rng() < chance(ammo.pen, armor.cls, wear);\n    const armorLoss = Math.min(armor.durability, (ammo.armorDamage ?? 5) * multiplier * (penetrated ? 1 : 1.4));\n    const flesh = (penetrated ? ammo.flesh * (ammo.throughArmor ?? 1) : ammo.flesh * blunt) * z * multiplier;\n    return { flesh, armorLoss, penetrated, blocked: !penetrated, zone };\n}\n\n/**\n * Bind ballistics to a target: armor is { cls, durability, max } (mutated as it wears), health is anything\n * with damage(amount, source, zone) (the warehouse `health` part, or `body-parts` for per-limb damage).\n */\nexport function attach(target, { armor = null, health = null, rng = Math.random, chance = penetrationChance,\n    blunt = 0.15, zones = ZONES, covers = COVERS, modifyFlesh = (flesh) => flesh, onHit = () => {} } = {}) {\n    let dead = false;\n    return {\n        get armor() { return armor; },\n        setArmor(a) { armor = a; },\n        hit({ ammo, zone = 'body', multiplier = 1, source = null }) {\n            if (dead) return null;\n            const r = resolveHit({ ammo, armor, zone, multiplier, rng, chance, blunt, zones, covers });\n            if (armor && r.armorLoss) armor.durability = Math.max(0, armor.durability - r.armorLoss);\n            r.flesh = modifyFlesh(r.flesh, r, target);\n            if (health && r.flesh > 0) health.damage(r.flesh, source, zone);\n            onHit(r, target, source);\n            return r;\n        },\n        update() {},\n        dispose() { dead = true; },\n    };\n}"}