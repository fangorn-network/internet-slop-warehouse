{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<title>Cube field</title>\n<meta name=\"description\" content=\"The single cube, remixed into a field of eighty-one, rippling in a wave. Click to send a new ripple from where you point.\">\n<meta name=\"keywords\" content=\"demo, cube, wave, grid, interactive, remix\">\n<style>html,body{margin:0;height:100%;overflow:hidden;background:#000}</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\"}}</script>\n</head><body><script type=\"module\">\nimport * as THREE from \"three\";\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);\ncamera.position.set(0, 9, 11); camera.lookAt(0, 0, 0);\nconst cubes = [];\nfor (let x = -4; x <= 4; x++) for (let z = -4; z <= 4; z++) {\n    const c = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.8, 0.8), new THREE.MeshNormalMaterial());\n    c.position.set(x * 1.1, 0, z * 1.1); scene.add(c); cubes.push(c);\n}\nlet origin = new THREE.Vector2(0, 0), start = 0;\naddEventListener(\"click\", (e) => { origin.set((e.clientX / innerWidth - 0.5) * 10, (e.clientY / innerHeight - 0.5) * 10); start = performance.now(); });\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\nrenderer.setAnimationLoop((t) => {\n    for (const c of cubes) {\n        const d = Math.hypot(c.position.x - origin.x, c.position.z - origin.y);\n        c.position.y = Math.sin(d - (t - start) / 300) * Math.exp(-d / 6) * 0.8;\n        c.rotation.set(t / 1500, t / 1100, 0);\n    }\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}