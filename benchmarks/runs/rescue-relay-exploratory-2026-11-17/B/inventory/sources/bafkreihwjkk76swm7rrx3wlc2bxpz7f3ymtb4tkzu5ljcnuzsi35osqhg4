{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Escape from Slopov</title>\n<meta name=\"description\" content=\"An extraction shooter in an abandoned town: gear up, raid, loot, and get out alive or lose everything you brought.\">\n<style>\n:root{--bg:#0c0e0d;--panel:#141816;--line:#2a302c;--text:#d7d3c5;--dim:#8d8a7e;--amber:#d9a441;--red:#c4493b;--green:#7fae5a}\n*{box-sizing:border-box}\nhtml,body{margin:0;height:100%;overflow:hidden;background:#000;color:var(--text);font:14px/1.35 \"Bahnschrift\",\"DIN Alternate\",\"Roboto Condensed\",\"Arial Narrow\",system-ui,sans-serif;touch-action:none;-webkit-user-select:none;user-select:none}\ncanvas#c{position:fixed;inset:0;width:100%;height:100%;display:block}\nbutton{font:inherit;color:var(--text);background:#1d221f;border:1px solid var(--line);padding:4px 10px;cursor:pointer;letter-spacing:.04em}\nbutton:hover{border-color:var(--amber);color:#fff}button:disabled{opacity:.4;cursor:default;border-color:var(--line)}\nbutton.primary{background:var(--amber);color:#14110a;border-color:var(--amber);font-weight:700}\n.hidden{display:none!important}\n.mono{font-family:ui-monospace,\"Cascadia Mono\",Menlo,monospace}\n/* loading */\n#loading{position:fixed;inset:0;display:grid;place-items:center;background:var(--bg);z-index:50;text-align:center}\n#loading h1{font-size:44px;letter-spacing:.18em;margin:0 0 6px;color:var(--amber)}\n#bar{width:260px;height:4px;background:#222;margin:16px auto}#bar i{display:block;height:100%;width:0;background:var(--amber)}\n/* menu */\n#menu{position:fixed;inset:0;background:radial-gradient(ellipse at 30% 20%,#1b211dcc,#0a0c0bf2 70%);z-index:20;display:flex;flex-direction:column}\n#menu header{display:flex;align-items:center;gap:14px;padding:12px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap}\n#menu header h1{margin:0;font-size:22px;letter-spacing:.2em;color:var(--amber);white-space:nowrap}\n#menu header .money{margin-left:auto;font-size:18px}\n.tabs button{border-radius:0}.tabs button.on{border-color:var(--amber);color:var(--amber)}\n#menu main{flex:1;overflow:auto;padding:14px 18px}\n.cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}\n@media(max-width:760px){.cols{grid-template-columns:1fr}}\n.panel{background:var(--panel);border:1px solid var(--line);padding:10px 12px}\n.panel h3{margin:0 0 8px;font-size:13px;letter-spacing:.14em;color:var(--dim);text-transform:uppercase;display:flex;justify-content:space-between}\n.slot{border:1px solid var(--line);padding:6px 8px;margin-bottom:6px;background:#101311}\n.slot .label{font-size:11px;color:var(--dim);letter-spacing:.12em;text-transform:uppercase}\n.row{display:flex;align-items:center;gap:6px;padding:3px 0;border-bottom:1px dashed #222826;flex-wrap:wrap}\n.row:last-child{border-bottom:0}\n.row .name{flex:1;min-width:120px}.row .meta{color:var(--dim);font-size:12px}\n.row button{padding:1px 7px;font-size:12px}\n.cap{height:3px;background:#222;margin:4px 0 6px}.cap i{display:block;height:100%;background:var(--green)}\n.empty{color:#555;font-style:italic;padding:2px 0}\n.nested{margin-left:14px;border-left:1px solid var(--line);padding-left:8px}\n#toast{position:fixed;left:50%;top:14px;transform:translateX(-50%);background:#000c;border:1px solid var(--amber);padding:6px 14px;z-index:60;pointer-events:none;transition:opacity .3s}\n/* hud */\n#hud{position:fixed;inset:0;pointer-events:none;z-index:5}\n#cross{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px;opacity:.75}\n#cross:before,#cross:after{content:\"\";position:absolute;background:#fff}\n#cross:before{left:8px;top:0;width:2px;height:18px;clip-path:polygon(0 0,100% 0,100% 30%,0 30%,0 70%,100% 70%,100% 100%,0 100%)}\n#cross:after{top:8px;left:0;height:2px;width:18px;clip-path:polygon(0 0,30% 0,30% 100%,0 100%,0 0,70% 0,100% 0,100% 100%,70% 100%)}\n#hit{position:absolute;left:50%;top:50%;width:26px;height:26px;margin:-13px;opacity:0;border:2px solid #fff;transform:rotate(45deg);clip-path:polygon(0 0,35% 0,35% 35%,0 35%,0 65%,35% 65%,35% 100%,0 100%,0 0,100% 0,100% 35%,65% 35%,65% 0,100% 0,100% 100%,65% 100%,65% 65%,100% 65%)}\n#vitals{position:absolute;left:18px;bottom:16px;width:240px}\n.bar2{height:8px;background:#0008;border:1px solid #fff3;margin-top:4px}.bar2 i{display:block;height:100%}\n#ar i{background:#6c8bb0}\n#bodymap{display:grid;grid-template-columns:repeat(4,16px);grid-template-rows:16px 22px 16px 26px;gap:2px;margin:6px 0 4px;grid-template-areas:\". h h .\" \"la t t ra\" \"la s s ra\" \". ll rl .\"}\n#bodymap i{border:1px solid #fff4;background:#5a9a4a}#bodymap i.gone{background:#111;border-color:#c4493b}\n[data-p=head]{grid-area:h;border-radius:8px}[data-p=thorax]{grid-area:t}[data-p=stomach]{grid-area:s}[data-p=leftArm]{grid-area:la}[data-p=rightArm]{grid-area:ra}[data-p=leftLeg]{grid-area:ll}[data-p=rightLeg]{grid-area:rl}\n#bodytext{font-size:11px;color:#fffc;text-shadow:0 1px 2px #000;margin-bottom:4px}\n#using{position:absolute;left:50%;top:46%;transform:translateX(-50%);font-size:18px;color:#e8e2cf;text-shadow:0 1px 3px #000}\n#ammo{position:absolute;right:20px;bottom:16px;text-align:right;text-shadow:0 1px 2px #000}\n#ammo b{font-size:30px}\n#prompt{position:absolute;left:50%;top:58%;transform:translateX(-50%);background:#000a;padding:4px 10px;border:1px solid #fff3}\n#status{position:absolute;left:50%;top:14px;transform:translateX(-50%);text-align:center;text-shadow:0 1px 3px #000;letter-spacing:.08em}\n#extract{position:absolute;left:50%;top:40%;transform:translateX(-50%);font-size:22px;color:var(--green);text-shadow:0 1px 3px #000}\n#dmg{position:absolute;inset:0;box-shadow:inset 0 0 160px 40px #a00;opacity:0;transition:opacity .4s}\n#scope{position:fixed;inset:0;z-index:4;pointer-events:none;background:radial-gradient(circle at 50% 50%,transparent 0 31vmin,#000 31.3vmin)}\n#scope:before{content:\"\";position:absolute;left:50%;top:50%;width:62vmin;height:1px;margin-left:-31vmin;background:#000}\n#scope:after{content:\"\";position:absolute;left:50%;top:50%;height:62vmin;width:1px;margin-top:-31vmin;background:#000}\n#resume{position:absolute;left:50%;top:50%;transform:translate(-50%,40px);background:#000b;border:1px solid var(--amber);color:var(--amber);padding:8px 18px;letter-spacing:.16em}\n#hint{position:absolute;left:18px;top:14px;color:#fffa;font-size:12px;text-shadow:0 1px 2px #000;line-height:1.6}\n/* overlays */\n.overlay{position:fixed;inset:0;z-index:15;background:#070908e6;display:flex;flex-direction:column;padding:16px 18px;overflow:auto}\n.overlay h2{margin:0 0 10px;letter-spacing:.16em;font-size:18px;color:var(--amber);display:flex;justify-content:space-between;align-items:center}\n#mapov{align-items:center;justify-content:center}\n#mapov canvas{max-width:min(92vw,92vh);max-height:min(82vh,92vw);border:1px solid var(--line);image-rendering:pixelated}\n#end{align-items:center;justify-content:center;text-align:center}\n#end .panel{max-width:520px;width:100%}\n#end h2{justify-content:center;font-size:30px}\ntextarea{width:100%;height:110px;background:#0b0d0c;color:var(--text);border:1px solid var(--line);font:12px ui-monospace,monospace;user-select:text;-webkit-user-select:text}\n.trader-item{display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px dashed #222826}\n.trader-item .name{flex:1}.price{color:var(--amber);font-family:ui-monospace,monospace}\n.kind{font-size:11px;letter-spacing:.14em;color:var(--dim);margin:10px 0 2px;text-transform:uppercase}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script>\n</head><body>\n<canvas id=\"c\"></canvas>\n<div id=\"loading\"><div><h1>ESCAPE FROM SLOPOV</h1><div id=\"loadmsg\">loading parts…</div><div id=\"bar\"><i></i></div></div></div>\n\n<div id=\"hud\" class=\"hidden\">\n  <div id=\"hint\">WASD move · Shift sprint · LMB fire · RMB aim · R reload · B ammo type<br>E search/pick up · Tab inventory · M map · 4 bandage · 5 medkit · click to look</div>\n  <div id=\"status\"></div>\n  <div id=\"cross\"></div><div id=\"hit\"></div>\n  <div id=\"prompt\" class=\"hidden\"></div>\n  <div id=\"resume\" class=\"hidden\">CLICK TO RESUME</div>\n  <div id=\"extract\" class=\"hidden\"></div>\n  <div id=\"using\" class=\"hidden\"></div>\n  <div id=\"vitals\"><div>HEALTH <span id=\"hpv\" class=\"mono\"></span></div><div id=\"bodymap\"><i data-p=\"head\" title=\"Head\"></i><i data-p=\"leftArm\"></i><i data-p=\"thorax\"></i><i data-p=\"rightArm\"></i><i data-p=\"stomach\"></i><i data-p=\"leftLeg\"></i><i data-p=\"rightLeg\"></i></div><div id=\"bodytext\" class=\"mono\"></div><div id=\"arwrap\">ARMOR <span id=\"arv\" class=\"mono\"></span><div class=\"bar2\" id=\"ar\"><i></i></div></div></div>\n  <div id=\"ammo\"><b class=\"mono\" id=\"mag\">0</b><span class=\"mono\" id=\"reserve\"></span><div id=\"ammotype\"></div></div>\n  <div id=\"dmg\"></div>\n</div>\n<div id=\"scope\" class=\"hidden\"></div>\n\n<div id=\"menu\" class=\"hidden\">\n  <header>\n    <h1>ESCAPE FROM SLOPOV</h1>\n    <div class=\"tabs\"><button data-tab=\"loadout\" class=\"on\">LOADOUT &amp; STASH</button><button data-tab=\"trader\">TRADER</button></div>\n    <button id=\"savebtn\">SAVE / LOAD</button>\n    <span class=\"money mono\" id=\"money\"></span>\n    <button class=\"primary\" id=\"deploy\">DEPLOY TO SLOPOV ▸</button>\n  </header>\n  <main id=\"menumain\"></main>\n</div>\n\n<div id=\"inv\" class=\"overlay hidden\"><h2><span>INVENTORY</span><button id=\"invclose\">CLOSE (TAB)</button></h2><div class=\"cols\" id=\"invcols\"></div></div>\n<div id=\"mapov\" class=\"overlay hidden\"><h2 style=\"width:min(92vw,92vh)\"><span>MAP OF SLOPOV</span><button id=\"mapclose\">CLOSE (M)</button></h2><canvas id=\"mapc\"></canvas></div>\n<div id=\"savebox\" class=\"overlay hidden\" style=\"align-items:center;justify-content:center\"><div class=\"panel\" style=\"max-width:560px;width:100%\">\n  <h3>SAVE CODE <button onclick=\"document.getElementById('savebox').classList.add('hidden')\">CLOSE</button></h3>\n  <p class=\"meta\">This game runs sandboxed and cannot store anything. Copy this code to keep your stash; paste one and press Load to restore it.</p>\n  <textarea id=\"savecode\" spellcheck=\"false\"></textarea>\n  <div style=\"display:flex;gap:8px;margin-top:8px\"><button id=\"savecopy\">COPY</button><button id=\"saveload\" class=\"primary\">LOAD CODE</button><span id=\"savemsg\" class=\"meta\"></span></div>\n</div></div>\n<div id=\"end\" class=\"overlay hidden\"><div class=\"panel\"><h2 id=\"endtitle\"></h2><div id=\"endbody\"></div><p><button class=\"primary\" id=\"endok\">BACK TO BASE</button></p></div></div>\n<div id=\"toast\" style=\"opacity:0\"></div>\n\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nimport * as SkeletonUtils from 'three/addons/utils/SkeletonUtils.js';\n// Escape from Slopov item catalog: everything the trader sells is everything a raid can drop.\nconst CATALOG = {\n    ar: { name: 'AR-12 assault rifle', kind: 'gun', size: 4, price: 28000, mods: ['silencer', 'holo'],\n        fire: { mode: 'auto', rpm: 620, mag: 30, reload: 2.4, mult: 1, spread: 0.032, ads: 0.004, recoil: 0.012, range: 45, sound: 'rifle' } },\n    shotgun: { name: 'P-8 pump shotgun', kind: 'gun', size: 4, price: 14000, mods: ['silencer'],\n        fire: { mode: 'pump', cycle: 0.78, mag: 6, reloadEach: 0.55, pellets: 8, mult: 0.32, spread: 0.06, ads: 0.035, recoil: 0.05, range: 18, sound: 'shotgun' } },\n    bolt: { name: 'M-91 bolt-action rifle', kind: 'gun', size: 4, price: 22000, mods: ['scope'],\n        fire: { mode: 'bolt', cycle: 1.2, mag: 5, reloadEach: 0.6, mult: 2.1, spread: 0.05, ads: 0.0008, recoil: 0.045, range: 80, sound: 'bolt' } },\n    silencer: { name: 'Silencer', kind: 'mod', size: 1, price: 9000 },\n    holo: { name: 'Holographic sight', kind: 'mod', size: 1, price: 7500 },\n    scope: { name: '4x scope', kind: 'mod', size: 1, price: 12000 },\n    'armor-light': { name: 'Light armor', kind: 'armor', size: 4, price: 9000, armor: 'light', durability: 40, slow: 0 },\n    'armor-medium': { name: 'Medium armor', kind: 'armor', size: 4, price: 21000, armor: 'medium', durability: 60, slow: 0.05 },\n    'armor-heavy': { name: 'Heavy armor', kind: 'armor', size: 4, price: 38000, armor: 'heavy', durability: 85, slow: 0.12 },\n    'rig-light': { name: 'Light chest rig', kind: 'rig', size: 2, price: 3000, capacity: 4 },\n    'rig-medium': { name: 'Medium chest rig', kind: 'rig', size: 2, price: 8000, capacity: 8 },\n    'rig-big': { name: 'Big chest rig', kind: 'rig', size: 2, price: 16000, capacity: 12 },\n    'pack-small': { name: 'Small backpack', kind: 'backpack', size: 3, price: 2500, capacity: 8 },\n    'pack-medium': { name: 'Medium backpack', kind: 'backpack', size: 3, price: 7000, capacity: 16 },\n    'pack-large': { name: 'Large backpack', kind: 'backpack', size: 3, price: 15000, capacity: 26 },\n    map: { name: 'Map of Slopov', kind: 'map', size: 1, price: 1500 },\n    'ammo-standard': { name: 'Standard rounds', kind: 'ammo', size: 1, stack: 30, buyUnit: 30, price: 1500, ammo: 'standard' },\n    'ammo-hollow': { name: 'Hollow-point rounds', kind: 'ammo', size: 1, stack: 30, buyUnit: 30, price: 2200, ammo: 'hollow' },\n    'ammo-ap': { name: 'Armor-piercing rounds', kind: 'ammo', size: 1, stack: 30, buyUnit: 30, price: 4500, ammo: 'ap' },\n    cash: { name: 'Cash', kind: 'cash', size: 1, stack: 100000, price: 1 },\n    bandage: { name: 'Bandage', kind: 'med', size: 1, price: 1800, heal: 30, use: 2.5 },\n    medkit: { name: 'Field medkit', kind: 'med', size: 1, price: 8500, heal: 110, use: 5, restore: true },\n};\nconst START_MONEY = 25000;\n\n\n// Every part this game builds on, by id ->