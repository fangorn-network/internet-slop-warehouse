{"js":"// SPDX-License-Identifier: CC0-1.0\n// Camera controller, including pointer-lock-free drag fallback for sandboxed iframes.\nexport function attach(camera,{element=document.body,heightAt=()=>0,bounds=150,obstacles=[],speed=2.2,eyeHeight=1.7,onStep=()=>{},canMove=()=>true,sensitivity=.002}={}){\n const keys=new Set(),listeners=[],position=camera.position;let yaw=0,pitch=0,distance=0,step=0,drag=false,lastX=0,lastY=0,touch={x:0,z:0},dead=false;\n const on=(target,event,fn,opts)=>{target.addEventListener(event,fn,opts);listeners.push(()=>target.removeEventListener(event,fn,opts));};\n const clear=()=>{keys.clear();drag=false;touch={x:0,z:0};};\n on(window,'keydown',e=>{if(/INPUT|TEXTAREA|SELECT/.test(e.target.tagName))return;if(['KeyW','KeyA','KeyS','KeyD','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','ShiftLeft','ShiftRight'].includes(e.code)){keys.add(e.code);e.preventDefault();}});on(window,'keyup',e=>keys.delete(e.code));on(window,'blur',clear);on(document,'visibilitychange',()=>{if(document.hidden)clear();});\n const look=(dx,dy)=>{if(!canMove())return;yaw-=dx*sensitivity;pitch=Math.max(-1.35,Math.min(1.35,pitch-dy*sensitivity));};\n on(element,'pointerdown',e=>{if(e.pointerType==='touch')return;drag=true;lastX=e.clientX;lastY=e.clientY;element.setPointerCapture?.(e.pointerId);});\n on(window,'pointerup',()=>drag=false);on(window,'pointermove',e=>{if(document.pointerLockElement===element)look(e.movementX,e.movementY);else if(drag){look(e.clientX-lastX,e.clientY-lastY);lastX=e.clientX;lastY=e.clientY;}});\n camera.rotation.order='YXZ';\n const blocked=(x,z)=>Math.abs(x)>bounds-2||Math.abs(z)>bounds-2||obstacles.some(o=>Math.hypot(x-o.x,z-o.z)<(o.radius??.3)+.28);\n const api={get yaw(){return yaw;},get distance(){return distance;},setLook(y,p=0){yaw=y;pitch=p;},look,clear,setTouch(x,z){touch={x,z};},async lock(){try{await element.requestPointerLock?.();}catch{/* drag remains available */}},update(dt){if(dead||!canMove())return;dt=Math.min(.05,Math.max(0,dt)