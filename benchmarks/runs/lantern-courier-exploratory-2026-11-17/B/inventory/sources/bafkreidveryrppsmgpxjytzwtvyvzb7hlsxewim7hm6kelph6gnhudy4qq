{"js":"// SPDX-License-Identifier: CC0-1.0\nimport * as T from 'three';\nexport function makeCarbine({color='#648b8e'}={}){const root=new T.Group(),body=new T.MeshStandardMaterial({color,metalness:.4,roughness:.5}),dark=new T.MeshStandardMaterial({color:'#21323c',metalness:.5,roughness:.6}),glow=new T.MeshStandardMaterial({color:'#bce4dc',emissive:'#6bd3d5',emissiveIntensity:1.5});const add=(g,m,x,y,z)=>{const o=new T.Mesh(g,m);o.position.set(x,y,z);root.add(o);return o;};add(new T.BoxGeometry(.2,.2,.58),body,0,0,0);add(new T.BoxGeometry(.13,.26,.14),dark,0,-.18,.12);const barrel=add(new T.CylinderGeometry(.055,.055,.48,10),dark,0,.02,-.48);barrel.rotation.x=Math.PI/2;add(new T.BoxGeometry(.06,.08,.34),glow,.11,.035,-.05);add(new T.BoxGeometry(.06,.06,.11),dark,0,.16,-.1);root.name='Salvage pulse carbine';return root;}\nexport function attach(parent,opts={}){const root=makeCarbine(opts);parent.add(root);return{root,update(){},dispose(){root.removeFromParent();const gs=new Set(),ms=new Set();root.traverse(o=>{if(o.geometry)gs.add(o.geometry);if(o.material)ms.add(o.material);});gs.forEach(g=>g.dispose());ms.forEach(m=>m.dispose());}};}\n"}