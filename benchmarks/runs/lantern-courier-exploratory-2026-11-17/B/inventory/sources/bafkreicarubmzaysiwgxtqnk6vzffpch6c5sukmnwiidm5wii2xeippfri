{"js":"// SPDX-License-Identifier: CC0-1.0\nimport * as T from 'three';\nexport function attach(parent,{district,pedestrians=16,traffic=4,labels=true}={}){const root=new T.Group();parent.add(root);const geometry=new Set(),materials=new Set(),textures=new Set(),signs=[],routes=[],walkers=[];\n const material=color=>{const m=new T.MeshStandardMaterial({color,roughness:.9});materials.add(m);return m;},coat=material('#788d85'),head=material('#bba28b'),carPaint=material('#657e88'),glass=material('#273f47');\n function mesh(g,m,group){geometry.add(g);const o=new T.Mesh(g,m);o.castShadow=true;group.add(o);return o;}\n function sign(text,x,y,z,color='#bfd2c5',size=1){const c=document.createElement('canvas');c.width=512;c.height=80;const ctx=c.getContext('2d');ctx.fillStyle='#10292ee8';ctx.fillRect(0,0,512,80);ctx.font='500 28px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle=color;ctx.fillText(text.slice(0,58),256,40,485);const texture=new T.CanvasTexture(c);texture.colorSpace=T.SRGBColorSpace;textures.add(texture);const m=new T.SpriteMaterial({map:texture,transparent:true,depthTest:true});materials.add(m);const sprite=new T.Sprite(m);sprite.position.set(x,y,z);sprite.scale.set(22*size,3.45*size,1);root.add(sprite);signs.push(sprite);}\n if(labels){const seen=new Set();for(const road of district.roads.filter(r=>r.name&&r.kind!=='water')){if(seen.has(road.name)||road.points.length<2)continue;seen.add(road.name);const p=road.points[Math.floor(road.points.length/2)];sign(road.name,p.x,5,p.z);if(seen.size>=60)break;}for(const b of district.buildings.filter(b=>b.address||b.name)){sign(b.address||b.name,b.x,Math.min(18,b.height+2),b.z,'#dfc696',.75);}}\n const roads=district.roads.filter(r=>!r.labelOnly&&r.kind!=='water'&&r.points.length>1&&Math.hypot(r.points[0].x-r.points.at(-1).x,r.points[0].z-r.points.at(-1).z)>45);\n // Cosmetic activity follows real street polylines; it does not imply real-world people or traffic.\n for(let i=0;i<Math.min(pedestrians+traffic,roads.length);i++){const road=roads[(i*29+3)%roads.length],lengths=[0];for(let j=1;j<road.points.length;j++)lengths.push(lengths.at(-1)+Math.hypot(road.points[j].x-road.points[j-1].x,road.points[j].z-road.points[j-1].z));if(lengths.at(-1)<20)continue;const g=new T.Group();root.add(g);const car=i>=pedestrians;if(car){const body=mesh(new T.BoxGeometry(1.8,.8,3.7),carPaint,g);body.position.y=.8;const top=mesh(new T.BoxGeometry(1.5,.65,1.9),glass,g);top.position.set(0,1.5,-.1);}else{const body=mesh(new T.CapsuleGeometry(.28,.75,2,5),coat,g);body.position.y=.85;const h=mesh(new T.SphereGeometry(.2,6,5),head,g);h.position.y=1.65;}walkers.push({g,road,lengths,speed:car?5:1.3,offset:i*37,car});}\n return{root,update(dt,{age=0}={},viewer){for(const sign of signs)sign.visible=!viewer||Math.hypot(sign.position.x-viewer.x,sign.position.z-viewer.z)<(sign.scale.x>20?220:110);for(const actor of walkers){const total=actor.lengths.at(-1),phase=(age*actor.speed+actor.offset)%(total*2),reverse=phase>total,d=reverse?total*2-phase:phase;let i=1;while(i<actor.lengths.length-1&&actor.lengths[i]<d)i++;const a=actor.road.points[i-1],b=actor.road.points[i],t=(d-actor.lengths[i-1])/(actor.lengths[i]-actor.lengths[i-1]||1),dx=b.x-a.x,dz=b.z-a.z,l=Math.hypot(dx,dz)||1,side=actor.car?1.5:actor.road.width/2+1;actor.g.position.set(a.x+dx*t-dz/l*side,0,a.z+dz*t+dx/l*side);actor.g.rotation.y=Math.atan2(dx,dz)+(reverse?Math.PI:0);actor.g.visible=!viewer||Math.hypot(actor.g.position.x-viewer.x,actor.g.position.z-viewer.z)<240;}},dispose(){root.removeFromParent();geometry.forEach(g=>g.dispose());materials.forEach(m=>m.dispose());textures.forEach(t=>t.dispose());}};\n}\n"}