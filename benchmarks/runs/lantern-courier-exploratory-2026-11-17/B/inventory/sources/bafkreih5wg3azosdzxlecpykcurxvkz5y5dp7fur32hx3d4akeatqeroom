{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Horse roundup</title>\n<meta name=\"description\" content=\"A remix of Robot roundup at dusk: herd six skittish bronze horse statues, hopping like they mean it, into a planked pen on the beach.\">\n<style>\n  html,body{margin:0;touch-action:none;-webkit-user-select:none;user-select:none;height:100%;overflow:hidden;background:#f3c89a;font:14px system-ui,sans-serif}\n  #hud{position:fixed;top:10px;left:12px;color:#fff;text-shadow:0 1px 2px #0008;font-weight:600;pointer-events:none}\n  #msg{position:fixed;inset:0;display:grid;place-items:center;color:#fff;text-shadow:0 2px 4px #0009;font-size:22px;text-align:center;cursor:pointer;background:#0004}\n  #msg small{display:block;font-size:14px;opacity:.85;margin-top:8px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script>\n</head><body>\n<div id=\"hud\"></div><div id=\"msg\">loading…</div>\n<script type=\"module\">\nimport * as THREE from \"three\";\nimport { GLTFLoader } from \"three/addons/loaders/GLTFLoader.js\";\nimport * as SkeletonUtils from \"three/addons/utils/SkeletonUtils.js\";\n\nconst PARTS = {\"robot\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiezecuxadyslgydj7gwc3ihmujswsynwykrj4yjbofc4eggugam2y\",\"horse-statue\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiawi4ltjcbmypsc55ooyg5poujcmaxmnp4joiq6zad3kvld6ljlfy\",\"sand-rocks-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiakdtac4arknedx7rbd2ktrce23fjdh3wrrcr5ehgotmmfacjqwgq\",\"planks-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafkreieuqm763jcoajnjcopxwvzd5kcoj4bfru5vje42phqqcpatgcc6fe\",\"day-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafybeid7dhs2ji7cfsd5mug7iagvtozqfp4yei7t4r3v6emzbxpqh7df7u\",\"coin-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6lmgvb7xur2rnodcgqbebxr4z4zypv7j2m5egibysabahllmxf4\",\"platformer-controller\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihbjdl3wwjfiiu7qne4a5qnskfj4lrieutjlv64yhqd25kbth7m74\",\"patrol\":\"https://ipfs-test.fangorn.network/ipfs/bafkreig4sntado3q4izlueu4spl2pydk6yiad4cdab6vimthb6mwabpw7m\",\"flee-on-see\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiaz5kuq7nhschwl7qxt65cmsq4ooh6hvhlx5o7apnlkcbgw6b5q2e\",\"follow-camera\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiauise4tsy3llffneifcfwo25whtfrccjdjynf2bqj4jj5kypypha\",\"clip-animator\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiahogjc53z7qaa7x4j7nnus5rxahr6ojuaxb2m7oukkb3fxc3zj2y\",\"hdri-sky\":\"https://ipfs-test.fangorn.network/ipfs/bafkreif4o56shppr6t5ttbczmnyjhm5bgaklfsujajbd7y7mjznvtkv2ce\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\"};\nconst logic = async (id) => import(\"data:text/javascript;charset=utf-8,\" + encodeURIComponent((await (await fetch(PARTS[id])).json()).js));\nlogic(\"touch-controls\").then((t) => t.attach()); // a joystick and jump button on phones\n\n// A remix of Robot roundup: the herd are bronze horse statues that hop instead of walk, on a beach at dusk.\nconst [controller, patrol, flee, followCam, animator, sky, gltf, horseG, grassTex, crateTex] = await Promise.all([\n    logic(\"platformer-controller\"), logic(\"patrol\"), logic(\"flee-on-see\"), logic(\"follow-camera\"), logic(\"clip-animator\"), logic(\"hdri-sky\"),\n    new GLTFLoader().loadAsync(PARTS[\"robot\"]), new GLTFLoader().loadAsync(PARTS[\"horse-statue\"]),\n    new THREE.TextureLoader().loadAsync(PARTS[\"sand-rocks-texture\"]), new THREE.TextureLoader().loadAsync(PARTS[\"planks-texture\"]),\n]);\nconst audio = new AudioContext();\nconst coinBuf = await audio.decodeAudioData(await (await fetch(PARTS[\"coin-sound\"])).arrayBuffer());\nconst ding = () => { const s = audio.createBufferSource(); s.buffer = coinBuf; s.connect(audio.destination); s.start(); };\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.shadowMap.enabled = true;\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(55, 1, 0.1, 200);\nscene.fog = new THREE.Fog(0xf3c89a, 30, 80); const skyH = sky.attach(scene, { url: PARTS[\"day-sky\"], intensity: 0.7, spin: 0.02 });\nscene.add(new THREE.HemisphereLight(0xffffff, 0x446622, 1.2));\nconst sun = new THREE.DirectionalLight(0xffffff, 2); sun.position.set(8, 15, 6); sun.castShadow = true;\nObject.assign(sun.shadow.camera, { left: -20, right: 20, top: 20, bottom: -20 }); sun.shadow.mapSize.set(2048, 2048);\nscene.add(sun);\n\n// The field, and a pen in the far corner marked by crate posts and a sandy floor.\nconst R = 14, PEN = { x: -10, z: -10, half: 3 };\nfor (const t of [grassTex, crateTex]) { t.colorSpace = THREE.SRGBColorSpace; t.wrapS = t.wrapT = THREE.RepeatWrapping; }\nconst solids = [];\nfunction block(x, y, z, w, h, d, crate = false) {\n    const tex = (crate ? crateTex : grassTex).clone(); tex.repeat.set(crate ? 1 : w / 6, crate ? 1 : d / 6); tex.needsUpdate = true;\n    const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), new THREE.MeshLambertMaterial({ map: tex }));\n    m.position.set(x, y - h / 2, z); m.castShadow = m.receiveShadow = true; scene.add(m); solids.push(m);\n}\nblock(0, 0, 0, 2 * R, 2, 2 * R);\nfor (const sx of [-1, 1]) for (const sz of [-1, 1]) block(PEN.x + sx * PEN.half, 1, PEN.z + sz * PEN.half, 0.8, 1, 0.8, true);\nconst floor = new THREE.Mesh(new THREE.PlaneGeometry(2 * PEN.half, 2 * PEN.half), new THREE.MeshLambertMaterial({ map: crateTex }));\nfloor.rotation.x = -Math.PI / 2; floor.position.set(PEN.x, 0.01, PEN.z); floor.receiveShadow = true; scene.add(floor);\nconst inPen = (p) => Math.abs(p.x - PEN.x) < PEN.half && Math.abs(p.z - PEN.z) < PEN.half;\n\nconst robot = (tint) => {\n    const m = SkeletonUtils.clone(gltf.scene); m.scale.setScalar(0.35);\n    m.traverse((o) => { if (o.isMesh) { o.castShadow = true; if (tint) { o.material = o.material.clone(); o.material.color.multiply(new THREE.Color(tint)); } } });\n    scene.add(m); return m;\n};\nconst player = robot();\nconst rand = () => new THREE.Vector3((Math.random() * 2 - 1) * (R - 2), 0, (Math.random() * 2 - 1) * (R - 2));\n\nlet over = true, start = 0;\nconst systems = [], herd = [], N = 6;\nfunction begin() {\n    for (const s of systems.splice(0)) s.dispose();\n    for (const h of herd.splice(0)) h.model.removeFromParent();\n    player.position.set(6, 0, 6);\n    const ctl = controller.attach(player, { solids, camera, onFall: () => { player.position.set(6, 0, 6); } });\n    systems.push(ctl, animator.attach(player, { animations: gltf.animations, state: () => ctl.state }),\n        followCam.attach(camera, { target: player, offset: [0, 8, 10] }));\n    for (let i = 0; i < N; i++) {\n        let at; do at = rand(); while (inPen(at) || at.distanceTo(player.position) < 5);\n        const model = horseG.scene.clone(); model.scale.setScalar(7); model.traverse((o) => { if (o.isMesh) o.castShadow = true; });\n        scene.add(model); model.position.copy(at); model.userData.phase = Math.random() * 6;\n        // patrol, with its onSee swapped for flee-on-see: they wander until you come near, then bolt.\n        const h = { model, penned: false };\n        h.ai = patrol.attach(model, { points: [rand(), rand()], target: player, sight: 4.5, speed: 1, alertSpeed: 3.2, onSee: flee.onSee });\n        herd.push(h);\n    }\n    over = false; start = performance.now(); $msg.style.display = \"none\";\n}\n\nconst $msg = document.getElementById(\"msg\"), $hud = document.getElementById(\"hud\");\n$msg.innerHTML = \"Horse roundup<small>WASD / arrows · Shift to run<br>the bronze horses hop away from you; herd all six onto the planks<br><br>click to start</small>\";\n$msg.onclick = () => { audio.resume(); begin(); };\n\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\ncamera.position.set(0, 10, 16); camera.lookAt(0, 0, 0);\nconst clock = new THREE.Clock();\nrenderer.setAnimationLoop(() => {\n    const dt = clock.getDelta();\n    skyH.update(dt); const t = clock.elapsedTime;\n    if (!over) {\n        for (const s of systems) s.update(dt);\n        for (const h of herd) {\n            if (h.penned) continue;\n            h.ai.update(dt);\n            const m = h.model; m.position.y = Math.abs(Math.sin(t * (h.ai.alert ? 9 : 4) + m.userData.phase)) * (h.ai.alert ? 0.6 : 0.15); // hop\n            const p = h.model.position; p.x = THREE.MathUtils.clamp(p.x, -R + 0.5, R - 0.5); p.z = THREE.MathUtils.clamp(p.z, -R + 0.5, R - 0.5);\n            if (inPen(p)) { h.penned = true; p.y = 0; ding(); }\n        }\n        const n = herd.filter((h) => h.penned).length, t = ((performance.now() - start) / 1000).toFixed(1);\n        $hud.textContent = `penned ${n}/${N} · ${t}s`;\n        if (n === N) { over = true; $msg.innerHTML = `All ${N} rounded up in ${t}s!<small>click to play again</small>`; $msg.style.display = \"\"; }\n    }\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}