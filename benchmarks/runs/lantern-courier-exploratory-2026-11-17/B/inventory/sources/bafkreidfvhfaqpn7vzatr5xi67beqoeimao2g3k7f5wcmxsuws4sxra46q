{"js":"// SPDX-License-Identifier: CC0-1.0\n// Inhabited streets fork: ground surfaces receive shadows without casting onto each other.\nimport * as T from 'three';\nfunction shape(points,holes=[]){const s=new T.Shape(points.map(p=>new T.Vector2(p.x,-p.z)));for(const h of holes)s.holes.push(new T.Path(h.map(p=>new T.Vector2(p.x,-p.z))));return s;}\nfunction inside(p,ring){let yes=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++){const a=ring[i],b=ring[j];if((a.z>p.z)!==(b.z>p.z)&&p.x<(b.x-a.x)*(p.z-a.z)/(b.z-a.z)+a.x)yes=!yes;}return yes;}\nfunction nearestStreet(p,roads){let best={x:p.x,z:p.z},distance=Infinity;for(const r of roads)if(r.kind!=='water'&&!r.labelOnly)for(const q of r.points){const d=Math.hypot(p.x-q.x,p.z-q.z);if(d<distance){distance=d;best=q;}}return best;}\nfunction noise(seed=11){let x=seed;return()=>((x=Math.imul(x,1664525)+1013904223>>>0)/4294967296);}\nexport function attach(scene,{district,brickTexture,groundColor='#586650',classifyBuilding=b=>b.kind,decorate=()=>{},towerFactory,radioModel,groundTexture,treeFactory,lifeModule,showSignals=true,xrayPlayers=true,occlusionFade=true,hidePlayer=()=>false}={}){\n const root=new T.Group();scene.add(root);const prev={background:scene.background,fog:scene.fog};scene.background=new T.Color('#6e8790');scene.fog=new T.FogExp2('#6e8790',.0019);const random=noise(parseInt(district.fingerprint,16));const textures=new Set(),materials=new Set(),geometry=new Set();\n const mat=opts=>{const m=new T.MeshStandardMaterial({roughness:.88,side:T.DoubleSide,...opts});materials.add(m);return m;};const groundM=mat({color:groundTexture?'#e0e6e5':groundColor,...(groundTexture?{map:groundTexture,bumpMap:groundTexture,bumpScale:.09}:{})}),roadM=mat({color:'#55595a'}),pathM=mat({color:'#777c72'}),waterM=mat({color:'#315d67',roughness:.25,metalness:.25}),roofM=mat({color:'#42494c'}),trimM=mat({color:'#b9b5a1'}),lampM=mat({color:'#e6c98f',emissive:'#e4a858',emissiveIntensity:1.2});\n const mesh=(g,m)=>{geometry.add(g);const o=new T.Mesh(g,m);o.castShadow=o.receiveShadow=true;root.add(o);return o;};\n const ground=mesh(new T.PlaneGeometry(district.radius*2.4,district.radius*2.4,1,1),groundM);ground.rotation.x=-Math.PI/2;ground.castShadow=false;\n const hemi=new T.HemisphereLight('#c3e1ed','#424a30',2.5);root.add(hemi);const sun=new T.DirectionalLight('#f3d5a4',2.2);sun.position.set(-150,190,90);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);sun.shadow.camera.left=sun.shadow.camera.bottom=-105;sun.shadow.camera.right=sun.shadow.camera.top=105;sun.shadow.camera.far=500;sun.shadow.normalBias=.25;sun.shadow.bias=-.0004;sun.shadow.autoUpdate=false;sun.shadow.needsUpdate=true;root.add(sun,sun.target);let shadowX=Infinity,shadowZ=Infinity;\n const ribbons={road:[],path:[],water:[]};function ribbon(points,width,positions,y){for(let i=1;i<points.length;i++){const a=points[i-1],b=points[i],d=Math.hypot(b.x-a.x,b.z-a.z);if(!d)continue;const x=-(b.z-a.z)/d*width/2,z=(b.x-a.x)/d*width/2;positions.push(a.x+x,y,a.z+z,a.x-x,y,a.z-z,b.x+x,y,b.z+z,a.x-x,y,a.z-z,b.x-x,y,b.z-z,b.x+x,y,b.z+z);}}\n for(const road of district.roads){if(road.labelOnly)continue;const group=road.kind==='water'?'water':['footway','path','steps','pedestrian'].includes(road.kind)?'path':'road';if(group==='road')ribbon(road.points,road.width+2.5,ribbons.path,.026);ribbon(road.points,road.width,ribbons[group],group==='water'?.02:.04);}\n const asphalt=document.createElement('canvas');asphalt.width=asphalt.height=128;const ctx=asphalt.getContext('2d'),pixels=ctx.createImageData(128,128);for(let i=0;i<pixels.data.length;i+=4){const v=165+random()*32;pixels.data[i]=v;pixels.data[i+1]=v;pixels.data[i+2]=v;pixels.data[i+3]=255;}ctx.putImageData(pixels,0,0);const asphaltMap=new T.CanvasTexture(asphalt);asphaltMap.colorSpace=T.SRGBColorSpace;asphaltMap.wrapS=asphaltMap.wrapT=T.RepeatWrapping;asphaltMap.anisotropy=4;textures.add(asphaltMap);roadM.map=asphaltMap;roadM.bumpMap=asphaltMap;roadM.bumpScale=.035;\n for(const[key,positions]of Object.entries(ribbons)){const g=new T.BufferGeometry();g.setAttribute('position',new T.Float32BufferAttribute(positions,3));const uv=[];for(let i=0;i<positions.length;i+=3)uv.push(positions[i]/6,positions[i+2]/6);g.setAttribute('uv',new T.Float32BufferAttribute(uv,2));g.computeVertexNormals();const surface=mesh(g,{road:roadM,path:pathM,water:waterM}[key]);surface.castShadow=false;}\n for(const w of district.water){const o=mesh(new T.ShapeGeometry(shape(w.points,w.holes)),waterM);o.rotation.x=-Math.PI/2;o.position.y=.03;o.castShadow=false;}\n const occluders=[],faded=new Set(),raycaster=new T.Raycaster();const wallMaterials={};for(const[k,color]of Object.entries({home:'#aca28d',shop:'#a88b73',hospital:'#c2c9bc',civic:'#9caaa4',school:'#ae9a83',industrial:'#8d9893',commercial:'#9b7c6b',building:'#b3aaa0'}))wallMaterials[k]=mat({color,...(brickTexture?{map:brickTexture}:{} )});\n const windowPositions=[],windowColors=[];function windowQuad(a,b,y,width,height,color,sign=1){const dx=b.x-a.x,dz=b.z-a.z,l=Math.hypot(dx,dz),u={x:dx/l*width/2,z:dz/l*width/2},p={x:(a.x+b.x)/2-dz/l*.065*sign,z:(a.z+b.z)/2+dx/l*.065*sign};const pts=[[p.x-u.x,y,p.z-u.z],[p.x+u.x,y,p.z+u.z],[p.x+u.x,y+height,p.z+u.z],[p.x-u.x,y,p.z-u.z],[p.x+u.x,y+height,p.z+u.z],[p.x-u.x,y+height,p.z-u.z]];for(const v of pts){windowPositions.push(...v);windowColors.push(color.r,color.g,color.b);}}\n for(const b of district.buildings){const kind=classifyBuilding(b),m=(wallMaterials[kind]??wallMaterials.building).clone();m.transparent=true;materials.add(m);const o=mesh(new T.ExtrudeGeometry(shape(b.points,b.holes),{depth:b.height,bevelEnabled:false,steps:1}),m);o.rotation.x=-Math.PI/2;o.position.y=b.minHeight;occluders.push(o);\n  const roofMaterial=roofM.clone();roofMaterial.transparent=true;materials.add(roofMaterial);const roof=mesh(new T.ShapeGeometry(shape(b.points,b.holes)),roofMaterial);occluders.push(roof);roof.rotation.x=-Math.PI/2;roof.position.y=b.height+b.minHeight+.04;roof.material.side=T.DoubleS