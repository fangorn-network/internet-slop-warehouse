.3),z=p.z+(p.x-a.x)/l*(road.width/2+1.3);poles.push({x,y:3.8,z});heads.push({x,y:7.7,z});}\n const instance=(g,m,list,scale)=>{geometry.add(g);const o=new T.InstancedMesh(g,m,list.length),d=new T.Object3D();list.forEach((p,i)=>{d.position.set(p.x,p.y,p.z);d.scale.set(...scale);d.updateMatrix();o.setMatrixAt(i,d.matrix);});root.add(o);return o;};instance(new T.CylinderGeometry(.09,.13,7.6,5),mat({color:'#344648'}),poles,[1,1,1]);instance(new T.BoxGeometry(.55,.15,.85),lampM,heads,[1,1,1]);\n const towerMarkers=[];for(const t of district.towers.filter(t=>Math.abs(t.x)<=district.radius+60&&Math.abs(t.z)<=district.radius+60)){if(towerFactory){const tower=towerFactory({height:t.height,color:t.mapped?'#a3b5b7':'#c5a96d'});tower.position.set(t.x,0,t.z);root.add(tower);}else{const tank=mesh(new T.CylinderGeometry(7,7,7,12),trimM);tank.position.set(t.x,t.height-4,t.z);const stem=mesh(new T.CylinderGeometry(.8,1,t.height-8,8),trimM);stem.position.set(t.x,(t.height-8)/2,t.z);}const halo=mesh(new T.TorusGeometry(10,.12,5,32),lampM);halo.rotation.x=-Math.PI/2;halo.position.set(t.x,.3,t.z);towerMarkers.push(halo);}\n // Procedural vegetation in unmapped open space: visual decoration, never asserted as OSM facts.\n const treeTrunks=[],treeCrowns=[];for(let i=0;i<400;i++){const x=(random()-.5)*district.radius*2,z=(random()-.5)*district.radius*2;if(district.buildings.some(b=>Math.hypot(b.x-x,b.z-z)<35)||district.roads.some(r=>r.points.some(p=>Math.hypot(p.x-x,p.z-z)<18))||district.water.some(w=>inside({x,z},w.points)&&!w.holes.some(h=>inside({x,z},h))))continue;const h=8+random()*9;treeTrunks.push({x,y:h*.35,z});treeCrowns.push({x,y:h*.65,z});}if(!treeFactory){instance(new T.CylinderGeometry(.2,.35,7,5),mat({color:'#535046'}),treeTrunks,[1,1,1]);instance(new T.ConeGeometry(4,11,7),mat({color:'#2e514d'}),treeCrowns,[1,1,1]);}else{for(const species of ['pine','maple']){const list=treeTrunks.filter((_,i)=>species==='pine'?i%3!==0:i%3===0),model=treeFactory({species,seed:33});for(const child of model.children){materials.add(child.material);instance(child.geometry,child.material,list.map(t=>({...t,y:0})),[1,1,1]);}}}\n const markerGroup=new T.Group();root.add(markerGroup);const markers=(showSignals?district.sites:[]).map((s,i)=>{const group=new T.Group(),ring=new T.Mesh(new T.TorusGeometry(4.2,.15,6,32),mat({color:'#d4b67b',emissive:'#ba8d43',emissiveIntensity:.8}));geometry.add(ring.geometry);ring.rotation.x=-Math.PI/2;group.add(ring);group.position.set(s.x,.25,s.z);markerGroup.add(group);if(radioModel){const radio=radioModel.clone(true);radio.traverse(o=>{if(o.geometry)o.geometry=o.geometry.clone();if(o.material)o.material=Array.isArray(o.material)?o.material.map(m=>m.clone()):o.material.clone();});const box=new T.Box3().setFromObject(radio),size=box.getSize(new T.Vector3()),center=box.getCenter(new T.Vector3());radio.position.sub(center);const wrapper=new T.Group();wrapper.add(radio);wrapper.scale.setScalar(1.8/Math.max(size.x,size.y,size.z));wrapper.position.set(s.x,.9,s.z);root.add(wrapper);const pedestal=mesh(new T.BoxGeometry(2,.8,1),trimM);pedestal.position.set(s.x,.4,s.z);}return{group,ring,key:district.fingerprint+':'+s.id};});\n const avatars=new Map();const beamGeo=new T.ConeGeometry(5,20,12,1,true);beamGeo.translate(0,-10,0);beamGeo.rotateX(-Math.PI/2);geometry.add(beamGeo);\n function avatar(id){const g=new T.Group(),body=new T.Group();let h=0;for(const c of id)h=Math.imul(h,31)+c.charCodeAt(0);const color=new T.Color().setHSL((h>>>0)%360/360,.3,.65),coat=new T.Mesh(new T.CapsuleGeometry(.43,.9,3,6),mat({color}));geometry.add(coat.geometry);coat.position.y=1;coat.material.depthTest=!xrayPlayers;coat.renderOrder=xrayPlayers?100:0;body.add(coat);const head=new T.Mesh(new T.SphereGeometry(.28,8,6),mat({color:'#d9b99c'}));geometry.add(head.geometry);head.position.y=1.95;head.material.depthTest=!xrayPlayers;head.renderOrder=xrayPlayers?100:0;body.add(head);const pointer=new T.Mesh(new T.RingGeometry(1.3,1.65,20),new T.MeshBasicMaterial({co