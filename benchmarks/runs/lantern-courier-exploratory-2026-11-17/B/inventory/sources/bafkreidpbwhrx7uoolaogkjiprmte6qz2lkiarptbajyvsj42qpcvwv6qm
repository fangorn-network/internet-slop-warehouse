{"js":"// CC0-1.0. Realistic walls, doorways, windows, floors and roofs from a character grid (the same rows\n// `grid-navigation` paths over). Greedy-merged boxes with world-space UVs, so tiling PBR textures run seamlessly\n// across a whole wall; one draw call per material. Returns every mesh as a raycast collider (walls, floors, roofs).\nimport * as THREE from 'three';\nimport { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';\n\nexport const DEFAULT_LEGEND = {\n    '#': { type: 'wall', mat: 'brick' },\n    'C': { type: 'wall', mat: 'concrete' },\n    'F': { type: 'wall', mat: 'concrete', height: 2.2, roof: false },  // fence / low wall\n    'D': { type: 'door', mat: 'brick', floor: 'floor' },\n    'd': { type: 'door', mat: 'concrete', floor: 'floor' },\n    'W': { type: 'window', mat: 'brick', floor: 'floor' },\n    'w': { type: 'window', mat: 'concrete', floor: 'floor' },\n    '_': { type: 'floor', mat: 'floor', roof: 'roof' },\n    '.': { type: 'ground', mat: 'asphalt' },\n    ',': { type: 'ground', mat: 'dirt' },\n    '=': { type: 'ground', mat: 'concrete' },\n};\n\n/** Greedy rectangles over cells where key(x,z) is a non-null string. Yields { key, x0, z0, x1, z1 } (exclusive ends). */\nexport function rectangles(width, height, key) {\n    const seen = new Uint8Array(width * height), out = [];\n    for (let z = 0; z < height; z++) for (let x = 0; x < width; x++) {\n        const k = key(x, z); if (k == null || seen[z * width + x]) continue;\n        let x1 = x + 1; while (x1 < width && !seen[z * width + x1] && key(x1, z) === k) x1++;\n        let z1 = z + 1;\n        grow: while (z1 < height) { for (let i = x; i < x1; i++) if (seen[z1 * width + i] || key(i, z1) !== k) break grow; z1++; }\n        for (let j = z; j < z1; j++) for (let i = x; i < x1; i++) seen[j * width + i] = 1;\n        out.push({ key: k, x0: x, z0: z, x1, z1 });\n    }\n    return out;\n}\n\n/** Axis-aligned box from min/max corners with world-space UVs (texSize metres per tile). */\nexport function worldBox(x0, x1, y0, y1, z0, z1, texSize = 2) {\n    const g = new THREE.BoxGeometry(x1 - x0, y1 - y0, z1 - z0);\n    g.translate((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2);\n    const p = g.attributes.position, n = g.attributes.normal, uv = g.attributes.uv;\n    for (let i = 0; i < p.count; i++) {\n        const ax = Math.abs(n.getX(i)), ay = Math.abs(n.getY(i));\n        const [u, v] = ax > 0.5 ? [p.getZ(i), p.getY(i)] : ay > 0.5 ? [p.getX(i), p.getZ(i)] : [p.getX(i), p.getY(i)];\n        uv.setXY(i, u / texSize, v / texSize);\n    }\n    g.setAttribute('uv1', uv.clone()); // for aoMap if a material uses one\n    return g;\n}\n\nexport function attach(scene, {\n    rows, cellSize = 1, origin = [0, 0], height = 3.2, legend = DEFAULT_LEGEND, materials = {},\n    doorHeight = 2.25, sill = 1.0, lintel = 2.15, roofThickness = 0.25,\n    material = (name) => materials[name] ?? new THREE.MeshStandardMaterial({ color: 0x8a8580, roughness: 0.9 }),\n} = {}) {\n    if (!Array.isArray(rows) || !rows.length) throw new Error('rows required');\n    const W = rows[0].length, H = rows.length, group = new THREE.Group(); group.name = 'grid-buildings';\n    const at = (x, z) => legend[rows[z][x]] ?? null;\n    const X = (i) => origin[0] + i * cellSize, Z = (j) => origin[1] + j * cellSize;\n    const byMat = new Map();\n    const push = (mat, geo) => { if (!byMat.has(mat)) byMat.set(mat, []); byMat.get(mat).push(geo); };\n    const tex = (mat) => material(mat).userData?.texSize ?? 2;\n\n    // Vertical pieces: wall full height; door = lintel; window = sill + lintel. Merge runs of equal char.\n    for (const r of rectangles(W, H, (x, z) => { const l = at(x, z); return l && ['wall', 'door', 'window'].includes(l.type) ? rows[z][x] : null; })) {\n        const l = legend[r.key], top = l.height ?? height, x0 = X(r.x0), x1 = X(r.x1), z0 = Z(r.z0), z1 = Z(r.z1);\n        const spans = l.type === 'wall' ? [[0, top + (l.roof === false ? 0 : roofThickness)]] : l.type === 'door' ? [[doorHeight, top + roofThickness]] : [[0, sill], [lintel, top + roofThickness]];\n        for (const [y0, y1] of spans) push(l.mat, worldBox(x0, x1, y0, y1, z0, z1, tex(l.mat)));\n    }\n    // Floors and ground: thin slabs; door/window cells get their legend floor.\n    for (const r of rectangles(W, H, (x, z) => { const l = at(x, z); return !l ? null : l.type === 'floor' || l.type === 'ground' ? l.mat : l.floor ?? null; }))\n        push(r.key, worldBox(X(r.x0), X(r.x1), -0.1, 0.0, Z(r.z0), Z(r.z1), tex(r.key)));\n    // Roofs over roofed floor cells.\n    for (const r of rectangles(W, H, (x, z) => at(x, z)?.roof || null))\n        push(r.key, worldBox(X(r.x0), X(r.x1), height, height + roofThickness, Z(r.z0), Z(r.z1), tex(r.key)));\n\n    const colliders = [];\n    for (const [mat, geos] of byMat) {\n        const mesh = new THREE.Mesh(mergeGeometries(geos), material(mat));\n        geos.forEach((g) => g.dispose());\n        mesh.name = 'grid-' + mat; mesh.castShadow = mesh.receiveShadow = true; mesh.userData.surface = mat;\n        group.add(mesh); colliders.push(mesh);\n    }\n    scene.add(group);\n    return {\n        group, colliders, width: W, height: H,\n        update() {},\n        dispose() { group.removeFromParent(); group.traverse((o) => o.geometry?.dispose()); },\n    };\n}"}