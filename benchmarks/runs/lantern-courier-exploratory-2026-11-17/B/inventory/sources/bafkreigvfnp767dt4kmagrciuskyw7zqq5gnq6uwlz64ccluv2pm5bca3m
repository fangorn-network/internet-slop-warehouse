{"html":"<!doctype html>\n<html><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Gauntlet</title>\n<meta name=\"description\" content=\"Survive in a grass arena while more and more red robots chase you. Jump over them.\">\n<style>\n  html,body{margin:0;touch-action:none;-webkit-user-select:none;user-select:none;height:100%;overflow:hidden;background:#2b2140;font:14px system-ui,sans-serif}\n  #hud{position:fixed;top:10px;left:12px;color:#fff;text-shadow:0 1px 2px #0008;font-weight:600;pointer-events:none}\n  #msg{position:fixed;inset:0;display:grid;place-items:center;color:#fff;text-shadow:0 2px 4px #0009;font-size:22px;text-align:center;cursor:pointer;background:#0006}\n  #msg small{display:block;font-size:14px;opacity:.85;margin-top:8px}\n</style>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"}}</script>\n</head><body>\n<div id=\"hud\"></div><div id=\"msg\">loading…</div>\n<script type=\"module\">\nimport * as THREE from \"three\";\nimport { GLTFLoader } from \"three/addons/loaders/GLTFLoader.js\";\nimport * as SkeletonUtils from \"three/addons/utils/SkeletonUtils.js\";\n\nconst PARTS = {\"robot\":\"https://ipfs-test.fangorn.network/ipfs/bafybeiezecuxadyslgydj7gwc3ihmujswsynwykrj4yjbofc4eggugam2y\",\"grass-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafkreibpj4yzdql6ltoxdkfxkm7thc546n4dhr2zqshz4jqtj2ocvxf66e\",\"crate-texture\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiajinmww4tgdrzi64wi4bfqvua3dlvsmnclvmzjk7zyo2hqbxqram\",\"jump-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreickrhtm4jnxehlxtq2qlowctwixqt3xth7yi7vlwaxv63nvjlnf54\",\"hit-sound\":\"https://ipfs-test.fangorn.network/ipfs/bafkreidqejf2negsnotb3xo7p3m7fv2xfst6oqlpqfnk5dn4vctwp56k74\",\"platformer-controller\":\"https://ipfs-test.fangorn.network/ipfs/bafkreihbjdl3wwjfiiu7qne4a5qnskfj4lrieutjlv64yhqd25kbth7m74\",\"patrol\":\"https://ipfs-test.fangorn.network/ipfs/bafkreig4sntado3q4izlueu4spl2pydk6yiad4cdab6vimthb6mwabpw7m\",\"follow-camera\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiauise4tsy3llffneifcfwo25whtfrccjdjynf2bqj4jj5kypypha\",\"clip-animator\":\"https://ipfs-test.fangorn.network/ipfs/bafkreiahogjc53z7qaa7x4j7nnus5rxahr6ojuaxb2m7oukkb3fxc3zj2y\",\"touch-controls\":\"https://ipfs-test.fangorn.network/ipfs/bafkreie6f27cac6h4vhzqm3rjrtwue5f2ikq5vcw2kzgs3v4xadyha5pqu\"};\nconst logic = async (id) => import(\"data:text/javascript;charset=utf-8,\" + encodeURIComponent((await (await fetch(PARTS[id])).json()).js));\nlogic(\"touch-controls\").then((t) => t.attach()); // a joystick and jump button on phones\n\nconst [controller, patrol, followCam, animator, gltf, grassTex, crateTex] = await Promise.all([\n    logic(\"platformer-controller\"), logic(\"patrol\"), logic(\"follow-camera\"), logic(\"clip-animator\"),\n    new GLTFLoader().loadAsync(PARTS[\"robot\"]),\n    new THREE.TextureLoader().loadAsync(PARTS[\"grass-texture\"]), new THREE.TextureLoader().loadAsync(PARTS[\"crate-texture\"]),\n]);\nconst audio = new AudioContext();\nconst sounds = Object.fromEntries(await Promise.all([\"jump-sound\", \"hit-sound\"].map(async (id) =>\n    [id, await audio.decodeAudioData(await (await fetch(PARTS[id])).arrayBuffer())])));\nconst play = (id) => { const s = audio.createBufferSource(); s.buffer = sounds[id]; s.connect(audio.destination); s.start(); };\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.shadowMap.enabled = true;\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene(), camera = new THREE.PerspectiveCamera(55, 1, 0.1, 200);\nscene.background = new THREE.Color(0x2b2140); scene.fog = new THREE.Fog(0x2b2140, 25, 60);\nscene.add(new THREE.HemisphereLight(0xccbbff, 0x332211, 1.1));\nconst sun = new THREE.DirectionalLight(0xffeedd, 2); sun.position.set(6, 15, 8); sun.castShadow = true;\nObject.assign(sun.shadow.camera, { left: -16, right: 16, top: 16, bottom: -16 }); sun.shadow.mapSize.set(2048, 2048);\nscene.add(sun);\n\n// The arena: one grass slab with crates to hide behind (the guards walk through them; you don't).\nconst R = 11; // half the arena's width\nfor (const t of [grassTex, crateTex]) { t.magFilter = THREE.NearestFilter; t.colorSpace = THREE.SRGBColorSpace; t.wrapS = t.wrapT = THREE.RepeatWrapping; }\nconst solids = [];\nfunction block(x, y, z, w, h, d, crate = false) {\n    const tex = (crate ? crateTex : grassTex).clone(); tex.repeat.set(crate ? 1 : w / 2, crate ? 1 : d / 2); tex.needsUpdate = true;\n    const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), new THREE.MeshLambertMaterial({ map: tex }));\n    m.position.set(x, y - h / 2, z); m.castShadow = m.receiveShadow = true; scene.add(m); solids.push(m);\n}\nblock(0, 0, 0, 2 * R, 2, 2 * R);\nfor (const [x, z] of [[-5, -5], [5, -5], [-5, 5], [5, 5], [0, -8], [0, 8], [-8, 0], [8, 0]]) block(x, 1.2, z, 1.2, 1.2, 1.2, true);\n\nconst robot = (tint) => {\n    const m = SkeletonUtils.clone(gltf.scene); m.scale.setScalar(0.35);\n    m.traverse((o) => { if (o.isMesh) { o.castShadow = true; if (tint) { o.material = o.material.clone(); o.material.color.multiply(new THREE.Color(tint)); } } });\n    scene.add(m); return m;\n};\nconst player = robot();\nconst rand = () => new THREE.Vector3((Math.random() * 2 - 1) * (R - 1), 0, (Math.random() * 2 - 1) * (R - 1));\n\nlet over = true, start = 0, nextSpawn = 0, best = 0;\nconst systems = [], guards = [];\nfunction spawn() {\n    const g = robot(0xff4444), corner = [[-1, -1], [1, -1], [-1, 1], [1, 1]][guards.length % 4];\n    g.position.set(corner[0] * (R - 1), 0, corner[1] * (R - 1));\n    // Guards wander the arena and chase on sight; each one sees a little further than the last.\n    const ai = patrol.attach(g, { points: [rand(), rand(), rand()], target: player, sight: 6 + guards.length,\n        alertSpeed: 3 + guards.length * 0.2, touch: 0.8, onTouch: () => lose() });\n    guards.push(g); systems.push(ai, animator.attach(g, { animations: gltf.animations, state: () => ai.alert ? \"run\" : \"walk\" }));\n}\nfunction begin() {\n    for (const s of systems.splice(0)) s.dispose();\n    for (const g of guards.splice(0)) g.removeFromParent();\n    player.position.set(0, 0, 0);\n    const ctl = controller.attach(player, { solids, camera, onJump: () => play(\"jump-sound\"), onFall: () => lose(\"You fell off.\") });\n    systems.push(ctl, animator.attach(player, { animations: gltf.animations, state: () => ctl.state }),\n        followCam.attach(camera, { target: player, offset: [0, 7, 9] }));\n    over = false; start = performance.now(); nextSpawn = 0; $msg.style.display = \"none\";\n}\nfunction lose(why = \"Caught!\") {\n    if (over) return;\n    play(\"hit-sound\"); over = true;\n    const t = (performance.now() - start) / 1000; best = Math.max(best, t);\n    $msg.innerHTML = `${why} ${t.toFixed(1)}s, ${guards.length} guards<small>best ${best.toFixed(1)}s · click to try again</small>`; $msg.style.display = \"\";\n}\n\nconst $msg = document.getElementById(\"msg\"), $hud = document.getElementById(\"hud\");\n$msg.innerHTML = \"Gauntlet<small>WASD / arrows · Shift to run · Space to jump over them<br>a new guard every 6 seconds; how long can you last?<br><br>click to start</small>\";\n$msg.onclick = () => { audio.resume(); begin(); };\n\nconst fit = () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); };\naddEventListener(\"resize\", fit); fit();\ncamera.position.set(0, 9, 14); camera.lookAt(0, 0, 0);\nconst clock = new THREE.Clock();\nrenderer.setAnimationLoop(() => {\n    const dt = clock.getDelta();\n    if (!over) {\n        const t = (performance.now() - start) / 1000;\n        if (t >= nextSpawn) { spawn(); nextSpawn += 6; }\n        for (const s of systems) s.update(dt);\n        $hud.textContent = `${t.toFixed(1)}s · ${guards.length} guards`;\n    }\n    renderer.render(scene, camera);\n});\n</script></body></html>\n"}