{"js":"// SPDX-License-Identifier: CC0-1.0\nimport * as T from 'three';\nexport function makeTower({height=34,color='#a3b5b7',radius=7.5,legs=4}={}){height=Math.max(14,Math.min(80,height));const root=new T.Group();root.name='Procedural municipal water tower';const metal=new T.MeshStandardMaterial({color,metalness:.35,roughness:.58}),dark=new T.MeshStandardMaterial({color:'#3c555b',metalness:.5,roughness:.6});const add=(g,m,x,y,z)=>{const o=new T.Mesh(g,m);o.position.set(x,y,z);o.castShadow=o.receiveShadow=true;root.add(o);return o;};add(new T.CylinderGeometry(radius,radius*.96,7,20),metal,0,height-5,0);const dome=add(new T.SphereGeometry(radius,20,10,0,Math.PI*2,0,Math.PI/2),metal,0,height-1.5,0);dome.scale.y=.35;const base=add(new T.ConeGeometry(radius*.96,4,20),metal,0,height-10.5,0);base.rotation.x=Math.PI;for(let i=0;i<legs;i++){const angle=i/legs*Math.PI*2+Math.PI/4,x=Math.cos(angle)*radius*.8,z=Math.sin(angle)*radius*.8;add(new T.CylinderGeometry(.3,.48,height-8,6),metal,x,(height-8)/2,z);}add(new T.CylinderGeometry(.65,.65,height-9,8),dark,0,(height-9)/2,0);for(let y=4;y<height-9;y+=6){const ring=add(new T.TorusGeometry(radius*.8,.12,5,24),dark,0,y,0);ring.rotation.x=Math.PI/2;}return root;}\nexport function attach(parent,opts={}){const root=makeTower(opts);parent.add(root);return{root,update(){},dispose(){root.removeFromParent();const gs=new Set(),ms=new Set();root.traverse(o=>{if(o.geometry)gs.add(o.geometry);if(o.material)ms.add(o.material);});gs.forEach(g=>g.dispose());ms.forEach(m=>m.dispose());}};}\n"}