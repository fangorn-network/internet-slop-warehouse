    "description": "Parallel back-to-back hardgoods banks, perimeter media and twelve clothing fixtures. 1675 independent finds: seeded fixture-specific pools, uneven occupancy/spacing, capped duplicate models, dish stacks, upright/flat book groups, individual aisle approaches and goal reservations.",
    "exports": [
      {
        "name": "attach",
        "signature": "attach(object,{transformItem}) → {catalog,shelves,racks,update,dispose}",
        "does": "Create a fresh merchandise catalog, optionally transform each item."
      },
      {
        "name": "makeStock",
        "signature": "makeStock() → Item[]",
        "does": "Generate all unique item records."
      },
      {
        "name": "catalog",
        "signature": "Item[]",
        "does": "Default complete item catalog."
      },
      {
        "name": "shelves",
        "signature": "Fixture[]",
        "does": "Shelf positions and categories."
      },
      {
        "name": "racks",
        "signature": "Fixture[]",
        "does": "Clothing fixture positions."
      },
      {
        "name": "specials",
        "signature": "Item[]",
        "does": "Nine named errand purchases."
      }
    ],
    "hooks": [
      {
        "name": "transformItem",
        "signature": "(item) → item",
        "default": "identity",
        "does": "Override placement, price or visual metadata for a new catalog."
      }
    ]
