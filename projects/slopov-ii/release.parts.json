  {
    "id": "heartland-hotel",
    "type": "logic",
    "kind": "effect",
    "file": "../artifacts/slopov-ii/heartland-hotel.js",
    "title": "Heartland Inn Express building",
    "description": "The two-storey interstate hotel from Heartland Inn Express as a drop-in for any three.js scene: lobby, front desk, pantry, lounge, pool wing, gym, elevator, switchback stair, corridors and room 212, with working doors, lights, TVs and its pinned Poly Haven, Grab3D and original Blender furniture. Returns box colliders, walkable surfaces, light anchors and interactions in the hotel plan (x -24..30, z -9..9, front +z, floor 2 at y 3.2). Optional parking lot and highway, optional staff and guests.",
    "tags": [
      "hotel",
      "building",
      "level",
      "interior",
      "realistic",
      "three.js",
      "map",
      "effect",
      "cc0"
    ],
    "author": "the internet slop warehouse",
    "license": "CC0-1.0 AND MIT",
    "exports": [
      {
        "name": "attach",
        "signature": "attach(parent, opts) → Promise<{ colliders, surfaces, interact, lightAnchors, zones, elevator, room, setTimeOfDay, update(dt, player), dispose() }>",
        "does": "Load the pinned assets and build the hotel into parent; player is { x, y, z, pos } in hotel coordinates"
      },
      {
        "name": "PART_IDS",
        "signature": "string[]",
        "does": "Every warehouse part the hotel loads"
      },
      {
        "name": "FLOOR2",
        "signature": "number",
        "does": "Height of the second floor (3.2 m)"
      }
    ],
    "options": [
      {
        "name": "outside",
        "type": "boolean",
        "default": false,
        "does": "Also build the parking lot, roads, interstate and scenery"
      },
      {
        "name": "people",
        "type": "boolean",
        "default": false,
        "does": "Also add the desk clerk, housekeeper and guests"
      },
      {
        "name": "parts",
        "type": "object",
        "default": "{}",
        "does": "id → URL overrides for the pinned assets"
      },
      {
        "name": "onProgress",
        "type": "function",
        "default": "noop",
        "does": "Loading progress, 0..1"
      }
